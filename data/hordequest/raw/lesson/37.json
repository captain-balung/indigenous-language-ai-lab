	"data": {
		"phase1": [
			{
				"text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
			},
			{
				"text": "ngasa ngahla u?",
				"textCh": "你叫甚麼名字？",
				"sound": "text/sound/62928/877705",
				"image": "girl.png",
				"background": "1-1.jpg"
			},
			{
				"text": "ihlaku ia Caʉpʉ.",
				"textCh": "我叫Caʉpʉ。",
				"sound": "text/sound/62928/877706",
				"image": "boy.png",
				"background": "1-2.jpg"
			},
			{
				"text": "ma ninau a salia u?",
				"textCh": "你的家在哪裡？",
				"sound": "text/sound/62928/877707",
				"image": "girl.png",
				"background": "1-1.jpg"
			},
			{
				"text": "hliangahli aku Rʉhlʉcʉ miararuma mʉcʉkʉhlʉ.",
				"textCh": "我從浮萍部落來。",
				"sound": "text/sound/62928/877708",
				"image": "boy.png",
				"background": "1-2.jpg"
			},
			{
				"text": "hliumuu cu u i kuamaivʉvʉrʉnga?",
				"textCh": "你吃早餐了嗎？",
				"sound": "text/sound/62928/877709",
				"image": "girl.png",
				"background": "1-1.jpg"
			},
			{
				"text": "uka’amana.",
				"textCh": "還沒耶！",
				"sound": "text/sound/62928/877710",
				"image": "boy.png",
				"background": "1-2.jpg"
			},
			{
				"text": "muasa ku pu’a kuamaivʉvʉrʉnga, mualiviu i?",
				"textCh": "我要去買早餐，要一起去嗎？",
				"sound": "text/sound/62928/877711",
				"image": "girl.png",
				"background": "1-1.jpg"
			},
			{
				"text": "kuaku ahlava vahlituku. tuahliu i umuhli ihlaku vahlituku?",
				"textCh": "我沒有帶錢。你可以借我錢嗎？",
				"sound": "text/sound/62928/877712",
				"image": "boy.png",
				"background": "1-2.jpg"
			},
			{
				"text": "aa’ʉ, umuhli aku ihlau.",
				"textCh": "好，我借你。",
				"sound": "text/sound/62928/877713",
				"image": "girl.png",
				"background": "1-1.jpg"
			}
		],
