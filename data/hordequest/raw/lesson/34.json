        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "tiana nangan su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62862/875971",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ti angaw nangan ku.",
                "textCh": "我叫angaw。",
                "sound": "text/sound/62862/875972",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "yau tanian leppaw su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62862/875973",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "maqezi iku ta pateRungan mawtu.",
                "textCh": "我從新社部落來。",
                "sound": "text/sound/62862/875974",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "qeman ti isu tu sataRbabi ni?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62862/875975",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "mai pama.",
                "textCh": "還沒耶！",
                "sound": "text/sound/62862/875976",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Rasa pa iku tu sataRbabian, qasulun pa isu ni?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62862/875977",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "mai iku mazas tu kelisiw, qanengi isu paliway tu kelisiw timaikuan ni?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62862/875978",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kuaya, paliway aka isu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62862/875979",
