        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "siya nea ko naganeso?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62708/871925",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "siya ’Alri kai naganeli",
                "textCh": "我叫’Alri。",
                "sound": "text/sound/62708/871926",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "yakai ino kai daaneso?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62708/871927",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "twalai zako Taromak kela",
                "textCh": "我從Taromak部落來。",
                "sound": "text/sound/62708/871928",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "watorokodrongaso?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62708/871929",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "iniyana!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62708/871930",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ai yowa ko lwangai sa rokodro, aito’alra so?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62708/871931",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "nako wailoko sa ’aiso. aikalekete so ’akisalro nakowa",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62708/871932",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
