    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "tuqauq suu ngan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62554/867879",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Tulbus naak ngan.",
                "textCh": "我叫Tulbus。",
                "sound": "text/sound/62554/867880",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "isaq suu lumaq?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62554/867881",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "mainahaan aak Bahuan asang minsuma.",
                "textCh": "我從馬遠部落來。",
                "sound": "text/sound/62554/867882",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "minaunin aas paitutingmut?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62554/867883",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "nii’ang!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62554/867884",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "namabaliv aak paitutingmut, malavi aas?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62554/867885",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "nii aak madas sui. Maqtu aas pasimul zaku sui?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62554/867886",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "azuq, pasimulak aas.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62554/867887",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
