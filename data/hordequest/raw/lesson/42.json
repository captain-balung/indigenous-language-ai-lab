{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "sino o ngaran mo?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/63038/880595",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ngaran ko si Sakayan",
                "textCh": "我叫Sakayan。",
                "sound": "text/sound/63038/880596",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "do anjin mo pivahayan?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/63038/880597",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ko nimapo do jivalino.",
                "textCh": "我從野銀部落來。",
                "sound": "text/sound/63038/880598",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ka nimaryag rana?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/63038/880599",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "jiabo pa!",
                "textCh": "還沒耶！",
                "sound": "text/sound/63038/880600",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ko mangay manazang so aryagen, macihza ka ang?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/63038/880601",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ya abo a ta o nizpi a nipalolo ko, apya ka vood mo jiyaken pa so nizpi?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/63038/880602",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "noon, pavooden ko jimo.",
                "textCh": "好，我借你。",
                "sound": "text/sound/63038/880603",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
