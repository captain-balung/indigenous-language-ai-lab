{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "i eman nanu ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/63016/880017",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "i Amsing nangku ngadan.",
                "textCh": "我叫Amsing。",
                "sound": "text/sound/63016/880018",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ulra i iyan nanu ruma’?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/63016/880019",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kemay Kasavakan ku.",
                "textCh": "我從建和部落來。",
                "sound": "text/sound/63016/880020",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "piya u lra kenama?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/63016/880021",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "adi diya.",
                "textCh": "還沒耶！",
                "sound": "text/sound/63016/880022",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "yawa ku cimima’a da kenamain, rarelrang u?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/63016/880023",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "adi ku miinada da paisu, karuwa u pavelas kaningku?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/63016/880024",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ai, kunu pavelasay.",
                "textCh": "好，我借你。",
                "sound": "text/sound/63016/880025",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
