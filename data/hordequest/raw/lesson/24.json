    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "tjima su ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62642/870191",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "tji sulja aken.",
                "textCh": "我叫sulja。",
                "sound": "text/sound/62642/870192",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "se nemasun?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62642/870193",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "se djiniljepan aken.",
                "textCh": "我從安坡部落來。",
                "sound": "text/sound/62642/870194",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "na kenamang a sun.",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62642/870195",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini’ anan.",
                "textCh": "還沒耶！",
                "sound": "text/sound/62642/870196",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "aru vaik aken a veneli taku kenemain kiyan ne sun?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62642/870197",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "malim aken na kemacu ta paysu. makaia sun a pasdjam tja nuaken?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62642/870198",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "makaya.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62642/870199",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
