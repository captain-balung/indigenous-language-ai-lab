{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Siaaneane ku nagane su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62730/872503",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Sia Kalrimadraw ku naganeli.",
                "textCh": "我叫Kalrimadraw。",
                "sound": "text/sound/62730/872504",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Yainu ku daane su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62730/872505",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Tualaduaku cekele Kucapungane.",
                "textCh": "我從好茶部落來。",
                "sound": "text/sound/62730/872506",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Tuakualrenga su?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62730/872507",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Iniana!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62730/872508",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Lrilangadhaku ku kualre, lritupalra su?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62730/872509",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Kainaku siapaisu. Lripakisaulru su nakuane?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62730/872510",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Uunu, nau pakisaalru musuane.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62730/872511",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
