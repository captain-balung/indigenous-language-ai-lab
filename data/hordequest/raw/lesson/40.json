    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "i eman nu ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62994/879439",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "i Malingan ku ngadan.",
                "textCh": "我叫Malingan。",
                "sound": "text/sound/62994/879440",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kaazu u i iyan?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62994/879441",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kemay ku i Mulivelivek kana zekalr.",
                "textCh": "我從初鹿部落來。",
                "sound": "text/sound/62994/879442",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kenama u lra?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62994/879443",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "’azi ziya",
                "textCh": "還沒耶！",
                "sound": "text/sound/62994/879444",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "makuwa ku tremima’a za kenanamayan, salrangan u mukuwa?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62994/879445",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "’azi ku murung za paisu, karuwa ku kivulas za paisu  kaninu?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62994/879446",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ai,ku pavulrasay u。",
                "textCh": "好，我借你。",
                "sound": "text/sound/62994/879447",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
