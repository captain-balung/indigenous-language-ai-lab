    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "i manay nu ngalad?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62950/878283",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "i Kayaw ku ngalad.",
                "textCh": "我叫Kayaw。",
                "sound": "text/sound/62950/878284",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ullaya isuwa nu ruma?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62950/878285",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kemay i Puyuma ku.",
                "textCh": "我從普悠瑪(南王)部落來。",
                "sound": "text/sound/62950/878286",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kenama yu lla?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62950/878287",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "adri driya!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62950/878288",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "auka ku tremimaa dra kakenamaan. kuarenang yu muka?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62950/878289",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "adri ku kemasu dra paisu. karuwa yu pabulas dra paisu kanku?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62950/878290",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "aiwa, ti pabulasay yu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62950/878291",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
