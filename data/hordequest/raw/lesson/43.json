{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "cima ku ngangan nu misu?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/63060/881173",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ci Kacaw ku ngangan nu maku",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/63060/881174",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "i cuwa ku luma’ nu misu?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/63060/881175",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "namaka i Angcuh tayni",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/63060/881176",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "namalanam tu kisu haw?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/63060/881177",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "caay henay!",
                "textCh": "還沒耶！",
                "sound": "text/sound/63060/881178",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "amicakay kaku tu sakalanam, amaladay kita haw?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/63060/881179",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "caay kasikalisiw kaku, kapah pacaliwen kaku tu kalisiw haw?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/63060/881180",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "hang, pacaliwen aku kisu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/63060/881181",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
