{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Cima ko ngangan iso?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62202/858631",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ci Kacaw kako.",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/62202/858632",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Icowa ko loma’ iso?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62202/858633",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Na i Angcohay a niyaro’ a tayni kako.",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/62202/858634",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Maranam to kiso?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62202/858635",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Caay ho!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62202/858636",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "O mami’aca kako to sakaranam, mihakelong kiso?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62202/858637",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Awaay ko mihawikidan ako to payci, manga’ay pacaliw kiso to payci i takowanan?",
                "textCh": "我沒有帶錢，你可以借我錢嗎？",
                "sound": "text/sound/62202/858638",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Hayda, pacaliwen ako kiso.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62202/858639",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
