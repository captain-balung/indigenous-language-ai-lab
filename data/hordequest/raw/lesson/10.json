{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "ima lalu su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62356/862677",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "lalu mu ga Kacu",
                "textCh": "我叫Kacu。",
                "sound": "text/sound/62356/862678",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "cyan maki inu muyax su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62356/862679",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "knahul cu qalang Skikun",
                "textCh": "我從四季部落來。",
                "sound": "text/sound/62356/862680",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "mnaniq su knama la?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62356/862681",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini cu qaniq knama na",
                "textCh": "還沒耶！",
                "sound": "text/sound/62356/862682",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "musa cu mes knama, squn su musa mes uyi ga?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62356/862683",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini cu aray pila, ana su ksyugan pila kingan ga?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62356/862684",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "uya ga, ksyugay misu",
                "textCh": "好，我借你。",
                "sound": "text/sound/62356/862685",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
