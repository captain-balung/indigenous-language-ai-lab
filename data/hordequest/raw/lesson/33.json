        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Ima hangan su",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62840/875393",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Hangan mu o Tadaw",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/62840/875394",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Gaga inu ka sapah su",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62840/875395",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Pnaah ku alang Ihunang.",
                "textCh": "我從紅葉部落來。",
                "sound": "text/sound/62840/875396",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mnkan su uqan mgrbu dhug?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62840/875397",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ini na",
                "textCh": "還沒耶！",
                "sound": "text/sound/62840/875398",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mowsa ku marig uqan mgrbu,tqnay su mowsa hug?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62840/875399",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ini ku adas pila,tduwa su psiyuk pila knan hug?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62840/875400",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Aq, Ksukay misu",
                "textCh": "好，我借你。",
                "sound": "text/sound/62840/875401",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
