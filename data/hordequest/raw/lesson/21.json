{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Tukau’uq isuu ngaan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62576/868457",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Tupa’un saak tu Lian.",
                "textCh": "我叫Lian。",
                "sound": "text/sound/62576/868458",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Isaq isuu lumaq?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62576/868459",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Misnahaan saak Sinapalan mun’iti.",
                "textCh": "我從新鄉部落來。",
                "sound": "text/sound/62576/868460",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mina’unin asu paitutingmut tu kakaunun?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62576/868461",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Nii’ang!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62576/868462",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Namabaliv saak paitutingmut tu kakaunun, asa asu taskun?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62576/868463",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Nii saak minadas sui, maqtu asu mapasimul zaku sui?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62576/868464",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Uu! Napasimulan zaku asu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62576/868465",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
