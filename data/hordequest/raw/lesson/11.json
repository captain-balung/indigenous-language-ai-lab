        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "ima lalu su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62378/863255",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Piho lalu mu.",
                "textCh": "我叫Piho。",
                "sound": "text/sound/62378/863256",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "cyu inu sali su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62378/863257",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kahun cu alang Pyahaw mwah.",
                "textCh": "我從碧候部落來。",
                "sound": "text/sound/62378/863258",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "waya su mani knama la?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62378/863259",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini nya!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62378/863260",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "mosa cu bayi knama, pgluw su mosa?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62378/863261",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini cu aras pila. syugan cu pila su?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62378/863262",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ana, syugay misu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62378/863263",
