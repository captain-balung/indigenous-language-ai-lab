{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Tukau’un ca ngaan suu’?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62510/866723",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Tupa’un tu Tiang ca ngaan naak.",
                "textCh": "我叫Tiang。",
                "sound": "text/sound/62510/866724",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Ica ca lumaq suu’?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62510/866725",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Minaha’an azak Ququaz maipa ti’.",
                "textCh": "我從曲冰部落來。",
                "sound": "text/sound/62510/866726",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mina’unin asuu paitutingmut?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62510/866727",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Nii’ang!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62510/866728",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Na mabaliv azak is paitutingmut a, maipa ta’ amin asuu?",
                "textCh": "我要去買早餐，你也要一起去嗎？",
                "sound": "text/sound/62510/866729",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Nii’ azak madas cuii, maqtu’ asuu pasimul zakun cuii?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62510/866730",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Maqtu’, pasimulan zaku asuu.",
                "textCh": "可以，我借你。",
                "sound": "text/sound/62510/866731",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
