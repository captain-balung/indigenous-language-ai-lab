{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "ima’ ku ralu’ su’? / nanuwan ku ralu’ su’?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62312/861521",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Kaynu’ ku ralu’ mu.",
                "textCh": "我叫Kaynu'。",
                "sound": "text/sound/62312/861522",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kiya inu’ ku imuwag su’?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62312/861523",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "minukahul kuwing i tinqalangan i Tabilas.",
                "textCh": "我從圓墩部落來。",
                "sound": "text/sound/62312/861524",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kumnunama’ su’ la qu?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62312/861525",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini’ na’ yo! / iqaat na’ yo!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62312/861526",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "mausa’ kuwing i mabanay cu kakunama’, paglu su’ i musa’ qu?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62312/861527",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini’ kuwing aras cu pila’, pakabalayq su’ i pakabaxan kuwing cu pila’ qu?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62312/861528",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "uwal, pakabaxay mi su’.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62312/861529",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
