{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Cima saw ku ngangan nu misu?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62158/857475",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ci Kacaw ku ngangan nu maku.",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/62158/857476",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Icuwa saw ku luma’ nu misu?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62158/857477",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Namaka Angcuh a niyaru’ kaku.",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/62158/857478",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Namaranam tu haw kisu?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62158/857479",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Caay hen!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62158/857480",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "A micakay kaku tu sakaranam, a mihakulung haw kisu?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62158/857481",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Awaay ku nikeridan nu maku tu pida, dengay haw kisu a pacaliw i takuwan?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62158/857482",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Hayi pacaliway nu maku kisu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62158/857483",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
