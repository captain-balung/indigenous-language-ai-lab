{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "O cima ko ngangan no miso?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62224/859209",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ci Kacaw ko ngangan no mako.",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/62224/859210",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "I cowaay ko loma’ no miso?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62224/859211",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "O naiAncohay a niyaro’ kako a tayni.",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/62224/859212",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Maranamay to kiso haw?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62224/859213",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Cowa ho!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62224/859214",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "O mami’aca kako to sakaranam, mihakelong kiso tayra haw?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62224/859215",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Awaay ko miolongan ako a payci, nga’ay pacaliwen iso kako to payci haw?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62224/859216",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Nga’ay to, pacaliwen ako kiso.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62224/859217",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
