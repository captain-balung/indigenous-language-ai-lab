{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Ima ngayan su ka isu?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62466/865567",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Walis ngayan mu ka yaku",
                "textCh": "我叫Walis。",
                "sound": "text/sound/62466/865568",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Gaga inu sapah su ka isu?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62466/865569",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Kndalax ku alang Tongan ka yaku.",
                "textCh": "我從眉溪部落來。",
                "sound": "text/sound/62466/865570",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mnekan su ido mgrebu di?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62466/865571",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ini na wa!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62466/865572",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Maha ku maruy ido mgrebu, ye su maha msuupu?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62466/865573",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ini ku adis pila. Ye su kbrexun pila ka yaku?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62466/865574",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Un, kbrexun misu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62466/865575",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
