{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "aci aracsu?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62796/874237",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Kukui kɨkɨ.",
                "textCh": "我叫Kukui。",
                "sound": "text/sound/62796/874238",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ika tékadra ku dasu? /dasu ka ika tékadra?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62796/874239",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "salké kɨkɨ teldrɨka ckɨckɨlɨ mukné.",
                "textCh": "我從茂林部落來。",
                "sound": "text/sound/62796/874240",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "tikierɨnga musu?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62796/874241",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "énila!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62796/874242",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "nwama kɨkɨ longé na kierɨ, nunguresɨ ma musu mua?",
                "textCh": "我要去買早餐，你要一起去嗎？",
                "sound": "text/sound/62796/874243",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "imɨcɨ kɨkɨ na pésu, nuduru ma musu késdamɨ la kwa na pésu?",
                "textCh": "我沒有帶錢，你可以借我錢嗎？",
                "sound": "text/sound/62796/874244",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "iyo, ku ksédmɨ swa.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62796/874245",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
