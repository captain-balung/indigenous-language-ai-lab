    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "sya anea ku nagane su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62752/873081",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "sya Pacaka ku.",
                "textCh": "我叫Pacaka。",
                "sound": "text/sound/62752/873082",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "yakai inu ku daane su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62752/873083",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "twaladha ku Labuwa kela.",
                "textCh": "我從大武部落來。",
                "sound": "text/sound/62752/873084",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "wakanenga su ku kwalre?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62752/873085",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "iniyana!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62752/873086",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ailangadhaku ku kwalre, aitupalra su?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62752/873087",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kadruwa ka wailuku ku paisu, aidulrusu pakisalru makuwa?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62752/873088",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "eene, nau pakisalru musuwa.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62752/873089",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
