{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Cima ko ngangan no miso?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62246/859787",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ci Kacaw ko ngangan no mako.",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/62246/859788",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Icowaay ko loma’ no miso?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62246/859789",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Nani Dihekoay a niyaro’ kako a tayni.",
                "textCh": "我從陸安部落來。",
                "sound": "text/sound/62246/859790",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Maranamay to kiso?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62246/859791",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Cowa ho!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62246/859792",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mami’aca kako to sakaranam, mihakelong kiso?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62246/859793",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Cowa piala kako to payci, manga’ay pacaliwen iso kako to payci?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62246/859794",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Hayda, pacaliw han to ako kiso.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62246/859795",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
