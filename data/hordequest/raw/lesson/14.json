{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "kuzan mihu a lhanaz?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62422/864411",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "zain naak a lhanaz Hudun.",
                "textCh": "我叫Hudun。",
                "sound": "text/sound/62422/864412",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "intua s mihu a taun?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62422/864413",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "minakanatusi iaku Baraubaw a kataunan.",
                "textCh": "我從伊達邵部落來。",
                "sound": "text/sound/62422/864414",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kinunshashanuiza ihu qa?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62422/864415",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "niwan iaku tu kinunshashanu.",
                "textCh": "我還沒吃早餐耶！",
                "sound": "text/sound/62422/864416",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "amutusiwak fariw sa kunshashanu, apalhintaz ita?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62422/864417",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ani iaku tu minathu tuali, anaiwan mihu a tuali shimulik?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62422/864418",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ua, kminathu iaku tuali, shimuluan uhu.",
                "textCh": "好，我有帶，借你。",
                "sound": "text/sound/62422/864419",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
