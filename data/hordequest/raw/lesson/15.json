    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Ima ka hangan su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62444/864989",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ukan ka hangan mu.",
                "textCh": "我叫Ukan。",
                "sound": "text/sound/62444/864990",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Wa inu ka sapah su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62444/864991",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Kndadax ku alang Toda ka yaku.",
                "textCh": "我從都達部落來。",
                "sound": "text/sound/62444/864992",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Mnekan su uqun mrbu da?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62444/864993",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ini na wah!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62444/864994",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Musa ku mari equn mrbu, supu ta musa haw?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62444/864995",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ini ku adas pila. Malu su pkbarux pila yaku hu?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62444/864996",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Iyaq, kbrxun misu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62444/864997",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
