    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "So’o Sin hiya’en?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62400/863833",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "yako Sin ’atawen",
                "textCh": "我叫’atawen。",
                "sound": "text/sound/62400/863834",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "niSo’ taew’an hayno’?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62400/863835",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "yako ’inay walo’ ’asang mowa:i’.",
                "textCh": "我從東河部落來。",
                "sound": "text/sound/62400/863836",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "So’o komhaema’ ila ay?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62400/863837",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "’i’ini’ o!",
                "textCh": "還沒喔！",
                "sound": "text/sound/62400/863838",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "yako ’am rima’ bae:iw ka kohaema’en, ’am ma’onhael rima’ ay?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62400/863839",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "yako ’okay ’araS ka rayhil. So’o kayzaeh ay paSibae:aeh ’iyakin ka rayhil.",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62400/863840",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "’a:ay, yako taSibae:aeh ’iSo’on.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62400/863841",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
