{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "neni nganai musu?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/71668/998371",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "sua nganai maku ia Pani.",
                "textCh": "我叫Pani。",
                "sound": "text/sound/62906/877128",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "’esi nanu tanasa musu?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/71668/998372",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "’esi Namasia tanasa maku.",
                "textCh": "我從那瑪夏部落來。",
                "sound": "text/sound/62906/877130",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "nikucici cu kara kasu?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/71668/998373",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "koo pa ku kucici.",
                "textCh": "還沒耶！",
                "sound": "text/sound/62906/877132",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "tia ku pu’a kʉnʉa, tia kara kasu kipapa?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/71668/998374",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "koo ku marivici vantuku, tʉni kara kasu ’apasuruvai ’ikua vantuku?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62906/877134",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ʉʉ’ʉ, ’apasuruvai ku kasua.",
                "textCh": "好，我借你。",
                "sound": "text/sound/71668/998375",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
