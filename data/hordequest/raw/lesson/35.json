{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "zou cumas’a na ongkosu?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62884/876549",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "zou Voyu ’o ongko’u.",
                "textCh": "我叫Voyu。",
                "sound": "text/sound/62884/876550",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "mios’a yonenu na emoosu?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62884/876551",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "mi’o i’mi ne Tfuya.",
                "textCh": "我從特富野部落來。",
                "sound": "text/sound/62884/876552",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "mikocu otaseoni?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62884/876553",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "o’a mocu!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62884/876554",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "te’o mhia no te ana no taseona, teko fiho?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62884/876555",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "mi’o o’te mahafo to peisu . te’o meelʉ yuevaho no peisusu?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62884/876556",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "zou, te’o yuevahneni suu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62884/876557",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
