{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "ima lalu su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62290/860943",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "lalu muw ga Tuyaw Syat",
                "textCh": "我叫Tuyaw Syat。",
                "sound": "text/sound/62290/860944",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ki inu ku sali su",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62290/860945",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kahun kung alang Nguhuw Ruma.",
                "textCh": "努呼路瑪路瑪部落來。",
                "sound": "text/sound/62290/860946",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "minknama su la?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62290/860947",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini na!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62290/860948",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "musa kung mbaziy knama ha, musa su uzi?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62290/860949",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini kung aras pila. ksyukay ta pila su aw?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62290/860950",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "aw, ksyukay misu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62290/860951",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
