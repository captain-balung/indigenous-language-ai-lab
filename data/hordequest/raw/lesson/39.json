{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "i eman nu ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62972/878861",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "i Tanuvak aku ngadan.",
                "textCh": "我叫Tanuvak。",
                "sound": "text/sound/62972/878862",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ulra i iyan nu ruma’?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62972/878863",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kemay ku i Antung kana zekalr.",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/62972/878864",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "kenama u lra?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62972/878865",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "’azi ku ziya!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62972/878866",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "awa ku tremima’a za kenanamain, salralrangan u mukuwa?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62972/878867",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "’azi ku mada za paisu. kararuwa u pavelas za paisu kaninku?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62972/878868",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ai, ku pavelasay u.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62972/878869",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
