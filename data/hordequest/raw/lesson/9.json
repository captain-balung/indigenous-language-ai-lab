{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "amol ka ralu su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62334/862099",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Watan ka ralu mu.",
                "textCh": "我叫Watan。",
                "sound": "text/sound/62334/862100",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "cel inu’ ka moṟow su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62334/862101",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "minoh cu alang Plngawan.",
                "textCh": "我從萬大部落來。",
                "sound": "text/sound/62334/862102",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "minne su sasan la aw?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62334/862103",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini cu kani’ na.",
                "textCh": "還沒耶！",
                "sound": "text/sound/62334/862104",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "maha’ cu mini’ ci naniun na sasan, maha’ su magalu’ kinang aw?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62334/862105",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini cu aras ci pila’, sici’ aku’ tikiy aw?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62334/862106",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ho! kaci’ misu.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62334/862107",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
