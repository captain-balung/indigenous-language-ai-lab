    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "kasimaan a kasu i?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62598/869035",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Biung a saikin",
                "textCh": "我叫Biung。",
                "sound": "text/sound/62598/869036",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "isa a isuu lumah i?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62598/869037",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "maisnasian Nansalu a saikin minsuma",
                "textCh": "我從南沙魯部落來。",
                "sound": "text/sound/62598/869038",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "adu minaunin a kasu mas pinitcingmut i?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62598/869039",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "nii’ang",
                "textCh": "還沒耶！",
                "sound": "text/sound/62598/869040",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "nakaudiip a saikin mabaliv mas pinitcingmut",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62598/869041",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "nii a saikin mai’adas mas sui, adu mahtu a kasu mapasimulku mas sui i?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62598/869042",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "mahtu, pasimulanku a kasu",
                "textCh": "好，我借你。",
                "sound": "text/sound/62598/869043",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
