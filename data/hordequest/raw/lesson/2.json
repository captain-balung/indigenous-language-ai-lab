{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "Cima ko ngangan iso?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/71667/998332",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Ci Kacaw ko ngangan ako.",
                "textCh": "我叫Kacaw。",
                "sound": "text/sound/62180/858054",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Icowa ko loma’ iso?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/71667/998333",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Nai Angcohay niyaro’ kako.",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/62180/858056",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Na maranamay to kiso saw?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/71667/998334",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Caho ari!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62180/858058",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Tamita mahakelong? Mi’aca kako to sakaranam.",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/71667/998335",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Awa ko nihawikidan ako a payci, manga’ay kiso pacaliw to payci takonan.",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62180/858060",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "Nga’ay to, pacaliwen ako kiso.",
                "textCh": "好，我借你。",
                "sound": "text/sound/71667/998336",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
