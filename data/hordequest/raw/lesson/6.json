        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "ima lalu su?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62268/860365",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "Basaw lalu mu.",
                "textCh": "我叫Basaw。",
                "sound": "text/sound/62268/860366",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "cyux maki inu qu ngasal su?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62268/860367",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "minkahul saku qalang Mstbon.",
                "textCh": "我從瑞岩部落來。",
                "sound": "text/sound/62268/860368",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "wal su klama lga?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62268/860369",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini na ay!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62268/860370",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "musa saku mbazi nniqun sasan, pgluw su musa pi?",
