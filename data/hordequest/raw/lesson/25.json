    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "tima su ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62664/870769",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ti Puljaljuyan a ku ngadan.",
                "textCh": "我叫Puljaljuyan。",
                "sound": "text/sound/62664/870770",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "inu a su umaq?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62664/870771",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kemasi Antung aken.",
                "textCh": "我從安通部落來。",
                "sound": "text/sound/62664/870772",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "a na kenamanga sun?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62664/870773",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ini anan.",
                "textCh": "還沒耶！",
                "sound": "text/sound/62664/870774",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "uri vaik aken a veneli tua ku kenamain, a vaik sun?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62664/870775",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "inika na masi paisu aken, a maqati sun a pasedjam tjanuaken?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62664/870776",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ui, ku pasedjamayanga.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62664/870777",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
