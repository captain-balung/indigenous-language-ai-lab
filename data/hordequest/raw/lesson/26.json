{
    "theme": "上課用語",
    "data": {
        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "timma su ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62686/871347",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ti Kuliu a u ngadan.",
                "textCh": "我叫Kuliu。",
                "sound": "text/sound/62686/871348",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "inu a su tjumaq?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62686/871349",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kasi Sinevaudjan aen.",
                "textCh": "我從牡丹部落來。",
                "sound": "text/sound/62686/871350",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "na kenama nga sun?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62686/871351",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "nekanan i!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62686/871352",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "uri vaik aen a veneli tua kenemain, kiciyur sun?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62686/871353",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "inikaen  a na masi valjitjuq, maqti  a  su pasedjaman aen?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62686/871354",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "nanguaq, u su pasedjamay.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62686/871355",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
        ],
