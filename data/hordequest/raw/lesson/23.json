        "phase1": [
            {
                "text": "今天是開學第一天！<br>主角在校門口遇到同學，他們在說什麼呢？"
            },
            {
                "text": "tima su ngadan?",
                "textCh": "你叫甚麼名字？",
                "sound": "text/sound/62620/869613",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "ti kuljelje aken.",
                "textCh": "我叫kuljelje。",
                "sound": "text/sound/62620/869614",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "inuan su umaq?",
                "textCh": "你的家在哪裡？",
                "sound": "text/sound/62620/869615",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "kemasi tjuabar aken.",
                "textCh": "我從土坂部落來。",
                "sound": "text/sound/62620/869616",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "na kenamanga sun?",
                "textCh": "你吃早餐了嗎？",
                "sound": "text/sound/62620/869617",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "inianan!",
                "textCh": "還沒耶！",
                "sound": "text/sound/62620/869618",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "uri vaik aken a veneli ta kenamaing ari kaciuli?",
                "textCh": "我要去買早餐，要一起去嗎？",
                "sound": "text/sound/62620/869619",
                "image": "girl.png",
                "background": "1-1.jpg"
            },
            {
                "text": "inia ken na kemacu ta paisu. maqati sun a pasedjaman tjanuaken?",
                "textCh": "我沒有帶錢。你可以借我錢嗎？",
                "sound": "text/sound/62620/869620",
                "image": "boy.png",
                "background": "1-2.jpg"
            },
            {
                "text": "ui ! ku pasedjamay sun.",
                "textCh": "好，我借你。",
                "sound": "text/sound/62620/869621",
                "image": "girl.png",
                "background": "1-1.jpg"
            }
