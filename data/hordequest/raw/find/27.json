{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "naina kaivaiyana kai mitana wakela ka takalra ka laretesaneta!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66239/924379",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kaivaiyana taki’alanga ki taka ka sawalay, lamani kwani aitakalra ka omase ka wakela.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66239/924380",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "matiyagiragay ’aramoro! mawlainga nako maceceele ki liniya.",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66239/924381",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "eene! kaivaiyana aitarakakalra ka atomananeta, wakelata ’alribolo.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66239/924382",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "eene, aitara’alribolako.",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66239/924383",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ai’adolroanako ki sarakaiya twatoma ki lamanema lwasa.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66239/924384",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "na’alribolo ’osakaelre mosowa.",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66239/924385",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "eene, ,niyama to’a’alraili.",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66239/924386",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "kwani baowa ka dilrong la miyakakwa kai tamiyaini",
                    "textAb": "kwani baowa ka dilrong la miyakakwa kai tamiyaini?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66240/924389",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "yakai ino kwani sali",
                    "textAb": "yakai ino kwani sali?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66241/924397",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "waceeleso idra sabiki",
                    "textAb": "waceeleso idra sabiki?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66242/924405",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "yakaino ko taka ka sawalay",
                    "textAb": "yakaino ko taka ka sawalay",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66243/924413",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "manema",
                    "textCh": "什麼？",
                    "sound": "text/sound/66238/924376"
                },
                "1": {
                    "text": "wa’arakaiyako makalrilaw cwabo",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66240/924390"
                },
                "2": {
                    "text": "miyali kainako wathingale",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66241/924398"
                },
                "3": {
                    "text": "kadrwa kikai",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66242/924406"
                },
                "4": {
                    "text": "kadrwa ka waceele, amwaino ko taka?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66243/924414"
                }
            },
            "target-2": {
                "0": {
                    "text": "kadrwa ka wa’olringaw",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66238/924377"
                },
                "1": {
                    "text": "kai tinatina arakai ki direrele ka makalrilaw cwabo",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66240/924391"
                },
                "2": {
                    "text": "talikai ki lregelrege ka yakai",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66241/924399"
                },
                "3": {
                    "text": "yakai, beleng ki alrono",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66242/924407"
                },
                "4": {
                    "text": "kaiyana mwatalivaivai?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66243/924415"
                }
            },
            "target-3": {
                "0": {
                    "text": "kadrwa ka wathingale",
                    "textCh": "不知道！",
                    "sound": "text/sound/66238/924378"
                },
                "1": {
                    "text": "marimorako",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66240/924392"
                },
                "2": {
                    "text": "yakai ka ’asatedraneli, naw bwainga mosowa",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66241/924400"
                },
                "3": {
                    "text": "kwani adring ki taemere ka yakai",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66242/924408"
                },
                "4": {
                    "text": "kadrwanga? kirarokodra mwa sila’e",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66243/924416"
                }
            },
