{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "Tina! Madia haip munahaan lumaq tu taisis’aan!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66203/924103",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Mapasiza haip tuqasnanaz, paaqpun madia taisis’aan minsuma.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66203/924104",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Manahip is’aang qai! Talbuntu’in nii tu mapasaduu intaa.",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66203/924105",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Tuza qai! Na’isnangu amin ata haip, asa asu tu mindangaz zami.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66203/924106",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Uu! Namindangaz azak.",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66203/924107",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Namapalsanusin azak sanganin ikma’ai’un tu qaimangsut.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66203/924108",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Zaku’a mindangaz!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66203/924109",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Uu! Makilansana zaku!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66203/924110",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "maku’aq a tahamis sintas’i",
                    "textAb": "Maku’aq a tahamis sintas’i?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66204/924113",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "isaq haiza’an sizu",
                    "textAb": "Isaq haiza’an sizu?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66205/924121",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "sinaduu asu saviki",
                    "textAb": "Sinaduu asu saviki?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66206/924129",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "isaq a tuqasnanaz",
                    "textAb": "Isaq a tuqasnanaz?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66207/924137",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "Ma’aq?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66202/924100"
                },
                "1": {
                    "text": "Kusia’an zaku maqaihav masubu.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66204/924114"
                },
                "2": {
                    "text": "Nii amin azak maqansiap.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66205/924122"
                },
                "3": {
                    "text": "Uka zaku’anti.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66206/924130"
                },
                "4": {
                    "text": "Nii azak sinaduu, mun’isaq naipa tu?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66207/924138"
                }
            },
            "target-2": {
                "0": {
                    "text": "Nii tu itqaalun?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66202/924101"
                },
                "1": {
                    "text": "Makusia tina madangqas tu maqaihav masubu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66204/924115"
                },
                "2": {
                    "text": "Kaupa ihaan ludun haiza.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66205/924123"
                },
                "3": {
                    "text": "Haiza ihaan lungu’an daza.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66206/924131"
                },
                "4": {
                    "text": "Nii’ang naipa minsuma?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66207/924139"
                }
            },
            "target-3": {
                "0": {
                    "text": "Nii tu maqansiap!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66202/924102"
                },
                "1": {
                    "text": "Nii’in azak niap.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66204/924116"
                },
                "2": {
                    "text": "Madia inaak, saivak asu!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66205/924124"
                },
                "3": {
                    "text": "Haiza ihaan daiza tu kalala’a.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66206/924132"
                },
                "4": {
                    "text": "Nii’in saduu’an? Kavavaa’a kilim istaa!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66207/924140"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
                    "tips": "去問問看陶壺的特徵，找出新的陶壺吧！",
