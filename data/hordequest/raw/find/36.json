                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/71668/998401",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "’esi nanu kana’ua sarunai",
                    "textAb": "’esi nanu kana’ua sarunai?",
                    "textCh": "哥哥在哪裡？",
