                },
                "1": {
                    "text": "niarupaca maku panavi mupucu.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/71668/998398"
                },
                "2": {
                    "text": "ka’anʉ ku kangvang tavarʉ’ʉ",
