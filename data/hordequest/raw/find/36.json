            },
            "target-2": {
                "0": {
                    "text": "ka’anʉ akanangʉ",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66292/924792"
                },
                "1": {
                    "text": "niarupaca cina masinang panavi mupucu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66294/924806"
                },
                "2": {
                    "text": "’inmamia cimʉrʉ ’una.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66295/924814"
                },
                "3": {
                    "text": "’una, ’esi na ta’ʉnʉ.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/71668/998402"
                },
                "4": {
                    "text": "koo pa kara nguain arapiningi?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/71668/998406"
                }
            },
            "target-3": {
                "0": {
                    "text": "tokia’e",
                    "textCh": "不知道！",
                    "sound": "text/sound/66292/924793"
                },
                "1": {
                    "text": "ka’anʉ ku atʉnʉngʉ.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66294/924807"
                },
                "2": {
                    "text": "’una ku namasʉ, vuʉn kasua.",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66295/924815"
                },
                "3": {
                    "text": "’una ’esi na karara isa.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/71668/998403"
                },
                "4": {
                    "text": "niara’akia kara? pakavura tikirimi ’inia!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66297/924831"
                }
