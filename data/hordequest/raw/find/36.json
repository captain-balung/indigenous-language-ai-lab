{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "cina, kacaua kincaucaua soni iavatu tanasa.",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/71668/998389",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "muru’ucangʉ kana’ua sarunai soni, imua kacaua cau iavatu.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/71668/998390",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "cucuru macangcangarʉ! miaranau cu koo cumacʉ’ʉra nguani.",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/71668/998391",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ʉʉ’ʉ iaa! ’isiungasi kita soni, tia kasu muranʉ kitana.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/71668/998392",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ʉʉ’ʉ, tia ku muranʉ.",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/71668/998393",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "tia ku mati’arangʉ tia siarupaca nonoman nusoni.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/71668/998394",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "iavatu ku muranʉ.",
                "textCh": "我來幫忙！",
                "sound": "text/sound/71668/998395",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ʉʉ’ʉ, kipapaa ’ikua!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/71668/998396",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "makananu capai vo’orua iakaang",
                    "textAb": "makananu capai vo’orua iakaang?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/71668/998397",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "’esi nanu ’una tapa",
                    "textAb": "’esi nanu ’una tapa?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/71668/998399",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "cinimʉ’ʉra kara kasu ’aviki",
