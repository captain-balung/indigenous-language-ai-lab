                    "sound": "text/sound/71668/998400"
                },
                "3": {
                    "text": "’akia na ’ikua sian.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66296/924821"
                },
                "4": {
                    "text": "’akia cʉ’ʉrʉʉn, ’acu nanu?",
                    "textCh": "沒看到，他去哪了？",
