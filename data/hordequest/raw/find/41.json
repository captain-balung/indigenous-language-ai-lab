{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "ina, harem kana wari, man kaduwan na wadadiyan duwa kanta ruma’?",
                "textCh": "媽媽，今天家裡為何來了這麼多親友呢？",
                "sound": "text/sound/66323/925024",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "pakaetim i vau harem kana wari, semalra kaduwan na cau duwa.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66323/925025",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "wa! kana semangal ku yi! sawariyan ku lra adi mena’u kanadu!",
                "textCh": "哇！我好開心喔！我很久沒有看到他們了！",
                "sound": "text/sound/66323/925026",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ai mu! mavangavang ta harem kana wari. pulralrangay ta ay!",
                "textCh": "對啊！今天大家都會很忙，要幫忙大家喔！",
                "sound": "text/sound/66323/925027",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ai, daduwa ku!",
                "textCh": "好的，我會來的！",
                "sound": "text/sound/66323/925028",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "paadang ku diya kana piyaemanan nu maremay.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66323/925029",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "anlra! kunu pulralrangay!",
                "textCh": "走吧！我來幫忙！",
                "sound": "text/sound/66323/925030",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ai, iturusay ku!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66323/925031",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "kumuda tu inudawayan na vekaran na siwpan",
                    "textAb": "kumuda tu inudawayan na vekaran na siwpan?",
                    "textCh": "新的水陶壺長怎樣？",
                    "sound": "text/sound/66324/925034",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "ulra a lriyapauy i iyan",
                    "textAb": "ulra a lriyapauy i iyan?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66325/925042",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "mena’u u da puran",
                    "textAb": "mena’u u da puran?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66326/925050",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "ulra i iyan i valri na ma’inay",
                    "textAb": "ulra i iyan i valri na ma’inay?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66327/925059",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "man?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66322/925021"
                },
                "1": {
                    "text": "ku cavuwaw kana kilē.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66324/925035"
                },
                "2": {
                    "text": "taa, adi ku madalram.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66325/925043"
                },
                "3": {
                    "text": "uniyan kaningku",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66326/925051"
                },
                "4": {
                    "text": "adi ku mena’u, mukuwa i iyan diyamaw?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66327/925060"
                }
            },
            "target-2": {
                "0": {
                    "text": "ma’ulid ku kinger.",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66322/925022"
                },
                "1": {
                    "text": "tu cavuwaw kana dangdarang na kilē i ina.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66324/925036"
                },
                "2": {
                    "text": "i henan ulra.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66325/925044"
                },
                "3": {
                    "text": "ulra, ulra i makaicas kana lipad.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66326/925052"
                },
                "4": {
                    "text": "adi diya mupacalan diyamaw?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66327/925061"
                }
            },
            "target-3": {
                "0": {
                    "text": "taa adi ku madalram!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66322/925023"
                },
                "1": {
                    "text": "malalup ku lra.",
                    "textCh": "我忘了。",
                    "sound": "text/sound/66324/925037"
                },
                "2": {
                    "text": "ulra ku sama’, ku lra verayay u!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66325/925045"
                },
                "3": {
                    "text": "ulra kadiyu kana ’ara.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66326/925053"
                },
                "4": {
                    "text": "mulremes diyamaw? pakunamun aya’u intaw!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66327/925062"
                }
            },
