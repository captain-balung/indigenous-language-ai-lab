                }
            ],
            "target-1": {
                "0": {
                    "text": "nanu",
                    "textCh": "什麼？",
                    "sound": "text/sound/66124/923501"
                },
                "1": {
                    "text": "s’agan muw gali smakuy.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66126/923515"
                },
                "2": {
                    "text": "ini muw ba’iy uzi.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66127/923523"
                },
                "3": {
                    "text": "ungat kung runiy hiya.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66128/923531"
                },
                "4": {
                    "text": "ini muw txiy, wayan inu ku hiya la?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66129/923539"
                }
            },
            "target-2": {
                "0": {
                    "text": "ini ba’iy mung?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66124/923502"
                },
                "1": {
                    "text": "s’agan tanah gali skuyun ni yaya.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66126/923516"
                },
                "2": {
                    "text": "nanak rgyax kyan.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66127/923524"
                },
                "3": {
                    "text": "kyan, ki sku babaw t’ngan.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66128/923532"
                },
                "4": {
                    "text": "ini htuw ku hiya na ga?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66129/923540"
                }
            },
            "target-3": {
                "0": {
                    "text": "ima ba / ba’aw ta",
                    "textCh": "不知道！",
                    "sound": "text/sound/66124/923503"
                },
                "1": {
                    "text": "yengan muw la.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66126/923517"
                },
                "2": {
                    "text": "pyux kung hiya, niy!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66127/923525"
                },
                "3": {
                    "text": "mki zik yawa hasa.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66128/923533"
                },
                "4": {
                    "text": "ungat la ga? ihiy haliy hkangi!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66129/923541"
                }
            },
