{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "sali ni yaya ga pyux balay lpyung niyan ki!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66125/923504",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "soni ga ryax kikung ni bsuyan tmalung, lunga sa hbayaw balay tayan niyan.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66125/923505",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "m’as balay inlungan muw ki ! bsya balay ini txiy laha la!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66125/923506",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "hu rwa ! pyux balay yuwaw ta ryax soni, ragiy mtyaw kwara naha ki.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66125/923507",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "aw, praw kung mtyaw!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66125/923508",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "musa kung nama ptubu kisa pbingun ta yeyuyaw la.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66125/923509",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ragay misu!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66125/923510",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aw, pgluw kuzing!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66125/923511",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "maha nanu sinrxan g’anus na tahang",
                    "textAb": "maha nanu sinrxan g’anus na tahang?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66126/923514",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "inu kyan na bsikan",
                    "textAb": "inu kyan na bsikan?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66127/923522",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "wayan su txan pinnang ga",
                    "textAb": "wayan su txan pinnang ga?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66128/923530",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "ki inu ku bsuyan tmalung",
                    "textAb": "ki inu ku bsuyan tmalung?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66129/923538",
