            ],
            "target-1": {
                "0": {
                    "text": "mcwa?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66148/923685"
                },
                "1": {
                    "text": "waya mu sbun tapang.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66150/923699"
                },
                "2": {
                    "text": "ini mu ba’i uyi.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66151/923707"
                },
                "3": {
                    "text": "beh mu hani ga ungat.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66152/923715"
                },
                "4": {
                    "text": "ini texiy, wa inu heya la?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66153/923723"
                }
            },
            "target-2": {
                "0": {
                    "text": "ini ba’i mung?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66148/923686"
                },
                "1": {
                    "text": "waya sbun talah tapang nku yaya.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66150/923700"
                },
                "2": {
                    "text": "babaw rgyax ga maki.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66151/923708"
                },
                "3": {
                    "text": "kyan, cyu babaw tman haca.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66152/923716"
                },
                "4": {
                    "text": "ini htu heya na?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66153/923724"
                }
            },
            "target-3": {
                "0": {
                    "text": "ini ba’i!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66148/923687"
                },
                "1": {
                    "text": "ini mu kba’i la.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66150/923701"
                },
                "2": {
                    "text": "kyan msyaw mu, bi’ay misu.",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66151/923709"
                },
                "3": {
                    "text": "cyu kyan beh iyik takin haca.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66152/923717"
                },
                "4": {
                    "text": "ini texiy la? nahay usa hkani heya!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66153/923725"
                }
            },
