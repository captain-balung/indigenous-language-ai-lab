{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "piyux ci gluw lpyung nyu mwah sali yaya mu soni.",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66149/923688",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "soni ga ryax ms’un na suyan mlikuy, nanu yaca piyux ci c’oli nyu mwah.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66149/923689",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "p’asun calay wah! bsya ci ini texiy naha la!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66149/923690",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "angu ha! mosa piyux ci yaw ta kisa, usa rmaw kwara naha.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66149/923691",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ba’un mu, mosa caku ci rmaw.",
                "textCh": "好的，我一定會幫！",
                "sound": "text/sound/66149/923692",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "hala caku lama sr’yu cikah y’aya kle’un mu kisa ha.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66149/923693",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "mwah cu rmaw isu.",
                "textCh": "我來幫忙你！",
                "sound": "text/sound/66149/923694",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ana uyi, nanu isu gluw kinang.",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66149/923695",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "yani kenu yakang uraw haca",
                    "textAb": "yani kenu yakang uraw haca?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66150/923698",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "beh inu ga kyan geto nya",
                    "textAb": "beh inu ga kyan geto nya?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66151/923706",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "waya su texan binro haca",
                    "textAb": "waya su texan binro haca?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66152/923714",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "cyu inu suyan mlikuy",
                    "textAb": "cyu inu suyan mlikuy?",
                    "textCh": "哥哥在哪裡？",
