            },
            "target-2": {
                "0": {
                    "text": "Ini klayi qnbahang",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66274/924653"
                },
                "1": {
                    "text": "Gaga na lbuun galiq embanah ka bubu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66276/924667"
                },
                "2": {
                    "text": "Ga dgiyaq hiya ka niqan.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66277/924675"
                },
                "3": {
                    "text": "Niqan, ga babaw tleegan.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66278/924683"
                },
                "4": {
                    "text": "Ini iyah ngangut na hug?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66279/924691"
                }
            },
            "target-3": {
                "0": {
                    "text": "Ini kla",
                    "textCh": "不知道！",
                    "sound": "text/sound/66274/924654"
                },
                "1": {
                    "text": "Ini mu klai da.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66276/924668"
                },
                "2": {
                    "text": "Niqa lala ka naku,biqun misu.",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66277/924676"
                },
                "3": {
                    "text": "Niqan ka  rawa hiya uri.",
