            "target-1": {
                "0": {
                    "text": "manu",
                    "textCh": "什麼？",
                    "sound": "text/sound/66274/924652"
                },
                "1": {
                    "text": "Gaga mu lbuun galiq.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66276/924666"
                },
                "2": {
                    "text": "Ini ku kla uri.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66277/924674"
                },
                "3": {
                    "text": "Ungat ka yaku hini",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66278/924682"
                },
                "4": {
                    "text": "Ini qtai,wada inu dhug?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66279/924690"
