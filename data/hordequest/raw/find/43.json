                    "sound": "text/sound/66337/925137"
                },
                "3": {
                    "text": "inayi’ i tini",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66338/925145"
                },
                "4": {
                    "text": "caay kaazih, tala cuwa tu saw?",
