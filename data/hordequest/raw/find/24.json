{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "ina. aku tjruvu sa maka tja kaka a mantjez a tucu",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66221/924241",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aza ru papucekel tjin tjai su kaka tucu. si ka vaca’ sa maka ra tja kaka",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66221/924242",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "cuai yanga i ka tjen na micevucevun. malevaken a ravac.",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66221/924243",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ui e.  aru maracan a ravac a tucu. pusaladju anga nu izau a sengesengan",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66221/924244",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ui. tjara pusalad aken",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66221/924245",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aru vaik a ngaken na kipusengesenga. ta ru tja si kudakuda nu sauni",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66221/924246",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ari ku pusaladjau sun",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66221/924247",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ui. ari",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66221/924248",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "ki na matainuan a zua vau’an a reretan",
                    "textAb": "ki na matainuan a zua vau’an a reretan.",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66222/924251",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "izainu a ngat",
                    "textAb": "izainu a ngat",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66223/924259",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "na pacun sun ta saviki",
                    "textAb": "na pacun sun ta saviki",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66224/924267",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "izai nu tji kaka",
                    "textAb": "izai nu tji kaka",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66225/924275",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "anema?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66220/924238"
                },
                "1": {
                    "text": "ku linipulip ta makaliljau",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66222/924252"
                },
                "2": {
                    "text": "ini’ ka ken a kemelan angauta",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66223/924260"
                },
                "3": {
                    "text": "neka’ i maza",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66224/924268"
                },
                "4": {
                    "text": "inji’ ka napacun aken a nangauta. ki ru mainu ri",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66225/924276"
                }
            },
            "target-2": {
                "0": {
                    "text": "anemanema ya sun?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66220/924239"
                },
                "1": {
                    "text": "linipilip tu udjidjil a makaliljau nji kina",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66222/924253"
                },
                "2": {
                    "text": "izua i vavua",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66223/924261"
                },
                "3": {
                    "text": "izua  ita iladjan",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66224/924269"
                },
                "4": {
                    "text": "inji’ ka vaca’ anan?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66225/924277"
                }
            },
            "target-3": {
                "0": {
                    "text": "adjav",
                    "textCh": "不知道！",
                    "sound": "text/sound/66220/924240"
                },
                "1": {
                    "text": "malimangaken",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66222/924254"
                },
                "2": {
                    "text": "izua njiaken .kuluvadau sun",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66223/924262"
                },
                "3": {
                    "text": "izua ita karadjulj",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66224/924270"
                },
                "4": {
                    "text": "maulau? pai tja kimau",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66225/924278"
                }
            },
            "stage": [
                {
