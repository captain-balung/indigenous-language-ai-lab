{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "naine, kayasaa mitaana wakela ku takalra ku lahetesaneta!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66251/924471",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kayasaa takahudranga ki taka ka vai, lakuni aitakalra ku umase ku wakela.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66251/924472",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "matiakihagai! maulainganaku kai ceele liniya!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66251/924473",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "eene, kayasaa aikakalra ku atwatumana, wakelamadu palribulu.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66251/924474",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "eene, aitahapalribulaku!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66251/924475",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aipadulruananaku ku sahakaiya twatuma luasaa.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66251/924476",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "taanau palribulu!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66251/924477",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "eene, nyama tupalraili!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66251/924478",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "kwani bauwa ka kadilrunga mikakwakuwa ku tangimiyaiya",
                    "textAb": "kwani bauwa ka kadilrunga mikakwakuwa ku tangimiyaiya?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66252/924481",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "yakayinu ku sali",
                    "textAb": "yakayinu ku sali?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66253/924489",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "waceelesu idra sabiki",
                    "textAb": "waceelesu idra sabiki?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66254/924497",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "yainu ku kake ka sauwalai",
                    "textAb": "yainu ku kake ka sauwalai?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66255/924505",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "manema?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66250/924468"
                },
                "1": {
                    "text": "ahakaiyaku ku makalrilau cwabu.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66252/924482"
                },
                "2": {
                    "text": "miyalri kadruwa ka wathingale.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66253/924490"
                },
                "3": {
                    "text": "kadruwa ikai.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66254/924498"
                },
                "4": {
                    "text": "kadruwa ka waceele, amuwainu?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66255/924506"
                }
            },
            "target-2": {
                "0": {
                    "text": "kadruwa ka pwalringau.",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66250/924469"
                },
                "1": {
                    "text": "ku ina ahakai ku diheheele ka makalrilau cwabu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66252/924483"
                },
                "2": {
                    "text": "luilregelrege yakai.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66253/924491"
                },
                "3": {
                    "text": "yakai, yabelenge ki alruunu.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66254/924499"
                },
                "4": {
                    "text": "kaiyana mwataluvaivai?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66255/924507"
                }
            },
            "target-3": {
                "0": {
                    "text": "kadruwa ka wathingale.",
                    "textCh": "不知道！",
                    "sound": "text/sound/66250/924470"
                },
                "1": {
                    "text": "mahimuhaku",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66252/924484"
                },
                "2": {
                    "text": "yakai ku tedraneli, nau baai musuwa!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66253/924492"
                },
                "3": {
                    "text": "kwani cepenge yakai.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66254/924500"
                },
                "4": {
                    "text": "maulrau? mwa silape!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66255/924508"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
                    "tips": "去問問看陶壺的特徵，找出新的陶壺吧！",
