{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "Bubu, hbaraw bay tndadal ka wisu miyah tuhuy sapah diyax saya hay!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66167/923826",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Pnstrngan qbsuran snaw ka diyax saya, so kiya niqan hbaraw bay sediq ka miyah.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66167/923827",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Qrasun balay wah! Bsiyaq bay ini tqita dhiya da!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66167/923828",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Kiya hmi! Mosa ta mtbiyax bay kana ka diyax saya, dayaw ka isu ha.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66167/923829",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Iyaq, qulung ku mpdayaw!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66167/923830",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Hayi ku psramal qqiya ddiyun kiya hari han.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66167/923831",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Yaku ka miyah dmayaw!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66167/923832",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Malu wah, snul knan ka isu!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66167/923833",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "mnmnu qtan ka burah kayu",
                    "textAb": "Mnmnu qtan ka burah kayu?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66168/923836",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "inu ka niqan bsiyaw",
                    "textAb": "Inu ka niqan bsiyaw?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66169/923844",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "qmnita su binro hu",
                    "textAb": "Qmnita su binro hu?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66170/923852",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "weynu ka qbsuran snaw",
                    "textAb": "Weynu ka qbsuran snaw?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66171/923860",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "Manu",
                    "textCh": "什麼？",
                    "sound": "text/sound/66166/923823"
                },
                "1": {
                    "text": "Wada mu lbuwan waliq.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66168/923837"
                },
                "2": {
                    "text": "Ini ku kla uri.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66169/923845"
                },
                "3": {
                    "text": "Uka ka yaku hini.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66170/923853"
                },
                "4": {
                    "text": "Ini qtayi, wada inu ka hiya da?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66171/923861"
                }
            },
            "target-2": {
                "0": {
                    "text": "Ini klayi mbahang?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66166/923824"
                },
                "1": {
                    "text": "Dmuwi mbanah waliq lmabu ka bubu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66168/923838"
                },
                "2": {
                    "text": "Dwiyaq ka niqan.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66169/923846"
                },
                "3": {
                    "text": "Niqan, wa mniq babaw wakac.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66170/923854"
                },
                "4": {
                    "text": "Ini awah nganguc ka hiya nina pa?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66171/923862"
                }
            },
            "target-3": {
                "0": {
                    "text": "Ini klayi!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66166/923825"
                },
                "1": {
                    "text": "Ini mu klayi.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66168/923839"
                },
                "2": {
                    "text": "Niqan msngari ka naku, biqi misu!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66169/923847"
                },
                "3": {
                    "text": "Niqan ka cka rawa way.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66170/923855"
                },
                "4": {
                    "text": "Ini qtayi dhu? Hayi ming nhari!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66171/923863"
                }
            },
            "stage": [
                {
