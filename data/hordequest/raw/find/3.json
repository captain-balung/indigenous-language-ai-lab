{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "Ina, ’aloman ko malinaay a tayni i loma’ anini.",
                "textCh": "媽媽，今天家裡來了好多親戚哦！",
                "sound": "text/sound/66101/923320",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "O pataloma’an no kaka anini, hanaw ’aloman ko tamdaw a tayni.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66101/923321",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "O kahemekan a romi’ad ! halafin ito caay kasaso’araw i cangraan!",
                "textCh": "好開心的日子喔！很久沒有看到他們了！",
                "sound": "text/sound/66101/923322",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Hai ! awaay ko limaw no polong anini, padangen to iso ko ’alomanay.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66101/923323",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Hayda, mafana’ to kako!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66101/923324",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "O mamihalaka ho kako to maamaan a dademaken.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66101/923325",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "padangen ako!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66101/923326",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Hayda, ati tooren kako!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66101/923327",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "masamaan ko falohayay a ’atomo",
                    "textAb": "Masamaan ko falohayay a ’atomo?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66102/923330",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "ira icowa ko lengac",
                    "textAb": "Ira icowa ko lengac?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66103/923338",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "ira ma’araw iso ko ’icep",
                    "textAb": "Ira ma’araw iso ko ’icep?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66104/923346",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "icowa ci kaka",
                    "textAb": "Icowa ci kaka?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66105/923354",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "O maan?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66100/923317"
                },
                "1": {
                    "text": "O kili ko satafo ako.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66102/923331"
                },
                "2": {
                    "text": "Mafokil kako.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66103/923339"
                },
                "3": {
                    "text": "Awa ini kakonan.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66104/923347"
                },
                "4": {
                    "text": "Awa a ma’araw, talacowaay cingra hani?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66105/923355"
                }
            },
            "target-2": {
                "0": {
                    "text": "Mafokil kako a mitengil?",
                    "textCh": "我聽不懂？",
                    "sound": "text/sound/66100/923318"
                },
                "1": {
                    "text": "O kahengangay a kili ko satafo ni ina.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66102/923332"
                },
                "2": {
                    "text": "I lotok aca ira.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66103/923340"
                },
                "3": {
                    "text": "Iraay, ira i fafaed no ’anengan.",
                    "textCh": "有的，在椅子上。",
                    "sound": "text/sound/66104/923348"
                },
                "4": {
                    "text": "Caay ho kasadak cingra?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66105/923356"
                }
            },
            "target-3": {
                "0": {
                    "text": "hakeno!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66100/923319"
                },
                "1": {
                    "text": "Caay to kaharateng ako.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66102/923333"
                },
                "2": {
                    "text": "Cirafasay kako, na miso!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66103/923341"
                },
                "3": {
                    "text": "Ira laloma’ nora kanas.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66104/923349"
                },
                "4": {
                    "text": "Ano lahedaw sa ? harakaten mikilim ho cingra!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66105/923357"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
                    "tips": "去問問看陶壺的特徵，找出新的陶壺吧！",
                    "words": [
