{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "mo ina aro o zipozipos ta a nimai do vahay ta sicyaraw!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66329/925071",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "pamarngan so kanen do pisinmoan ni kaka sicyaraw ya, ori na karo no tao nimai ya.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66329/925072",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ya masaray eya! ta ya nimownay rana a ji nimakacita jira!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66329/925073",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "nonan! tamo mavazay sicyaraw ya, sidongen mo pa sira.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66329/925074",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "noon, ji ko sidonga sira!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66329/925075",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "mangay ko pa pikakasaen ori ya ta sitoai am jingyan so ahapen ko sya.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66329/925076",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "mai ko a sidongen!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66329/925077",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "noon, jiana a macihnot ka jiaken!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66329/925078",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "vayo a tatanaro am makoa so anjin",
                    "textAb": "vayo a tatanaro am makoa so anjin?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66330/925081",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "anjin na yanan no azngas",
                    "textAb": "anjin na yanan no azngas?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66331/925089",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "mo nimasta o mamahen an",
                    "textAb": "mo nimasta o mamahen an?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66332/925098",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "anjin na yanan ni kaka mo a mehakay",
                    "textAb": "anjin na yanan ni kaka mo a mehakay?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66333/925106",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "ikongo?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66328/925068"
                },
                "1": {
                    "text": "nibonbonan ko no milakayob.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66330/925082"
                },
                "2": {
                    "text": "ta ko katenengan an.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66331/925090"
                },
                "3": {
                    "text": "abo jyaken do jia.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66332/925099"
                },
                "4": {
                    "text": "ta ko nimasta, do anjin na nyangayan?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66333/925107"
                }
            },
            "target-2": {
                "0": {
                    "text": "ji toposi?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66328/925069"
                },
                "1": {
                    "text": "nibonbonan na ni ina so mabazangbang a milakayob.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66330/925083"
                },
                "2": {
                    "text": "do takey nangyanan.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66331/925091"
                },
                "3": {
                    "text": "nginyan, do lilisnan.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66332/925100"
                },
                "4": {
                    "text": "ya pa jya nimakowbot iya?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66333/925108"
                }
            },
            "target-3": {
                "0": {
                    "text": "ta ko katengan!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66328/925070"
                },
                "1": {
                    "text": "ko ji a nakem.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66330/925084"
                },
                "2": {
                    "text": "yaro o pa jiyaken, itoro ko jimo!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66331/925092"
                },
                "3": {
                    "text": "miyan do yala ito.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66332/925101"
                },
                "4": {
                    "text": "abo rana? keyan angay ikala pa!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66333/925109"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
