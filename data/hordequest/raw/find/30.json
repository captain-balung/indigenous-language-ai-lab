{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "niyaw sesane ka madraw na talimitiya na ’awkai!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66257/924517",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "sesane ki kaka mosowa ka sapalangane, nikwani ikadraw na cowao na ’awkai.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66257/924518",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "mabeabe kimade! tyathangea’anga na va’iyane icengelenga kimade kokodrai!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66257/924519",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "esi, sesane ka nokaykoco mikita, pasopaa mikoso mitiya.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66257/924520",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "e’e, nowa miokake!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66257/924521",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kowala swaobo pa’ikayngaa ko ma’akakowanga nosyakayanita.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66257/924522",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ko pasopa!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66257/924523",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "e’e, ’angopapai nakowa!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66257/924524",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "ko baowane dilrongo ka amiyaini ko ta’acwanidra",
                    "textAb": "ko baowane dilrongo ka amiyaini ko ta’acwanidra?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66258/924527",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "na sali ka ’iyakayni nino",
                    "textAb": "na sali ka ’iyakayni nino?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66259/924535",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "wacengele nyaso  na thaviki",
                    "textAb": "wacengele nyaso  na thaviki?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66260/924543",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "’iyakayni ki kaka",
                    "textAb": "’iyakayni ki kaka?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66261/924551",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "manini",
                    "textCh": "什麼？",
                    "sound": "text/sound/66256/924514"
                },
                "1": {
                    "text": "syakai kake na memane cwabo.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66258/924528"
                },
                "2": {
                    "text": "iigo’o kake.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66259/924536"
                },
                "3": {
                    "text": "nakowa nakay ka kadrowa.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66260/924544"
                },
                "4": {
                    "text": "icengele kake, amowaydra?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66261/924552"
                }
            },
            "target-2": {
                "0": {
                    "text": "bicingili ka iigo’o kake?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66256/924515"
                },
                "1": {
                    "text": "ki titina ka syakaya na madileange na memane ccwabo.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66258/924529"
                },
                "2": {
                    "text": "’iyakay egege.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66259/924537"
                },
                "3": {
                    "text": "’iyakay, ’iyakay cekei agae.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66260/924545"
                },
                "4": {
                    "text": "i’abowalela nyani?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66261/924553"
                }
            },
            "target-3": {
                "0": {
                    "text": "iigo’o!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66256/924516"
                },
                "1": {
                    "text": "maymo kake.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66258/924530"
                },
                "2": {
                    "text": "madrao nakowa, okay!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66259/924538"
                },
                "3": {
                    "text": "nadroway  kalawdo ’adringi ka ’iyakay.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66260/924546"
                },
                "4": {
                    "text": "mamolisi nyani? mwa ibongo silape!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66261/924554"
                }
            },
