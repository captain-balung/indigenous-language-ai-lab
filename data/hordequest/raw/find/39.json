{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "ina, harem kana wari kazuwan nanta wadadiyan na zuwa i ruma’ yi!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66311/924932",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "harem kana wari maw natu pakaetiman ni valri na ma’inay, zi kazuwan na trau na zuwa.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66311/924933",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "wa ta kana semangal! sawariyan ta lra ’azi mena’u kanazu!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66311/924934",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ai wa! harem kana wari mu kavangangavang ta papiya, pulraalrang u yi.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66311/924935",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ai, uri pulraalrang ku!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66311/924936",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kay ku paduluwa kanata kakudakudain nu haremay!",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66311/924937",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "pulralranga ku!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66311/924938",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "anlra, kurelrangay ku!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66311/924939",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "izu na vekal na ’inasi na kapuwa kemudakuda tu inudawayan",
                    "textAb": "izu na vekal na ’inasi na kapuwa kemudakuda tu inudawayan?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66312/924942",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "ulra i iyan a lriyapuy",
                    "textAb": "ulra i iyan a lriyapuy?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66313/924950",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "mena’u u za puran",
                    "textAb": "mena’u u za puran?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66314/924958",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "ulra i iyan i iva na ma’inay",
                    "textAb": "ulra i iyan i iva na ma’inay?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66315/924966",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "eman?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66310/924929"
                },
                "1": {
                    "text": "ku travuwaw kana kilē.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66312/924943"
                },
                "2": {
                    "text": "’azi ku mazalram.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66313/924951"
                },
                "3": {
                    "text": "uniyan kania.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66314/924959"
                },
                "4": {
                    "text": "’azi ku mena’u, mukuwa i iyan intaw?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66315/924967"
                }
            },
            "target-2": {
                "0": {
                    "text": "ma’ulid kinger?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66310/924930"
                },
                "1": {
                    "text": "i ina tu travuwaw kana zangzarang na kilē.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66312/924944"
                },
                "2": {
                    "text": "i zenan mu ulra.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66313/924952"
                },
                "3": {
                    "text": "ulra, ulra itras kana lipad.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66314/924960"
                },
                "4": {
                    "text": "’azi ziya mupatraran intaw?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66315/924968"
                }
            },
            "target-3": {
                "0": {
                    "text": "’azi mazalram!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66310/924931"
                },
                "1": {
                    "text": "malalup ku lra.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66312/924945"
                },
                "2": {
                    "text": "ulra ku sama’ zi, kuwa verayanay kaninu.",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66313/924953"
                },
                "3": {
                    "text": "kanizu na ’ara i savak ulra.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66314/924961"
                },
                "4": {
                    "text": "’azi u mena’u kanintaw? pakunamun uwa aya’u intaw!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66315/924969"
                }
            },
