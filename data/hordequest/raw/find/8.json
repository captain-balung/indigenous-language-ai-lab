{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "aya’, habaag a rumaruma’ ka muwah imug yo!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66131/923550",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "papasiqun kisa’ i yulah, kahi’ habaag a itaal ka muwah.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66131/923551",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ingasug cubalay ini’ tali nha’ la, maqas cubalay a kisleq!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66131/923552",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "cubalay! papqaqawh cubalay kahabaag i kisa’, raag uwi isu’ kiy!",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66131/923553",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "uwal, parag ci cubalay!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66131/923554",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "mausa’ ci cumamcum cu qaraqarax ka paptawwaw i kisa’ la.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66131/923555",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ragay mi su’!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66131/923556",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "uwal, glu kuwing!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66131/923557",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "humicuwa’ a kincungusan nku tawxu’ ka giqas",
                    "textAb": "humicuwa’ a kincungusan nku tawxu’ ka giqas?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66132/923560",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "aynu’ a kiya a basiyaw",
                    "textAb": "aynu’ a kiya a basiyaw?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66133/923568",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "kintalan su’ ku pinnang qu",
                    "textAb": "kintalan su’ ku pinnang qu?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66134/923576",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "kiya inu’ i yulah",
                    "textAb": "kiya inu’ i yulah?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66135/923584",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "nanuwan?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66130/923547"
                },
                "1": {
                    "text": "cabuun mu na lalabah.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66132/923561"
                },
                "2": {
                    "text": "ini’ mu baqi uwi.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66133/923569"
                },
                "3": {
                    "text": "ukas ikuwing runi.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66134/923577"
                },
                "4": {
                    "text": "ini’ tali, aruwa inu’ la?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66135/923585"
                }
            },
            "target-2": {
                "0": {
                    "text": "ini’ baqi muung?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66130/923548"
                },
                "1": {
                    "text": "cabuun na lalabah na matanah ni yaya’.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66132/923562"
                },
                "2": {
                    "text": "asiki ragiyax a kiya.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66133/923570"
                },
                "3": {
                    "text": "kiya, kiya i babaw na tathunakan.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66134/923578"
                },
                "4": {
                    "text": "ini’ uwah na’ pisa?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66135/923586"
                }
            },
            "target-3": {
                "0": {
                    "text": "ini’ baqi! (baqaw ta’!)",
                    "textCh": "不知道！",
                    "sound": "text/sound/66130/923549"
                },
                "1": {
                    "text": "ungian mu. (ungian mu la!)",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66132/923563"
                },
                "2": {
                    "text": "kiya a minsiqaang mu, biqanay mi isu’!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66133/923571"
                },
                "3": {
                    "text": "kiya cku wawa’ ka haca.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66134/923579"
                },
                "4": {
                    "text": "ukas(magaang) la pisa? nabuwibuwi usa’ kumiyum i hiya’!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66135/923587"
                }
            },
