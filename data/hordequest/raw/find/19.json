{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "tina madia haip tes’an tantungu!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66191/924010",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "pasiza’ ’a toqas haip, pangqa madia bunun tantungu.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66191/924011",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "manaskal la is’ang! talmadin ni tu pasadu naitun!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66191/924012",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "u! na’isungasi haip, asa asu tu midangaz.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66191/924013",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "u, namidangaz cak!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66191/924014",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "palhanuc cak na’ikma’e’un unisin tu amin’amin.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66191/924015",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "kadangaz cak!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66191/924016",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "u, lavi’a zaku!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66191/924017",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
