                    "textCh": "什麼？",
                    "sound": "text/sound/66184/923961"
                },
                "1": {
                    "text": "Kuci’aun zaku qaihav mabutiqu.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66186/923975"
                },
                "2": {
                    "text": "Nii’ak amin malulu.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66187/923983"
                },
                "3": {
                    "text": "Uka’ ha’an zaku’an dii.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66188/923991"
                },
                "4": {
                    "text": "Nii’ak saduu, makaica kac kana’?",
                    "textCh": "我沒看到，他去哪了？",
                    "sound": "text/sound/66189/923999"
                }
            },
            "target-2": {
                "0": {
                    "text": "Niit sama’azun tan’a?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66184/923962"
                },
                "1": {
                    "text": "Kuci’aun tina madangqac a qaihav mabutiqu.",
                    "textCh": "媽媽有用紅包起來。",
                    "sound": "text/sound/66186/923976"
                },
                "2": {
                    "text": "Iha’an ludun ca na maiza.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66187/923984"
                },
                "3": {
                    "text": "Maiza, iha’an daza’ is pangka’lungquan a’.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66188/923992"
                },
                "4": {
                    "text": "Uka’ang a cia?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66189/924000"
                }
            },
            "target-3": {
                "0": {
                    "text": "niapang!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66184/923963"
                },
                "1": {
                    "text": "Nii’ak malamantuk.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66186/923977"
                },
                "2": {
                    "text": "Madia’ang naak tukuc, na iscaiv su’un!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66187/923985"
                },
                "3": {
                    "text": "Maiza ha’an kalala’ aiza ka’.",
