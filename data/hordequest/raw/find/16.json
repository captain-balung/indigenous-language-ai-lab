{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "Bubu ketu kneegu dadal meyah sapah ta ka saya.",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66173/923872",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Ali msterung na qbsuran rseno ka saya, kika niqal egu ba seediq meeyah.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66173/923873",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Mqaras ba wa! bsiyaq ba ini qtai dheya di!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66173/923874",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kii ma! maha ini gdema kana seediq ka saya, sai dmayo kana seediq",
                "textCh": "對啊！今天大家都會很忙，你幫忙大家。",
                "sound": "text/sound/66173/923875",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Un, asi ku kela",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66173/923876",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Kiya hari maha ku pnsraman qyqeya nngalan ka yaku",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66173/923877",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Meyah ku dmayo!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66173/923878",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Malu ma, smnegul yaku ka isu!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66173/923879",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "huwa mesa hnyegan na ka liwas bgurah",
                    "textAb": "Huwa mesa hnyegan na ka liwas bgurah?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66174/923882",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "inu niqal bsiyo",
                    "textAb": "Inu niqal bsiyo?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66175/923890",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "niqal qntaun su ka bingdo",
                    "textAb": "Niqal qntaun su ka bingdo?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66176/923898",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "gaga inu ka qbsuran rseno",
                    "textAb": "Gaga inu ka qbsuran rseno?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66177/923906",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "Maanu?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66172/923869"
                },
                "1": {
                    "text": "Ngalun mu pala lmabu.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66174/923883"
                },
                "2": {
                    "text": "Ini ku kela duri.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66175/923891"
                },
                "3": {
                    "text": "Uka ka hini mu.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66176/923899"
                },
                "4": {
                    "text": "Ini qtai, wada inu ka heya di?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66177/923907"
                }
            },
            "target-2": {
                "0": {
                    "text": "Ini klai mbahang?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66172/923870"
                },
                "1": {
                    "text": "Mangal pala tanah lmabu ka bubu",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66174/923884"
                },
                "2": {
                    "text": "Lmiqu maha niqal.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66175/923892"
                },
                "3": {
                    "text": "Niqal, gaga gakac baro.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66176/923900"
                },
                "4": {
                    "text": "Ini eyah nganguc ka heya na?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66177/923908"
                }
            },
            "target-3": {
                "0": {
                    "text": "Ini klai.",
                    "textCh": "不知道！",
                    "sound": "text/sound/66172/923871"
                },
                "1": {
                    "text": "Ini mu klai!",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66174/923885"
                },
                "2": {
                    "text": "Egu naku, biqun su mu.",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66175/923893"
                },
                "3": {
                    "text": "Niqal rawa truma gaga.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66176/923901"
                },
                "4": {
                    "text": "Ini qtai? osa nhari skadi heya.",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66177/923909"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
                    "tips": "去問問看陶壺的特徵，找出新的陶壺吧！",
