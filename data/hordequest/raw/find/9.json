{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "payux ka raral nel moṟow ni yaya’ soni’.",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66137/923596",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kekon ka asuran malikur soni’, kani ka payux ciuli’ moh sani’.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66137/923597",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ma’as carung ka kisili’, buse’ ini taxi ka laha haca la.",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66137/923598",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ho! ini pangu’ kora’ ka ci’uli, ak rumo’ su lahan.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66137/923599",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ho! pabing cu carung.",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66137/923600",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "maha’ cu runbi’ ci babingun kira’ hari la!",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66137/923601",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "moh cu rumo’ kung!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66137/923602",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ho! awah pagalu’ kingang!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66137/923603",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "yona amol taxan ka tabaka haca",
                    "textAb": "yona amol taxan ka tabaka haca?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66138/923606",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "inu’ ka kelan basikal hiya",
                    "textAb": "inu’ ka kelan basikal hiya?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66139/923614",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "wal su taxan ka sabiki’ aw",
                    "textAb": "wal su taxan ka sabiki’ aw?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66140/923622",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "cel inu’ ka asuṟan malikur hiya",
                    "textAb": "cel inu’ ka asuṟan malikur hiya?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66141/923630",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "amol?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66136/923593"
                },
                "1": {
                    "text": "ol mu cabun ci gali’.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66138/923607"
                },
                "2": {
                    "text": "ini mu ba’iy uri.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66139/923615"
                },
                "3": {
                    "text": "ungat ka sani hiya!",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66140/923623"
                },
                "4": {
                    "text": "ini mu taxi, wal inu’ ka hiya la?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66141/923631"
                }
            },
            "target-2": {
                "0": {
                    "text": "ini mu baiy mung?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66136/923594"
                },
                "1": {
                    "text": "ol ni cabun ci matanah agali’ ni yaya’.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66138/923608"
                },
                "2": {
                    "text": "nanak nanahi’ ka kelan.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66139/923616"
                },
                "3": {
                    "text": "ho! cel ci rakat tataman.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66140/923624"
                },
                "4": {
                    "text": "ini patata’ na aw?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66141/923632"
                }
            },
            "target-3": {
                "0": {
                    "text": "ini cu kaba’?",
                    "textCh": "不知道！",
                    "sound": "text/sound/66136/923595"
                },
                "1": {
                    "text": "ini mu puse tunux.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66138/923609"
                },
                "2": {
                    "text": "mataxal ka kingang, be’en misu tikiy.",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66139/923617"
                },
                "3": {
                    "text": "kelan ka rarawa’ haca hiya.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66140/923625"
                },
                "4": {
                    "text": "wal maguru’ ka hiya la ong? hata’ nahaṟi’ manahang hiyan hang!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66141/923633"
                }
            },
            "stage": [
                {
