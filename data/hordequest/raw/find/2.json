{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "Ina ’aloman ko maninaay tayni i loma’ anini romiad yo!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/71667/998350",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "O pipataloma’an ni kaka anini romi’ad, sanaw ’aloman ko tayniay a tamdaw.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/71667/998351",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Malipahak ko faloco’! halafin to caay ka’araw i cangraan!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/71667/998352",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Hi:a! milosid ko maninaay anini romiad, pipadang ko miso.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/71667/998353",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Ha:i, cakaeca mipadang kako!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/71667/998354",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Malalosid to kako to sakatayal no honi.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/71667/998355",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "Tayni kako mipadang!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/71667/998356",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "Hai, kotoden kako!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/71667/998357",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "masamaan ko laleko no ’atomo",
                    "textAb": "Masamaan ko laleko no ’atomo.",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/71667/998358",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "ira icowa ko lengac",
                    "textAb": "Ira icowa ko lengac?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/71667/998360",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "ira ma’araw iso ko ’icep haw",
                    "textAb": "Ira ma’araw iso ko ’icep haw?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/71667/998362",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "icowa ci kaka",
                    "textAb": "Icowa ci kaka?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/71667/998365",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "maan?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66094/923271"
                },
                "1": {
                    "text": "Ira matafo ako to kamid.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/71667/998359"
                },
                "2": {
                    "text": "Mafokil kako ari",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/71667/998361"
                },
                "3": {
                    "text": "Awa ko mako i tini",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66098/923301"
                },
                "4": {
                    "text": "Awa ma’araw talacowaay cingra?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/71667/998366"
                }
            },
            "target-2": {
                "0": {
                    "text": "Mafokil mitengil?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66094/923272"
                },
                "1": {
                    "text": "Ira matafo ni ina to kahengangay a kamid.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66096/923286"
                },
                "2": {
                    "text": "I lotok itiya ira.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66097/923294"
                },
                "3": {
                    "text": "Ira i tongroh no ’.anengang",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/71667/998363"
                },
                "4": {
                    "text": "Caayho ka sadak cingra saw?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/71667/998367"
                }
            },
            "target-3": {
                "0": {
                    "text": "Caay ka fana’! /Mafokilay!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66094/923273"
                },
                "1": {
                    "text": "Matawal to ako.",
                    "textCh": "我不記得。Matawal to ako.",
                    "sound": "text/sound/66096/923287"
                },
                "2": {
                    "text": "Ira ko ’osaw ako, pafelien ako kiso.",
                    "textCh": "我有多的，給你。",
                    "sound": "text/sound/66097/923295"
                },
                "3": {
                    "text": "Ira i laloma’ nora kanas.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/71667/998364"
                },
                "4": {
                    "text": "Awa ma’araw saw? karanikay mikilim cingraan!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66099/923311"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
