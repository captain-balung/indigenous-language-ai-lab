                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aw ga ! mosa mzyan balay yow ta ryax soni. pkraw mtiyow isu ki.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66119/923461",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "aw, pkraw saku!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66119/923462",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "hala saku smsun cikah qeqaya sckaw kira ha.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66119/923463",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "ragaw misu!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66119/923464",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aw, uwah mluw knan!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66119/923465",
