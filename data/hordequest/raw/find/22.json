                    "text": "makua a bahlu kaiu’a",
                    "textAb": "makua a bahlu kaiu’a",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66210/924159",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "isa a aizaan mas sizu i",
                    "textAb": "isa a aizaan mas sizu i?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66211/924167",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "adu usaduan mas saviki i",
