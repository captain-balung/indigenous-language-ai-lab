                "2": {
                    "text": "nii’ik amin haiap",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66211/924168"
                },
                "3": {
                    "text": "uka izakuancin",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66212/924176"
                },
                "4": {
                    "text": "nii’ik haiap, kau’isa a saia i?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66213/924184"
                }
