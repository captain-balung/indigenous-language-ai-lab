{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "cina, madia a tas’aan minsuma aip",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66209/924149",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "aip hai lus’an mas tuhasnanaz tu mapadangi, paha madia a bunun minsuma",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66209/924150",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "manaskal ai! malbuntuin nii tu sadu mas naicia",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66209/924151",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "ungkai! natalpatazun amin aip, asa’as tu mindangaz",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66209/924152",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "uung, namaupacia’ik",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66209/924153",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "nakaudiipik kasanus mas na’iskusia tu haimangsut",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66209/924154",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "namindangazik",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66209/924155",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "uung iahai! malaviaku a kasu",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66209/924156",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
