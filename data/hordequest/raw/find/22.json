            "target-2": {
                "0": {
                    "text": "nii tu ithaal",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66208/924147"
                },
                "1": {
                    "text": "maku’uni a cina mas madanghas tu kulali masubu",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66210/924161"
                },
                "2": {
                    "text": "kaaz ludun a aizaan",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66211/924169"
                },
                "3": {
                    "text": "aiza, idadaza palusu",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66212/924177"
                },
                "4": {
                    "text": "nii’angbin a saia mun’apav i?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66213/924185"
                }
            },
            "target-3": {
                "0": {
                    "text": "nii tu haiap",
                    "textCh": "不知道！",
                    "sound": "text/sound/66208/924148"
                },
                "1": {
                    "text": "nii’ik haiap",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66210/924162"
                },
                "2": {
                    "text": "aizaanik mas minnutda, paisuu!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66211/924170"
                },
                "3": {
                    "text": "aizaan a kalala’a",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66212/924178"
                },
                "4": {
                    "text": "is’ukabin i? kavavaa kilim",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66213/924186"
                }
            },
