                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66181/923936",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "qtaan su ka pinglang hug",
                    "textAb": "qtaan su ka pinglang hug?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66182/923944",
                    "code": "3",
