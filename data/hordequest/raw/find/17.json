                    "sound": "text/sound/66183/923952",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "manu?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66178/923915"
                },
                "1": {
                    "text": "lbuan mu galiq",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66180/923929"
                },
                "2": {
                    "text": "ini ku kla uri.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66181/923937"
                },
                "3": {
                    "text": "ungac ka yaku hini.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66182/923945"
                },
                "4": {
                    "text": "ini qtai, wada inu ka hiya da?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66183/923953"
                }
            },
            "target-2": {
                "0": {
                    "text": "ini klai qmbahan?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66178/923916"
                },
                "1": {
                    "text": "lbuan galiq bubu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66180/923930"
                },
                "2": {
                    "text": "niqan ka dgiyaq.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66181/923938"
                },
                "3": {
                    "text": "niqan, gaga babaw gakac.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66182/923946"
                },
                "4": {
                    "text": "ini iyah ka hiya na hug?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66183/923954"
                }
            },
            "target-3": {
                "0": {
                    "text": "ini klai?",
                    "textCh": "不知道！",
                    "sound": "text/sound/66178/923917"
                },
                "1": {
                    "text": "ini mu klai lnglung.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66180/923931"
                },
                "2": {
                    "text": "sngari ka naku, biqay misu!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66181/923939"
                },
                "3": {
                    "text": "niqan ka rawa gaga.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66182/923947"
                },
                "4": {
                    "text": "ini qtai da ? sai nhari miing ka hiya!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66183/923955"
                }
            },
            "stage": [
                {
