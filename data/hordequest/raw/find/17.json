{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "bubu tagay bi seejiq ka miyah sapah sayang hug!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66179/923918",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "gaya pstrung qbsuran snaw ka jiyax sayang, kika hbaraw seejiq ka miyah hini.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66179/923919",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "mqaras ku bi o ! bsiyaq bi ini qtai ka dhiya da!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66179/923920",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "kiya hmi ! uka bi jiyax kana ka sayang, dayaw kana ka isu uri.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66179/923921",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "iq ! qulung ku bi wa!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66179/923922",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "musa ku psraman jjiliun kykaya kiya hari han.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66179/923923",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "jiyagay misu!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66179/923924",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "iq wa ! sneegul yaku!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66179/923925",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "meenu ka bgurah kyusu",
                    "textAb": "meenu ka bgurah kyusu?",
                    "textCh": "新的陶壺長怎樣？",
