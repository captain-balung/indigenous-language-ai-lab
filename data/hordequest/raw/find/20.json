{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "haip qani’an tina lumaq madia minsuma tais’aan tu.",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66197/924056",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "haip qani’an isia tuqasnanaz tu lus’aan mapasiza, paqpun haiza madia bunun minsuma.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66197/924057",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "manaskal maa! talmadiin nii saduu intaa tu.",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66197/924058",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "tuza maa! haip qani’an amin na pansunutsunut, asa aas amin mindangaz.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66197/924059",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "azuq naip, maqansiapin aak!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66197/924060",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "na iumpi aak unisin ikma’aiun tu qaimangsut.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66197/924061",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "dangazak aas!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66197/924062",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "uu, kinuza aas zaku!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66197/924063",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "makuaq a baqlu tu kai’iu",
                    "textAb": "makuaq a baqlu tu kai’iu?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66198/924066",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "isaq haiza sizu’",
                    "textAb": "isaq haiza sizu’?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66199/924074",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "saduu aas saviki",
                    "textAb": "saduu aas saviki?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66200/924082",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "isaq masituqas’nanaz a",
                    "textAb": "isaq masituqas’nanaz a?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66201/924091",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "ma’aq",
                    "textCh": "什麼？",
                    "sound": "text/sound/66196/924053"
                },
                "1": {
                    "text": "makusia aak pusut mabutiqu.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66198/924067"
                },
                "2": {
                    "text": "nii aak amin niap.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66199/924075"
                },
                "3": {
                    "text": "uka ihaan zakuan ti.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66200/924083"
                },
                "4": {
                    "text": "nii aak saduu, mun’isaq aipa tu?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66201/924092"
                }
            },
            "target-2": {
                "0": {
                    "text": "nii itqaal?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66196/924054"
                },
                "1": {
                    "text": "makusia tina ka madangqas pusut mabutiqu.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66198/924068"
                },
                "2": {
                    "text": "iba’av tudiip haiza.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66199/924076"
                },
                "3": {
                    "text": "haiza, ihaan pangka daza.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66200/924084"
                },
                "4": {
                    "text": "nii’ang aipa munhapav?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66201/924093"
                }
            },
            "target-3": {
                "0": {
                    "text": "nii niap!",
                    "textCh": "不知道！",
                    "sound": "text/sound/66196/924055"
                },
                "1": {
                    "text": "panpungulin aak.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66198/924069"
                },
                "2": {
                    "text": "haiza naak kanutda, hii’",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66199/924077"
                },
                "3": {
                    "text": "haiza ihaan kalala’ tun.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66200/924085"
                },
                "4": {
                    "text": "munghavin? kava’ah kilim istaa!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66201/924094"
                }
            },
            "stage": [
                {
