{
    "theme": "尋找物品",
    "data": {
        "phase1": [
            {
                "text": "今天家裡要辦婚禮，很多親戚都來了。<br>看到大家忙得不可開交，主角決定要幫大家一起準備。"
            },
            {
                "text": "ina,marutjuruvu a namangtjez a kasusu tasauni lja!",
                "textCh": "媽媽今天家裡來了好多親戚哦！",
                "sound": "text/sound/66233/924333",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "sipuvaljavan a qadaw ni kaka tjavulung a uqaljay kasauni，avan nu sikatjuruvu ana mangtjez a caucau.",
                "textCh": "今天是哥哥的婚禮，所以有很多人來。",
                "sound": "text/sound/66233/924334",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "maru maleva en lja! cuacuay anga u linengljengan tjayamadju dri!",
                "textCh": "好開心喔！很久沒有看到他們了！",
                "sound": "text/sound/66233/924335",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "uilja! uri liyaw atja sengsengan nusauni, qeljingu anga mapuljat tua kakemudain.",
                "textCh": "對啊！今天大家都會很忙，你要幫忙大家。",
                "sound": "text/sound/66233/924336",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "nanguaq, tjaraen a pusaladj!",
                "textCh": "好的，我一定會！",
                "sound": "text/sound/66233/924337",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "uri vaik anga en a padjulu tua sikarakuda nemangamanga.",
                "textCh": "我要去準備等一下要用的東西了。",
                "sound": "text/sound/66233/924338",
                "image": "mom.png",
                "background": "1-2.png"
            },
            {
                "text": "pay, u pusaladjay!",
                "textCh": "我來幫忙！",
                "sound": "text/sound/66233/924339",
                "image": "girl.png",
                "background": "1-1.png"
            },
            {
                "text": "nanguaq, idu kitjavililji aen!",
                "textCh": "好，你跟我來！",
                "sound": "text/sound/66233/924340",
                "image": "mom.png",
                "background": "1-2.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "na makuda vaquan a djilung",
                    "textAb": "na makuda vaquan a djilung?",
                    "textCh": "新的陶壺長怎樣？",
                    "sound": "text/sound/66234/924343",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "inuan a izua ngat",
                    "textAb": "inuan a izua ngat?",
                    "textCh": "哪裡有月桃？",
                    "sound": "text/sound/66235/924351",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "na pacunsun tua saviki",
                    "textAb": "na pacunsun tua saviki?",
                    "textCh": "你有看到檳榔嗎？",
                    "sound": "text/sound/66236/924359",
                    "code": "3",
                    "score": 100
                },
                {
                    "text": "inuan ti kaka tjavulung a uqaljay",
                    "textAb": "inuan ti kaka tjavulung a uqaljay?",
                    "textCh": "哥哥在哪裡？",
                    "sound": "text/sound/66237/924367",
                    "code": "4",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "anema",
                    "textCh": "什麼？",
                    "sound": "text/sound/66232/924330"
                },
                "1": {
                    "text": "u cinavu tua kaliljaw.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66234/924344"
                },
                "2": {
                    "text": "inikaen a kemeljang uta.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66235/924352"
                },
                "3": {
                    "text": "neka i tjanuaen.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66236/924360"
                },
                "4": {
                    "text": "inika na pacun aen, na semainu?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66237/924368"
                }
            },
            "target-2": {
                "0": {
                    "text": "inika saigu a kilangda?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/66232/924331"
                },
                "1": {
                    "text": "cinavu tua qudjidjilj a kaliljaw ni ina.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66234/924345"
                },
                "2": {
                    "text": "i gadu ki izua.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66235/924353"
                },
                "3": {
                    "text": "izua, i vavaw tua sangel.",
                    "textCh": "有，在椅子上。",
                    "sound": "text/sound/66236/924361"
                },
                "4": {
                    "text": "inika na sasaw anan?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66237/924369"
                }
            },
            "target-3": {
                "0": {
                    "text": "qadjaw",
                    "textCh": "不知道！",
                    "sound": "text/sound/66232/924332"
                },
                "1": {
                    "text": "inika en a paqenetj.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66234/924346"
                },
                "2": {
                    "text": "izua niyaen a liyaw, u pavaysun!",
                    "textCh": "我有多的，給你！",
                    "sound": "text/sound/66235/924354"
                },
                "3": {
                    "text": "izua i tazua cepeng.",
                    "textCh": "那個籃子裡有。",
                    "sound": "text/sound/66236/924362"
                },
                "4": {
                    "text": "manu maulaw anga? vaiku a karim a kirimu!",
                    "textCh": "不見了嗎？快去找他！",
                    "sound": "text/sound/66237/924370"
                }
            },
            "stage": [
                {
                    "quest": "媽媽把陶壺搞混了，請你幫忙找出新訂做的陶壺。",
                    "tips": "去問問看陶壺的特徵，找出新的陶壺吧！",
