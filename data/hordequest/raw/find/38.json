            },
            "target-3": {
                "0": {
                    "text": "maulid ku.",
                    "textCh": "不知道！",
                    "sound": "text/sound/66304/924885"
                },
                "1": {
                    "text": "abalu ku lla.",
                    "textCh": "我不記得。",
                    "sound": "text/sound/66306/924899"
                },
                "2": {
                    "text": "sadru ku rengas. ti berayay yu!",
                    "textCh": "我有多的月桃，給你！",
