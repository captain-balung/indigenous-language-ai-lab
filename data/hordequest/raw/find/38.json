                    "text": "a manay?",
                    "textCh": "什麼？",
                    "sound": "text/sound/66304/924883"
                },
                "1": {
                    "text": "ku liputraw dra binekeran.",
                    "textCh": "我有用布包起來。",
                    "sound": "text/sound/66306/924897"
                },
                "2": {
                    "text": "maulid ku.",
                    "textCh": "我也不知道。",
                    "sound": "text/sound/66307/924905"
                },
                "3": {
                    "text": "uniyan kanku kadri.",
                    "textCh": "我這邊沒有。",
                    "sound": "text/sound/66308/924913"
                },
                "4": {
                    "text": "adri ku menau. muka isuwa lla?",
                    "textCh": "沒看到，他去哪了？",
                    "sound": "text/sound/66309/924921"
