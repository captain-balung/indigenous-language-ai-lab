            },
            "target-2": {
                "0": {
                    "text": "maulid ku killengaw.",
                    "textCh": "我聽不懂。",
                    "sound": "text/sound/66304/924884"
                },
                "1": {
                    "text": "tu liputraw lla dra sauiw kan ina.",
                    "textCh": "媽媽有用紅布包起來。",
                    "sound": "text/sound/66306/924898"
                },
                "2": {
                    "text": "ullaya i drenan.",
                    "textCh": "山上才有。",
                    "sound": "text/sound/66307/924906"
                },
                "3": {
                    "text": "menau ku. ullaya kana katengadrawan.",
                    "textCh": "有(我有看到)，在椅子上。",
                    "sound": "text/sound/66308/924914"
                },
                "4": {
                    "text": "adri driya mupatraran?",
                    "textCh": "他還沒出來嗎？",
                    "sound": "text/sound/66309/924922"
