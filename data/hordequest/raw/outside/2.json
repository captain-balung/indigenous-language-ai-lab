                },
                "1": {
                    "text": "Mikilim kako to ’afel ato sapitapay to titi mi’id’id.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65590/917863"
                },
                "2": {
                    "text": "I:raw tora tata’angay fikeloh.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/71667/998370"
                },
                "3": {
                    "text": "nga’ayto alaen!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65593/917885"
                }
            },
            "target-2": {
                "0": {
                    "text": "Mafokil mitengil?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65588/917850"
                },
                "1": {
                    "text": "Mikilim kako to ’ariray ato konga.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/71667/998369"
                },
                "2": {
                    "text": "Mafokil kako ano icowaay kira talawadaw.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65592/917878"
                },
                "3": {
                    "text": "Awaay ko mako.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65593/917886"
