                    "textCh": "不知道！",
                    "sound": "text/sound/65588/917851"
                },
                "2": {
                    "text": "Itini, nai tiraay kako i talawadaw tahini.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65592/917879"
                },
                "3": {
                    "text": "Caay ka enga, tatiihayto ko po’ot ako.",
