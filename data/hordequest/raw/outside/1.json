                    "textAb": "U maan saw ku kiliman nu misu?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65581/917802",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "a pasacuwa saw ku sakatayra i sa’uwac",
                    "textAb": "A pasacuwa saw ku sakatayra i sa’uwac?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65583/917816",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "pacaliwi kaku tu puut kapah tu haw",
                    "textAb": "Pacaliwi kaku tu puut, kapah tu haw?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65584/917824",
                    "code": "3",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "Maan",
                    "textCh": "什麼？",
                    "sound": "text/sound/65572/917782"
                },
                "1": {
                    "text": "Mikilim kaku tu avel atu sapi’id’id tu titi a tatadaan.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65581/917803"
                },
                "2": {
                    "text": "Itila i tepar niya tataakay a vekeluh.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65583/917817"
                },
                "3": {
                    "text": "kapah tu! ala i!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65584/917825"
                }
            },
            "target-2": {
                "0": {
                    "text": "Mavukil haw a mitengil?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65572/917783"
                },
                "1": {
                    "text": "Mikilim kaku tu taviras atu vunga.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65581/917804"
                },
                "2": {
                    "text": "Caay kavana’ kaku icuwaan a lilis nu sa’uwac.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65583/917818"
                },
                "3": {
                    "text": "Awaay ku nu maku.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65584/917826"
                }
            },
            "target-3": {
                "0": {
                    "text": "Enu",
                    "textCh": "不知道！",
                    "sound": "text/sound/65572/917784"
                },
                "2": {
                    "text": "Itini, Namakayra kaku i lilis nu sa’uwac i nasani.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65583/917819"
                },
                "3": {
                    "text": "Aka, mapeci’ ku puut nu maku.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65584/917827"
                }
            },
