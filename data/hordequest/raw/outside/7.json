{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Yupas, sasan ga hngi’an rihay, musa su inu?",
                "textCh": "Yupas，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65624/918129",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "sami ki Pagung musa sku syaw gong smuling suyaw sa sasan, isu ga?",
                "textCh": "我明天要和Pagung去溪邊烤肉，你呢？",
                "sound": "text/sound/65624/918130",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "pungan ga blay balay gnogun rwa! hala kung mluw uzi aw?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65624/918131",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "isu gleng ma’ut yaya!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65624/918132",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "yaya, blay kung mgluw bsuyan tmalung musa syaw gong?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65624/918133",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "blay, sikila pinbaga ki simuw!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65624/918134",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "laxiy inkux, musa sami pinbaga.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65624/918135",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
