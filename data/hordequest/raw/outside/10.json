{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Watan, cyugan ga ryax hngawan, akya su musa inu?",
                "textCh": "Watan，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65654/918360",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "musa cu cmuling syam cqa gong ki Rimuy.",
                "textCh": "我明天要和Rimuy去溪邊烤肉，你呢？",
                "sound": "text/sound/65654/918361",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "pungan mu ga blaq calay csalan, ana cu msqun musa uyi ga?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65654/918362",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "hali tqbaq yaya su ha!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65654/918363",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "aya, ana cu squn musa gong ki qbsuyal mu mlikuy ga?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65654/918364",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "uya ga, ana ga ktali nanak cimu ay!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65654/918365",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "uya baqun myan la.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65654/918366",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "nanu cyan su hkngyan",
                    "textAb": "nanu cyan su hkngyan?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65657/918387",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "pkusa nanu musa qa gong qani",
                    "textAb": "pkusa nanu musa qa gong qani?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65658/918400",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "ana su ksyuxun buli kingan ga",
                    "textAb": "ana su ksyuxun buli kingan ga?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65660/918416",
                    "code": "3",
