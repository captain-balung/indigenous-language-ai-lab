                }
            ],
            "target-1": {
                "0": {
                    "text": "nanu",
                    "textCh": "什麼？",
                    "sound": "text/sound/65653/918357"
                },
                "1": {
                    "text": "nyan cu hkangi bagah ru ami pculing syam.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65657/918388"
                },
                "2": {
                    "text": "pkura thaca, cyan maki saying tyaba na btunux qaca",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65658/918401"
                },
                "3": {
                    "text": "uya ga, gali kya!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65660/918417"
                }
            },
            "target-2": {
                "0": {
                    "text": "ini qbaqi mung",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65653/918358"
                },
                "1": {
                    "text": "haqa cu hkangi qcyay ru ngahi.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65657/918389"
                },
                "2": {
                    "text": "ini mu qbaqi cyan inu qa gong qaca?",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65658/918402"
                },
                "3": {
                    "text": "uka kingan uyi.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65660/918418"
                }
            },
            "target-3": {
                "0": {
                    "text": "ini qbaqi",
                    "textCh": "不知道！",
                    "sound": "text/sound/65653/918359"
                },
                "2": {
                    "text": "pwah cqani musa, mica cu na minkahul kya.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65658/918403"
                },
                "3": {
                    "text": "ini misu qbaqi ksiyux, cyan mkutiyh buli mu la.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65660/918419"
                }
            },
