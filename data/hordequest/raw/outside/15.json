                    "textCh": "什麼？",
                    "sound": "text/sound/65688/918637"
                },
                "1": {
                    "text": "Musa ku ming bawah mi ami duhun siyang.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65693/918663"
                },
                "2": {
                    "text": "Hnali way, niqan beyhing tasil way.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65694/918676"
                },
                "3": {
                    "text": "Malu hmi, dsi!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65696/918694"
                }
            },
            "target-2": {
                "0": {
                    "text": "Ini klayi mbahang?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65688/918638"
                },
                "1": {
                    "text": "Musa ku ming lhngay mi bunga.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65693/918664"
                },
                "2": {
                    "text": "Ini ku kla wa mniq inu ka siyaw yayung.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65694/918677"
                },
                "3": {
                    "text": "Uka ka naku uri.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65696/918695"
                }
            },
            "target-3": {
                "0": {
                    "text": "Ini kla!",
                    "textCh": "不知道！",
                    "sound": "text/sound/65688/918639"
                },
                "2": {
                    "text": "Hini, hana ku kndadax siyaw yayung miyah.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65694/918678"
                },
                "3": {
                    "text": "Uxay, mnaqah ka yayu mu da.",
