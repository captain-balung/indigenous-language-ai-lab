{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Ukan, diyax sngayan ka kusun, ida su musa inu?",
                "textCh": "Ukan，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65691/918642",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Tuhuy ku Lubi musa siyaw yayung muduh siyang ka kusun, isu wa?",
                "textCh": "我明天要和 Lubi 去溪邊烤肉，你呢？",
                "sound": "text/sound/65691/918643",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Bhangun pa so bay malu balay plahan hay! Malu ku msupu musa ka yaku uri hu?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65691/918644",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Slingi ka bubu su han!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65691/918645",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Bubu, malu ku tuhuy qbsuran mu snaw msupu musa siyaw yayung hu?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65691/918646",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Malu, binaw tqlahang ka yamu ha!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65691/918647",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Iyaq, mosa nami tqlahang balay!",
                "textCh": "是的，我們會非常小心的！（沒問題，我們一定會的！）",
                "sound": "text/sound/65691/918648",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
