                    "text": "maaq suu kilimun tu",
                    "textAb": "maaq suu kilimun tu?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65607/917999",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "na maqaisaq manipa vanglaz",
                    "textAb": "na maqaisaq manipa vanglaz?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65610/918024",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "maqtu pasimul zaku dadaus",
                    "textAb": "maqtu pasimul zaku dadaus?",
                    "textCh": "可以借我刀子嗎？",
