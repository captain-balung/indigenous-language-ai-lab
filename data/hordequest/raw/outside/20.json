{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "hamul, laqbingin a islungquan qani’an, minliskin aas tu na mun’isaq?",
                "textCh": "hamul，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65602/917957",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "na dusa aak Savi munvanglaz mapaklang titi’, makuaq aas?",
                "textCh": "我明天要和Savi去溪邊烤肉，你呢？",
                "sound": "text/sound/65602/917958",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "tian’aun maupat masihal qaitmalun! maqtu aak muskun mun’ita?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65602/917959",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mungaus a aas masingav Tina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65602/917960",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Tina, maqtu aak makilavi tuqasnanaz muskun munvanglaz?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65602/917961",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "azuq naip, qaal asa amuu mananulu maa!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65602/917962",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Uu ki, na maupata aam!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65602/917963",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
