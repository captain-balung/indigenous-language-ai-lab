            "target-1": {
                "0": {
                    "text": "Maan?",
                    "textCh": "什麼？",
                    "sound": "text/sound/65595/917946"
                },
                "1": {
                    "text": "Milkilimay kako to atang ato satapay.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65604/917978"
                },
                "2": {
                    "text": "Iraw, pasitira tora ta’angayay a fakeloh.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65606/917992"
                },
                "3": {
                    "text": "Hayda, alaen!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65608/918013"
                }
            },
            "target-2": {
                "0": {
                    "text": "Ca kafana’?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65595/917947"
                },
                "1": {
                    "text": "Milkilimay kako to ariray ato konga.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65604/917979"
                },
                "2": {
                    "text": "Cowa kafana’ kako to icowaay ko ’alo.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65606/917993"
                },
                "3": {
                    "text": "Awaay haca ko no mako.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65608/918014"
                }
            },
            "target-3": {
                "0": {
                    "text": "Haiken!",
                    "textCh": "不知道！",
                    "sound": "text/sound/65595/917948"
                },
                "2": {
                    "text": "Itini, isawniay ho kako minokay nai’alo.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65606/917994"
                },
                "3": {
                    "text": "Ca kanga’ay, matatasay ko po’ot ako.",
