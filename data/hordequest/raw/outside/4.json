{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Alang, o paaliwacan to anocila, sakatalacowaaw kiso?",
                "textCh": "Alang，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65603/917967",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Tatala’alo kako aci Miding mi’id’id to titi, kiso i?",
                "textCh": "我明天要和Miding去溪邊烤肉，你呢？",
                "sound": "text/sound/65603/917968",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Hato nga’ayay salamaen a tengilaen! Manga’ay kako a mihakelong tayra haw?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65603/917969",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Licayen ho iso ko wina i ka’ayaw a!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65603/917970",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Ina, manga’ay kako a mihakelong si kakaan tala’alo haw?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65603/917971",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Hayda, nikaorira kapina’on to kamo yo!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65603/917972",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Hay mafana’ to, na’onen to niyam!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65603/917973",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
