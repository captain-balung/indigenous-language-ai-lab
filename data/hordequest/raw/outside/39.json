            },
            "target-3": {
                "0": {
                    "text": "’azi mazalram!",
                    "textCh": "不知道！",
                    "sound": "text/sound/65765/919258"
                },
                "2": {
                    "text": "i kania, maw ku ziya kemay valilruwan muruma’.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65769/919288"
                },
                "3": {
                    "text": "’azi, muranak lra ku tazaw.",
                    "textCh": "不行，我的刀子壞掉了。",
