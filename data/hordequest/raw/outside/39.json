                    "textCh": "什麼？",
                    "sound": "text/sound/65765/919256"
                },
                "1": {
                    "text": "kay ku melaka za ’aped zi kakerangan.",
                    "textCh": "我去拿木炭和烤肉網。",
                    "sound": "text/sound/65767/919270"
                },
                "2": {
                    "text": "kaziyua, ulra ma’izang a varasa’ i kazu.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65769/919286"
                },
                "3": {
                    "text": "halra, alaku.",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65771/919295"
                }
            },
            "target-2": {
                "0": {
                    "text": "ma’ulid kinger",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65765/919257"
                },
                "1": {
                    "text": "kay ku kikudumuwa zi kivurasiya.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65767/919271"
                },
                "2": {
                    "text": "’azi ku mazalram za ulra i iyan na valilruwan.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65769/919287"
                },
                "3": {
                    "text": "iniyan ku za kemazu.",
                    "textCh": "我也沒有。",
