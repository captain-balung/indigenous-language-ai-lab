{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "kalimazaw, kasede’an nu ’emanan zi, awa u i iyan?",
                "textCh": "kalimazaw，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65766/919259",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "nu ’emanan salralrangan ku kani Valrayvay awa mi i valilruwan kemeranga za ’alum, inu mu?",
                "textCh": "我明天要和Valrayvay去溪邊烤肉，你呢？",
                "sound": "text/sound/65766/919260",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "nu kinger ta mu ’inava kivangangavangan! karuwa ku salrangan mukuwa?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65766/919261",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "kiumalri ziya i ina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65766/919262",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "ina, karuwa ku salrangan kani valri mukuwa i valilruwan?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65766/919263",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "uwa kurelrang, maw mu kilrivak mu!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65766/919264",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "mazalram mi, kiyalrivak mi!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65766/919265",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "aaya’ u za eman",
                    "textAb": "aaya’ u za eman?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65767/919269",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "i valilruwan mu makalrang ta i iyan mukuwa",
                    "textAb": "i valilruwan mu makalrang ta i iyan mukuwa?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65769/919285",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "karuwa pavulas za tazaw kaninku",
                    "textAb": "karuwa pavulas za tazaw kaninku?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65771/919294",
