{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Buting, u pilipayan anucila, a tacuwa kisu saw?",
                "textCh": "Buting，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65731/918980",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "a tayza i sauwac kaku aci Muli miidid tu titi, isu i?",
                "textCh": "我明天要和Muli去溪邊烤肉，你呢？",
                "sound": "text/sound/65731/918981",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "kapah tengilen, kapah kaku tayza haw?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65731/918982",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mitengil kisu ci inaan!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65731/918983",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "ina, kapah kaku aci kakama tayza i sauwac haw?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65731/918984",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "kapah tu, pihaymawi haw!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65731/918985",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "hang matineng tu kami!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65731/918986",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "u canan ku kakiliman isu",
                    "textAb": "u canan ku kakiliman isu?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65733/918998",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "icuwa ku sauwac",
                    "textAb": "icuwa ku sauwac?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65736/919021",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "kapah pacaliwen kaku tu bakan haw",
                    "textAb": "kapah pacaliwen kaku tu bakan haw?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65737/919029",
                    "code": "3",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "canan",
                    "textCh": "什麼？",
                    "sound": "text/sound/65729/918964"
                },
                "1": {
                    "text": "a mikilim kaku tu celas atu sapiidid a tuud",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65733/918999"
                },
                "2": {
                    "text": "eyza, itiza i tabakiay a baetu",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65736/919022"
                },
                "3": {
                    "text": "hang, hini",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65737/919030"
                }
            },
            "target-2": {
                "0": {
                    "text": "caay pakatengil",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65729/918965"
                },
                "1": {
                    "text": "a mikilim kaku tu kubkub atu tubah",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65733/919000"
                },
                "2": {
                    "text": "caay katineng kaku icuwa ku sauwac",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65736/919023"
                },
                "3": {
                    "text": "inayi’ tu kaku",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65737/919031"
                }
            },
            "target-3": {
                "0": {
                    "text": "caay katineng",
                    "textCh": "不知道！",
                    "sound": "text/sound/65729/918966"
                },
                "2": {
                    "text": "itini, namakayni i sauwac tayni kaku",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65736/919024"
                },
                "3": {
                    "text": "caay, malepi’ tu ku bakan aku",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65737/919032"
                }
            },
            "stage": [
                {
                    "quest": "公車快要來了，但你們還沒買食材和工具。",
                    "tips": "問問看其他人「你要找什麼？」，<br>找出你要負責買的東西，放進購物籃吧！",
                    "words": [
                        "icuwa",
                        "izay",
