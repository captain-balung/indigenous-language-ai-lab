                "sound": "text/sound/65809/919606",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "amo’anopapalralrao Vedhao moa dhakerale okame lroho, la imia’e ’a pokoa’o?",
                "textCh": "我明天要和Vedhao去溪邊烤肉，你呢？",
                "sound": "text/sound/65809/919607",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "’inikoolrani, omi’a takataadhi’i ’osario. amodholrokali takapalra?",
