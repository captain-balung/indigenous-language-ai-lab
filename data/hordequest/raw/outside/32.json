                "sound": "text/sound/65809/919610",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "ia’e, la ’alringaanainome!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65809/919611",
                "image": "mom.png",
