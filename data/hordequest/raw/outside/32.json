                "sound": "text/sound/65809/919608",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "moana ’itovolro iinae.",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65809/919609",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "inake, amodholrokali takapalrine taakae moa dhakerale?",
