{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "legeageay, nosi’a ka nicyobi, kowa miso?",
                "textCh": "legeageay，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65772/919303",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "nosi’a ka kake si ’ongaolo ka nowa mikiname tanane wakame, koso ka?",
                "textCh": "我明天要和’ongaolo去溪邊烤肉，你呢？",
                "sound": "text/sound/65772/919304",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "nobicingi made ka magi’i no’aangimade! nodoo myali ’angiese mwa?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65772/919305",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mwa pasyo kibobo titinane!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65772/919306",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "niyaw, nodoo myali ’angiese kakane mwa drakeale?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65772/919307",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "e’e, makasi mocengela!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65772/919308",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "ipoingaw, doo mikiname!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65772/919309",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
