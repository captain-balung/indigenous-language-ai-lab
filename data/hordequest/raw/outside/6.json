{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Basaw, suxan ga ryax hngawan, aki su musa inu?",
                "textCh": "Basaw，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65617/918084",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "musa saku smuling syam te syaw na gong ki Yaway, isu ga?",
                "textCh": "我明天要和Yaway去溪邊烤肉，你呢？",
                "sound": "text/sound/65617/918085",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "pongan ga blaq balay salan ! ana saku mgluw musa uzi ga?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65617/918086",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "lmay mqus yaya su ha!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65617/918087",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "aya, hala saku mgluw qbsuyan mlikuy musa syaw na gong hku?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65617/918088",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "aw ga, ana ga ktay hazi ay!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65617/918089",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "aw, blequn myan mita!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65617/918090",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
