{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Rathudu, Vai ki vai luiya, naw muinu amiamia su?",
                "textCh": "Rathudu，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65741/919046",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Luiya lritarudrusaku ki Bali mua drakerale akame, kusu?",
                "textCh": "我明天要和Bali去溪邊烤肉，你呢？",
                "sound": "text/sound/65741/919047",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Anikatharirina! lrimaka tupalraku?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65741/919048",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Kivagana ki tiatina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65741/919049",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Ina, lrimaka tupalraku ki kaka ka sawvalay mua drakerale?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65741/919050",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Uunu, ai wadradreele madu kunumi!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65741/919051",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Kaikatumane, lritara dradreelenay.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65741/919052",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "manemane ku silasilape su",
                    "textAb": "Manemane ku silasilape su?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65745/919080",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "nguakakay inu ku samamua drakerale",
                    "textAb": "Nguakakay inu ku samamua drakerale?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65748/919110",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "lrimaka pakisaalru su nakuane ku lrabu",
                    "textAb": "Lrimaka pakisaalru su nakuane ku lrabu?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65749/919118",
                    "code": "3",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "manemane?",
                    "textCh": "什麼？",
                    "sound": "text/sound/65739/919039"
                },
                "1": {
                    "text": "Lrisilapaku ku lrangele si sacapane.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65745/919081"
                },
                "2": {
                    "text": "Kavay, yakay ku tarugutugu.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65748/919111"
                },
                "3": {
                    "text": "Uunu, malra!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65749/919119"
                }
            },
            "target-2": {
                "0": {
                    "text": "kaipualringalringaw?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65739/919040"
                },
                "1": {
                    "text": "Lrisilapaku ku lapanay si vurasi.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65745/919082"
                },
                "2": {
                    "text": "Kainaku wathingale luitalikay inu ku drakerale.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65748/919112"
                },
                "3": {
                    "text": "Mialriaku kakadrua.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65749/919120"
                }
            },
            "target-3": {
                "0": {
                    "text": "kaiwathingale!",
                    "textCh": "不知道！",
                    "sound": "text/sound/65739/919041"
                },
                "2": {
                    "text": "Kaivay, tualaladhaku drakerale.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65748/919113"
                },
                "3": {
                    "text": "Ini. malisinga ku lrabuli.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65749/919121"
                }
            },
            "stage": [
                {
                    "quest": "公車快要來了，但你們還沒買食材和工具。",
                    "tips": "問問看其他人「你要找什麼？」，<br>找出你要負責買的東西，放進購物籃吧！",
                    "words": [
                        "inu",
