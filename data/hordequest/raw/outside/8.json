    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Watan, a’hahangiqan i casan, mausa’ si inu’ a linanglung su’?",
                "textCh": "Watan，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65634/918210",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mausa’ ci gumlu ki Haking cumuloh cu hyi’ i aping na gawng i casan, isu’ ga?",
                "textCh": "我明天要和 Haking 去溪邊烤肉，你呢？",
                "sound": "text/sound/65634/918211",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "pungan ga kii cubalay i balayq pagnawan! pakbalayq ci musa’ uwi qu?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65634/918212",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "paquci isu’ i yaya’ han!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65634/918213",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "aya’, pakbalayq ci gumlu yulah musa’ i aping na gawng qu?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65634/918214",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "balayq, ga’ asi cimu cubalay ki panabaq yo!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65634/918215",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "uwal, papanabaq cami cubalay!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65634/918216",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
