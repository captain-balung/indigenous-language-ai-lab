{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Tiang, silungqu’an laqbing, namun’ica asu?",
                "textCh": "Tiang，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65723/918911",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "muskun cak Aping laqbing munhan vanglaz matapha’ titi’, kamaq asu?",
                "textCh": "我明天要和Aping去溪邊烤肉，你呢？",
                "sound": "text/sound/65723/918912",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "macial paqenanan tan’aun! maqtu cak malavi?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65723/918913",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "cingvi su’ ’a tina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65723/918914",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "tina, maqtu cak malavi toqas munhan vanglaz?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65723/918915",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "maqtu, a asa amun tu sadudu!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65723/918916",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "u, nasadudu cam!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65723/918917",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
