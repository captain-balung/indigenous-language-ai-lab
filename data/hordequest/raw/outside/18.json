{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Bau’, na inul’uan it laqbing, na makaica asuu?",
                "textCh": "Bau’，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65716/918849",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Na muskunak it Tanivu’ munca’an vaqlac matapha’ is qasu’ a, makuakas?",
                "textCh": "我明天要和Tanivu’去溪邊烤肉，你呢？",
                "sound": "text/sound/65716/918850",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Tan’aun tu na macial sala kavila’an ! maqtu’ak amin muskun maipa ta’?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65716/918851",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Tangausang asuu macingav tina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65716/918852",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Tina, maqtu’ak muskun tuqasnanaz munha’an vaqlac?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65716/918853",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Maqtu’, uutu asa amuu tu manalulu qai!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65716/918854",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Uu na, nii’ tu makua ha na, manalulukam tuza’!",
                "textCh": "沒問題，我們一定會小心的！",
                "sound": "text/sound/65716/918855",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
