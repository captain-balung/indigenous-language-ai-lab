                }
            },
            "target-2": {
                "0": {
                    "text": "ma’ulid ku kinger.",
                    "textCh": "聽不懂",
                    "sound": "text/sound/65750/919128"
                },
                "1": {
                    "text": "mukuwa ku mayaa’ da kudumu di vurasi.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65753/919145"
