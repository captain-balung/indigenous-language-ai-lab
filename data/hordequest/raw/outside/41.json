                    "code": "1",
                    "score": 100
                },
                {
                    "text": "piyaiyan na dalan na yawa i dinanuman",
                    "textAb": "piyaiyan na dalan na yawa i dinanuman?",
                    "textCh": "溪邊的路要往哪裡走？",
                    "sound": "text/sound/65754/919156",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "karuwa u pavelas da kamuc kaningku",
                    "textAb": "karuwa u pavelas da kamuc kaningku?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65756/919174",
