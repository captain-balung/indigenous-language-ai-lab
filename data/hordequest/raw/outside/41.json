                "1": {
                    "text": "mukuwa ku mayaa’ da langelr di kakerangan na ami.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65753/919144"
                },
                "2": {
                    "text": "kadiyu, kana ulra a ma’idang na varasa’ kadu.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65754/919157"
                },
                "3": {
                    "text": "ai, niya!",
                    "textCh": "好啊，拿去！",
