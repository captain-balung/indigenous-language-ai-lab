{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Amsing, kasede’an nu ’emanan, maranger u mukuwa i iyan?",
                "textCh": "Amsing，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65751/919130",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "nu ’emanan, rarelrang ku kani Muymuy mukuwa i dinanuman kemeranga da tiwngan, inu mu?",
                "textCh": "我明天要和Muymuy去溪邊烤肉，你呢？",
                "sound": "text/sound/65751/919131",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "kasahasahar nu kinger ta, karuwa ku kurelrang kanmu?",
                "textCh": "聽起來很好玩！我可以跟你們去嗎？",
                "sound": "text/sound/65751/919132",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "kiwmalri diya i taina nu kemadu!",
                "textCh": "你先問媽媽吧！",
                "sound": "text/sound/65751/919133",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "ina, karuwa ku kurelrang kana iva yawa i dinanuman?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65751/919134",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "ai nu kemadu, aymu, kilrivak ay!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65751/919135",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "ai, madalram mi,",
                "textCh": "是的，我們一定會的！",
                "sound": "text/sound/65751/919136",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "maaya’ u da eman",
                    "textAb": "maaya’ u da eman?",
                    "textCh": "你要找什麼？",
