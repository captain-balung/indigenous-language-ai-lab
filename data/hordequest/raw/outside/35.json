    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "mo’o, ho hucma zou nicio, teko akoyu uhnenu?",
                "textCh": "mo’o，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65791/919447",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "ho hucma temia yuyuso ’o paicʉ ho uhne va’hʉ ho cmapo to fou, teko mainenu?",
                "textCh": "我明天要和paicʉ去溪邊烤肉，你呢？",
                "sound": "text/sound/65791/919448",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "hoeca ʉmnʉ ho isi talʉi ! te’o melʉ fiho?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65791/919449",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "auva tuocosi ’o ino.",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65791/919450",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "ino, te’o melʉ fiho to ohaeva ho uhne va’hʉ?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65791/919451",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "naho, at’inghi temu bumemealʉ.",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65791/919452",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "’uatee, ’a temia.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65791/919453",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
