{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Lowking,jiyax sngayang ka saman,mmowsa su inu hug King?",
                "textCh": "Lowking，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65802/919546",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Mmowsa nami muduh siyang ayu hiya ka yaku ni Rabay, isu ga?",
                "textCh": "我明天要和Rabay去溪邊烤肉，你呢？",
                "sound": "text/sound/65802/919547",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Qbhangan,saw bi malu bi rwauun!Tduwa ku tqnay mowsa hug?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65802/919548",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Sliging ka bubu su han",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65802/919549",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Bubu,tduwa ku tqnay qbsuran mu snaw musa ayung hug",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65802/919550",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Tduwa,kiya ni asi namu ka qmlahang!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65802/919551",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Ini huya,ida nami musa qmlahang baly.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65802/919552",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
