                    "textCh": "什麼？",
                    "sound": "text/sound/65800/919530"
                },
                "1": {
                    "text": "Mowsa ku miing bangah ni kaji dduhun.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65805/919574"
                },
                "2": {
                    "text": "Hiya,ga niqan paru btunux hiya",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65806/919587"
                },
                "3": {
                    "text": "Tduwa,angal!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65807/919595"
                }
            },
            "target-2": {
                "0": {
                    "text": "Ini klai qmbahang",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65800/919531"
                },
                "1": {
                    "text": "Mowsa ku miing sqmu ni bunga",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65805/919575"
                },
                "2": {
                    "text": "Ini ku kla gaga inu ka ayung",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65806/919588"
                },
                "3": {
                    "text": "Ungat ka naku uri.",
                    "textCh": "我也沒有。",
