                }
            },
            "target-3": {
                "0": {
                    "text": "Ini klai",
                    "textCh": "不知道！",
                    "sound": "text/sound/65800/919532"
                },
                "2": {
                    "text": "Hini,hana ku pnaah auyng hiya.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65806/919589"
                },
                "3": {
                    "text": "Ini tduwa,wada naqi ka yayu mu da.",
                    "textCh": "不行，我的刀子壞掉了。",
