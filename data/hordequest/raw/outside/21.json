            "target-1": {
                "0": {
                    "text": "Ma’aq?",
                    "textCh": "什麼？",
                    "sound": "text/sound/65627/918174"
                },
                "1": {
                    "text": "Kilim saak qunhung siin paklangan titi tu ami.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65637/918238"
                },
                "2": {
                    "text": "Antandaiza, haiza batu daing tu daana.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65643/918274"
                },
                "3": {
                    "text": "Maqtu! Siza’i!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65645/918285"
                }
            },
            "target-2": {
                "0": {
                    "text": "Nii tu itqaalun?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65627/918175"
                },
                "1": {
                    "text": "Kilim saak pu’i siin hutan.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65637/918239"
                },
                "2": {
                    "text": "Nii saak niap tu maka’isaq a munhaan vanglaz tu daan.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65643/918275"
                },
                "3": {
                    "text": "Uka amin inaak.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65645/918286"
                }
            },
            "target-3": {
                "0": {
                    "text": "Nii tu maqansiap!",
                    "textCh": "不知道！",
                    "sound": "text/sound/65627/918176"
                },
                "2": {
                    "text": "Iti, laupang saak misnahaan vanglaz musuqais.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65643/918276"
                },
                "3": {
                    "text": "Nii tu maqtu, mindikla’in inaak tu via.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65645/918287"
                }
            },
