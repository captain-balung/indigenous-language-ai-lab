{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Umas! Islunghqu’an laqbingin, namun’isaq asu?",
                "textCh": "Umas，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65632/918197",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Nataskun saak Sani laqbingin munhaan vanglaz mapaklang titi. Namun’isaq asu?",
                "textCh": "我明天要和Sani去溪邊烤肉，你呢？",
                "sound": "text/sound/65632/918198",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Maaki tan’aun a namalinahip! Maqtu amin saak taskun mun’ita?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65632/918199",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Tangusa asu masingav tina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65632/918200",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Tina! Maqtu saak makilansan tuqasnanaz munhaan vanglaz?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65632/918201",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Maqtu! Asa tu mananulu qai!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65632/918202",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Namaqtu, Namananulu saam!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65632/918203",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
