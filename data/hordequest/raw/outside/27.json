{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Drokalaw, niciyobi loza, nawaino amiyaso?",
                "textCh": "Drokalaw，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65727/918945",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "loza aikarededeako ki Dawdaw modrakerale wakame sa bwate, koso?",
                "textCh": "我明天要和Dawdaw去溪邊烤肉，你呢？",
                "sound": "text/sound/65727/918946",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "lo kilalrata animatidalame! ai makato’alrako?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65727/918947",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mwana ki’elaela ki tinaita!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65727/918948",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "naina, ai makato’alrako ki takali ka sawalay modrakerale?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65727/918949",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "eene, wacaceela si kilalribaka konomi.",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65727/918950",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "kadro katoma, ai tara kilalribakenai!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65727/918951",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
