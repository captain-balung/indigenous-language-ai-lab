{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Sulikang,nu ’emana mu kasede’an zi mianger u za auwa i iyan?",
                "textCh": "Sulikang，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65759/919199",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "nu ’emanan salrangan ku kani Muya auwa mi i velelruwan kemeranga za ’alum, inu mu?",
                "textCh": "我明天要和Muya去溪邊烤肉，你呢？",
                "sound": "text/sound/65759/919200",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "kasahasahar na malinayan nu kinger ta! kazuwa ku kurelrang?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65759/919201",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "kiyumalri ziya i taina.",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65759/919202",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "ina,karuwa ku kurelrang ni iva na ma’inayan mukuwa i velelruwan?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65759/919203",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "karuwa, maw mu taranapaw i inmu!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65759/919204",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "ai, ’azi’a’azi mi temaranapaw.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65759/919205",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
