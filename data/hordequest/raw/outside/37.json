{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Vintia iniuahlukakua, taluavaʉlana ari matata?",
                "textCh": "Vintia，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/68836/956421",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mualʉsiaku Vanauna musa patʉkʉ hluhlungu cumacapa, auniniu?",
                "textCh": "我明天要和去溪邊烤肉，你呢？",
                "sound": "text/sound/68836/956422",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "timahlaʉ ia tam mavacangʉ pasaulaula’ʉ! acahliku i mʉlʉvʉ mʉmʉa?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/68836/956423",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "mualualu pakisuahlai inau!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/68836/956424",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "kainu, acahliku i mʉlʉvʉ ahlalua hlahlusa musa patʉkʉ hluhlungu?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/68836/956425",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "acahlika, maiatuhluhlukia ihlamu!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/68836/956426",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "aa’ʉ macahliamu!",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/68836/956427",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "ngasa uakikirimiau",
                    "textAb": "ngasa uakikirimiau",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/68837/956431",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "uamia ninau musa patʉkʉ hluhlungu",
                    "textAb": "uamia ninau musa patʉkʉ hluhlungu?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/68838/956444",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "acahliku i umuhli uatapihli",
                    "textAb": "acahliku i umuhli uatapihli?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/68839/956452",
                    "code": "3",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "misaini",
                    "textCh": "什麼？",
                    "sound": "text/sound/68835/956418"
                },
                "1": {
                    "text": "musaku ukikirimi vara’a hla siacapa.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/68837/956432"
                },
                "2": {
                    "text": "kaaiu, kaiu maru vatu’u taisanai.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/68838/956445"
                },
                "3": {
                    "text": "aa’ʉ, aalʉ!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/68839/956453"
                }
            },
            "target-2": {
                "0": {
                    "text": "kuatakahlangʉ",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/68835/956419"
                },
                "1": {
                    "text": "musaku ukikirimi viaru hla mairangʉ.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/68837/956433"
                },
                "2": {
                    "text": "kuaku macahlia maninau a patʉkʉ hluhlungu.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/68838/956446"
                },
                "3": {
                    "text": "uka’aku mʉmʉa.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/68839/956454"
                }
            },
            "target-3": {
                "0": {
                    "text": "kuamacahli",
                    "textCh": "不知道！",
                    "sound": "text/sound/68835/956420"
                },
                "2": {
                    "text": "naani, hlamunaku angahli patʉkʉ hluhlungu puaili.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/68838/956447"
                },
                "3": {
                    "text": "kuacahli, marakakacu a uatapihliku.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/68839/956455"
                }
            },
            "stage": [
                {
					"quest": "公車快要來了，但你們還沒買食材和工具。",
					"tips": "問問看其他人「你要找什麼？」，<br>找出你要負責買的東西，放進購物籃吧！",
