{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Pawan, gdregan ka kusun, mmaha su inu?",
                "textCh": "Pawan，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65698/918705",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Mmaha ku muduh siyang ka kusun daka Awe, isu de?",
                "textCh": "我明天要和Awe去溪邊烤肉，你呢？",
                "sound": "text/sound/65698/918706",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Qbhangun de malu ba thiqun! Ye malu msuupu ku mosa duri?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65698/918707",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Sling ka bubu su han!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65698/918708",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "Bubu, ye malu smnegul qbsuran rseno msuupu mosa yayung deriq ka yaku?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65698/918709",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "Malu, ma qtai hari ka yamu wa!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65698/918710",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "Un, asi miyan mkela.",
                "textCh": "沒問題，我們一定會的！",
                "sound": "text/sound/65698/918711",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "maanu skdiyun su ka isu",
                    "textAb": "Maanu skdiyun su ka isu?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65700/918728",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "maha mkkesa mquri inu ka ruru siyo",
                    "textAb": "Maha mkkesa mquri inu ka ruru siyo?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65701/918741",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "ye malu kbrexun su yayu ka yaku",
                    "textAb": "Ye malu kbrexun su yayu ka yaku?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65703/918757",
                    "code": "3",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "Maanu?",
                    "textCh": "什麼？",
                    "sound": "text/sound/65697/918702"
                },
                "1": {
                    "text": "Mosa ku skadi bagah daka kadi duhan wawa.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65700/918729"
                },
                "2": {
                    "text": "Hiya, niqal paru btunux ka hiya.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65701/918742"
                },
                "3": {
                    "text": "Malu wa, ngali!",
                    "textCh": "好啊，拿去！",
                    "sound": "text/sound/65703/918758"
                }
            },
            "target-2": {
                "0": {
                    "text": "Ini klai mbahang?",
                    "textCh": "聽不懂？",
                    "sound": "text/sound/65697/918703"
                },
                "1": {
                    "text": "Mosa ku skadi srqemu daka bunga.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65700/918730"
                },
                "2": {
                    "text": "Ini mu klai gaga inu ka ruru siyo.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65701/918743"
                },
                "3": {
                    "text": "Uka ku duri.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65703/918759"
                }
            },
            "target-3": {
                "0": {
                    "text": "Ini klai!",
                    "textCh": "不知道！",
                    "sound": "text/sound/65697/918704"
                },
                "2": {
                    "text": "Hini, hani ku kndalax ruru siyo meyah ka yaku.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65701/918744"
                },
                "3": {
                    "text": "Iya wa, ga naqah ka yayu mu di.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65703/918760"
                }
            },
            "stage": [
                {
                    "quest": "公車快要來了，但你們還沒買食材和工具。",
                    "tips": "問問看其他人「你要找什麼？」，<br>找出你要負責買的東西，放進購物籃吧！",
