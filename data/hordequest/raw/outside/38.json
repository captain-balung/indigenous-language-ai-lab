{
    "name": "戶外活動",
    "data": {
        "phase1": [
            {
                "text": "今天是星期六。主角正在和哥哥聊天，<br>討論明天的行程。來看看他們要去哪裡玩吧！"
            },
            {
                "text": "Insing, kasedean dra saliyusan an daman. maranger yu muka isuwa?",
                "textCh": "Insing，明天是星期天，你打算去哪裡？",
                "sound": "text/sound/65774/919316",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "pararenang mi kan Undru muka i inayan tremapaya dra patraka. yuyu i?",
                "textCh": "我明天要和Undru去溪邊烤肉，你呢？",
                "sound": "text/sound/65774/919317",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "killengaw ta i, kamawan dra kasagasagar i! karuwa ku kurenang?",
                "textCh": "聽起來很好玩！我也可以一起去嗎？",
                "sound": "text/sound/65774/919318",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "kiyumalli driya i ina!",
                "textCh": "你先問媽媽！",
                "sound": "text/sound/65774/919319",
                "image": "boy-2.png",
                "background": "1-2.png"
            },
            {
                "text": "ina, karuwa ku kurenang kan baelli na mainayan muka i inayan?",
                "textCh": "媽媽，我可以跟哥哥一起去溪邊嗎？",
                "sound": "text/sound/65774/919320",
                "image": "boy-1.png",
                "background": "1-1.png"
            },
            {
                "text": "aiwa, amawna, taranapaw muymu!",
                "textCh": "可以，但你們要小心喔！",
                "sound": "text/sound/65774/919321",
                "image": "mom.png",
                "background": "1-3.png"
            },
            {
                "text": "malladram mi lla. temaranapawa mi.",
                "textCh": "沒問題（知道了），我們會小心的！",
                "sound": "text/sound/65774/919322",
                "image": "boy-1.png",
                "background": "1-1.png"
            }
        ],
        "phase2": {
            "player": [
                {
                    "text": "maaya yu dra manay",
                    "textAb": "maaya yu dra manay?",
                    "textCh": "你要找什麼？",
                    "sound": "text/sound/65775/919326",
                    "code": "1",
                    "score": 100
                },
                {
                    "text": "kakallang ta isuwa muka i inayan",
                    "textAb": "kakallang ta isuwa muka i inayan?",
                    "textCh": "溪邊要往哪裡走？",
                    "sound": "text/sound/65776/919339",
                    "code": "2",
                    "score": 100
                },
                {
                    "text": "karuwa yu pabulas kanku dra kamutr",
                    "textAb": "karuwa yu pabulas kanku dra kamutr?",
                    "textCh": "可以借我刀子嗎？",
                    "sound": "text/sound/65778/919348",
                    "code": "3",
                    "score": 100
                }
            ],
            "target-1": {
                "0": {
                    "text": "a manay?",
                    "textCh": "什麼？",
                    "sound": "text/sound/65773/919313"
                },
                "1": {
                    "text": "muka ku mayaa dra langell aw dra tratrapayan.",
                    "textCh": "我去找木炭和烤肉網。",
                    "sound": "text/sound/65775/919327"
                },
                "2": {
                    "text": "kadriyu. ullaya a matrina a barasa kadriyu.",
                    "textCh": "那邊，有顆大石頭那邊。",
                    "sound": "text/sound/65776/919340"
                },
                "3": {
                    "text": "aiwa! alaku!",
                    "textCh": "好啊！拿去！",
                    "sound": "text/sound/65778/919349"
                }
            },
            "target-2": {
                "0": {
                    "text": "maulid ku killengaw.",
                    "textCh": "聽不懂",
                    "sound": "text/sound/65773/919314"
                },
                "1": {
                    "text": "muka ku mayaa dra kadumu aw dra bunga.",
                    "textCh": "我去找玉米和地瓜。",
                    "sound": "text/sound/65775/919328"
                },
                "2": {
                    "text": "maulid ku dra ullaya isuwa na inayan.",
                    "textCh": "我不知道溪邊在哪裡。",
                    "sound": "text/sound/65776/919341"
                },
                "3": {
                    "text": "uniyan nanku.",
                    "textCh": "我也沒有。",
                    "sound": "text/sound/65778/919350"
                }
            },
            "target-3": {
                "0": {
                    "text": "maulid ku.",
                    "textCh": "不知道！",
                    "sound": "text/sound/65773/919315"
                },
                "2": {
                    "text": "kadrini. muraruma ku kemay i inayan.",
                    "textCh": "這邊，我剛從溪邊回來。",
                    "sound": "text/sound/65776/919342"
                },
                "3": {
                    "text": "adri karuwa. mukuwatis ku kamutr.",
                    "textCh": "不行，我的刀子壞掉了。",
                    "sound": "text/sound/65778/919351"
                }
            },
            "stage": [
                {
                    "quest": "公車快要來了，但你們還沒買食材和工具。",
                    "tips": "問問看其他人「你要找什麼？」，<br>找出你要負責買的東西，放進購物籃吧！",
