  "themes": [
    {
      "key": "lesson",
      "name": "上課用語",
      "intro": "今天是開學第一天！主角在校門口遇到同學，他們在說什麼呢？",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png"
        },
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png"
        }
      ],
      "turns": [
        {
          "id": "21-hordequest-lesson-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Tukau’uq isuu ngaan?",
          "chineseText": "你叫甚麼名字？",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868457.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "21-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Tupa’un saak tu Lian.",
          "chineseText": "我叫Lian。",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868458.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "21-hordequest-lesson-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Isaq isuu lumaq?",
          "chineseText": "你的家在哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868459.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "21-hordequest-lesson-4",
          "order": 4,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Misnahaan saak Sinapalan mun’iti.",
          "chineseText": "我從新鄉部落來。",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868460.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "21-hordequest-lesson-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Mina’unin asu paitutingmut tu kakaunun?",
          "chineseText": "你吃早餐了嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868461.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "21-hordequest-lesson-6",
          "order": 6,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Nii’ang!",
          "chineseText": "還沒耶！",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868462.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "21-hordequest-lesson-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Namabaliv saak paitutingmut tu kakaunun, asa asu taskun?",
          "chineseText": "我要去買早餐，要一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868463.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "21-hordequest-lesson-8",
          "order": 8,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Nii saak minadas sui, maqtu asu mapasimul zaku sui?",
          "chineseText": "我沒有帶錢。你可以借我錢嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868464.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "21-hordequest-lesson-9",
          "order": 9,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Uu! Napasimulan zaku asu.",
          "chineseText": "好，我借你。",
          "audioUrl": "https://web.klokah.tw/text/sound/62576/868465.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        }
      ]
    },
    {
      "key": "find",
      "name": "尋找物品",
      "intro": "今天家裡要辦婚禮，很多親戚都來了。看到大家忙得不可開交，主角決定要幫大家一起準備。",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png"
        }
      ],
      "turns": [
        {
          "id": "21-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Tina! Madia haip munahaan lumaq tu taisis’aan!",
          "chineseText": "媽媽今天家裡來了好多親戚哦！",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924103.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-find-2",
          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Mapasiza haip tuqasnanaz, paaqpun madia taisis’aan minsuma.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924104.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "21-hordequest-find-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Manahip is’aang qai! Talbuntu’in nii tu mapasaduu intaa.",
          "chineseText": "好開心喔！很久沒有看到他們了！",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924105.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-find-4",
          "order": 4,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Tuza qai! Na’isnangu amin ata haip, asa asu tu mindangaz zami.",
          "chineseText": "對啊！今天大家都會很忙，你要幫忙大家。",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924106.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "21-hordequest-find-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Uu! Namindangaz azak.",
          "chineseText": "好的，我一定會！",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924107.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-find-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Namapalsanusin azak sanganin ikma’ai’un tu qaimangsut.",
          "chineseText": "我要去準備等一下要用的東西了。",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924108.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "21-hordequest-find-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Zaku’a mindangaz!",
          "chineseText": "我來幫忙！",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924109.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-find-8",
          "order": 8,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Uu! Makilansana zaku!",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/66203/924110.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        }
      ]
    },
    {
      "key": "outside",
      "name": "戶外活動",
      "intro": "今天是星期六。主角正在和哥哥聊天，討論明天的行程。來看看他們要去哪裡玩吧！",
      "characters": [
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png"
        },
        {
          "id": "sibling",
          "name": "哥哥",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png"
        }
      ],
      "turns": [
        {
          "id": "21-hordequest-outside-1",
          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Umas! Islunghqu’an laqbingin, namun’isaq asu?",
          "chineseText": "Umas，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918197.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "Nataskun saak Sani laqbingin munhaan vanglaz mapaklang titi. Namun’isaq asu?",
          "chineseText": "我明天要和Sani去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918198.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "21-hordequest-outside-3",
          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Maaki tan’aun a namalinahip! Maqtu amin saak taskun mun’ita?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918199.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "Tangusa asu masingav tina!",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918200.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "21-hordequest-outside-5",
          "order": 5,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Tina! Maqtu saak makilansan tuqasnanaz munhaan vanglaz?",
          "chineseText": "媽媽，我可以跟哥哥一起去溪邊嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918201.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "21-hordequest-outside-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Maqtu! Asa tu mananulu qai!",
          "chineseText": "可以，但你們要小心喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918202.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png",
          "background": "1-3.png"
        },
        {
          "id": "21-hordequest-outside-7",
          "order": 7,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Namaqtu, Namananulu saam!",
          "chineseText": "沒問題，我們一定會的！",
          "audioUrl": "https://web.klokah.tw/text/sound/65632/918203.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        }
      ]
    }
  ]
}
