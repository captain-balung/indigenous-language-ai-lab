          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "’inikoolrani, omi’a takataadhi’i ’osario. amodholrokali takapalra?",
          "chineseText": "真好，聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65809/919608.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "32-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "moana ’itovolro iinae.",
          "chineseText": "你先問媽媽！",
