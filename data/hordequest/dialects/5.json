  "themes": [
    {
      "key": "lesson",
      "name": "上課用語",
      "intro": "今天是開學第一天！主角在校門口遇到同學，他們在說什麼呢？",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png"
        },
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png"
        }
      ],
      "turns": [
        {
          "id": "5-hordequest-lesson-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Cima ko ngangan no miso?",
          "chineseText": "你叫甚麼名字？",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859787.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "5-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Ci Kacaw ko ngangan no mako.",
          "chineseText": "我叫Kacaw。",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859788.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "5-hordequest-lesson-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Icowaay ko loma’ no miso?",
          "chineseText": "你的家在哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859789.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "5-hordequest-lesson-4",
          "order": 4,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Nani Dihekoay a niyaro’ kako a tayni.",
          "chineseText": "我從陸安部落來。",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859790.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "5-hordequest-lesson-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Maranamay to kiso?",
          "chineseText": "你吃早餐了嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859791.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "5-hordequest-lesson-6",
          "order": 6,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Cowa ho!",
          "chineseText": "還沒耶！",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859792.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "5-hordequest-lesson-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Mami’aca kako to sakaranam, mihakelong kiso?",
          "chineseText": "我要去買早餐，要一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859793.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "5-hordequest-lesson-8",
          "order": 8,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Cowa piala kako to payci, manga’ay pacaliwen iso kako to payci?",
          "chineseText": "我沒有帶錢。你可以借我錢嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859794.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "5-hordequest-lesson-9",
          "order": 9,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Hayda, pacaliw han to ako kiso.",
          "chineseText": "好，我借你。",
          "audioUrl": "https://web.klokah.tw/text/sound/62246/859795.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        }
      ]
    },
    {
      "key": "find",
      "name": "尋找物品",
      "intro": "今天家裡要辦婚禮，很多親戚都來了。看到大家忙得不可開交，主角決定要幫大家一起準備。",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png"
        }
      ],
      "turns": [
        {
          "id": "5-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Ina, ’aloman ko salawinawina a tayni i loma’ anini yo!",
          "chineseText": "媽媽今天家裡來了好多親戚哦！",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923412.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-find-2",
          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "O paka^timan no fa’inayan a kaka anini, mansa ’aloman ko tayniay a tamdaw.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923413.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "5-hordequest-find-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "O kahemekan to! Halafin cowa to ka’araw camira!",
          "chineseText": "好開心喔！很久沒有看到他們了！",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923414.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-find-4",
          "order": 4,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Hay ! Matayal ko ’alomanay wa awa ko romi’ad anini, pacafayen iso ko ’alomanay.",
          "chineseText": "對啊！今天大家都會很忙，你要幫忙大家。",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923415.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "5-hordequest-find-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Hay, mafana’ to kako!",
          "chineseText": "好的，我一定會！",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923416.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-find-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Wa mamisaday kako to sakadademak anosawni.",
          "chineseText": "我要去準備等一下要用的東西了。",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923417.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "5-hordequest-find-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Mipacafay kako!",
          "chineseText": "我來幫忙！",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923418.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-find-8",
          "order": 8,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Hayda, tool han to iso kako.",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/66113/923419.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        }
      ]
    },
    {
      "key": "outside",
      "name": "戶外活動",
      "intro": "今天是星期六。主角正在和哥哥聊天，討論明天的行程。來看看他們要去哪裡玩吧！",
      "characters": [
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png"
        },
        {
          "id": "sibling",
          "name": "哥哥",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png"
        }
      ],
      "turns": [
        {
          "id": "5-hordequest-outside-1",
          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Kadafa, o pa’aliwacan anocila, wa tatalacowaaw kiso?",
          "chineseText": "Kadafa，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918032.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "Wa tatala’alo kako aci Pongay mi’id’id to titi anocila, kiso i?",
          "chineseText": "我明天要和Pongay去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918033.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "5-hordequest-outside-3",
          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Hato nga’ayay a halama a tengilen! Manga’ay kako malacafay tayla haw?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918034.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "Licayen ho iso ci wina.",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918035.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "5-hordequest-outside-5",
          "order": 5,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Ina, manga’ay kako mihakalong ci kakaan malacafay tayra i ’alo han?",
          "chineseText": "媽媽，我可以跟哥哥一起去溪邊嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918036.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "5-hordequest-outside-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Nga’ayay to, nikaorira pina’on kamo yo!",
          "chineseText": "可以，但你們要小心喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918037.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png",
          "background": "1-3.png"
        },
        {
          "id": "5-hordequest-outside-7",
          "order": 7,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Hay, mafana’ to a mina’on kami.",
          "chineseText": "沒問題，我們一定會的！",
          "audioUrl": "https://web.klokah.tw/text/sound/65611/918038.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        }
      ]
    }
  ]
}
