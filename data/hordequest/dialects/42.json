          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "yakmey apiya ri a piyalalaman! apya kangay ko macihza jinyo?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65742/919058.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
