        },
        {
          "id": "42-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "simaraw am yaken na kani Liwawa a mangay do siri no oyo a manazap, imo am?",
          "chineseText": "我明天要和Liwawa去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65742/919057.mp3",
