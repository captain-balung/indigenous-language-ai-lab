          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "nu kinger ta mu ’inava kivangangavangan! karuwa ku salrangan mukuwa?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65766/919261.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "39-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "kiumalri ziya i ina!",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65766/919262.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "39-hordequest-outside-5",
