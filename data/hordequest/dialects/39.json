        {
          "id": "39-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "nu ’emanan salralrangan ku kani Valrayvay awa mi i valilruwan kemeranga za ’alum, inu mu?",
          "chineseText": "我明天要和Valrayvay去溪邊烤肉，你呢？",
