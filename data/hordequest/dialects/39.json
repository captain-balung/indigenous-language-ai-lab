          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "ai wa! harem kana wari mu kavangangavang ta papiya, pulraalrang u yi.",
          "chineseText": "對啊！今天大家都會很忙，你要幫忙大家。",
          "audioUrl": "https://web.klokah.tw/text/sound/66311/924935.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
