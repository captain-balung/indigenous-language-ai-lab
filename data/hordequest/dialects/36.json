        },
        {
          "id": "36-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "sua nganai maku ia Pani.",
          "chineseText": "我叫Pani。",
          "audioUrl": "https://web.klokah.tw/text/sound/62906/877128.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
