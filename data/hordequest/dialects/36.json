          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "’esi nanu tanasa musu?",
          "chineseText": "你的家在哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/71668/998372.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
