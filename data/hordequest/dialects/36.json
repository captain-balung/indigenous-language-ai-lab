          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "makai manʉng timanʉʉn! tʉni kara ku kipapa?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65786/919406.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "36-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "mata’urua pa kasu kesoni cina.",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65786/919407.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "36-hordequest-outside-5",
          "order": 5,
          "speaker": "protagonist",
