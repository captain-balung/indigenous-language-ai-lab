        },
        {
          "id": "36-hordequest-find-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "ʉʉ’ʉ, tia ku muranʉ.",
          "chineseText": "好的，我一定會！",
