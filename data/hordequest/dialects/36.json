          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "tia ku mati’arangʉ tia siarupaca nonoman nusoni.",
          "chineseText": "我要去準備等一下要用的東西了。",
          "audioUrl": "https://web.klokah.tw/text/sound/71668/998394.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "36-hordequest-find-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "iavatu ku muranʉ.",
          "chineseText": "我來幫忙！",
