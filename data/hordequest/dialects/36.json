          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Pani, tarasangara taniara nura, tia kasu mukusa nanu?",
          "chineseText": "Pani，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65786/919404.mp3",
