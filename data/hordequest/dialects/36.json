          "background": "1-1.png"
        },
        {
          "id": "36-hordequest-find-8",
          "order": 8,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "ʉʉ’ʉ, kipapaa ’ikua!",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/71668/998396.mp3",
