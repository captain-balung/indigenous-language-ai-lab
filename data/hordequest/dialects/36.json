          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "36-hordequest-lesson-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "nikucici cu kara kasu?",
          "chineseText": "你吃早餐了嗎？",
