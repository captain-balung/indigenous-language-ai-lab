          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Amsing, kasede’an nu ’emanan, maranger u mukuwa i iyan?",
          "chineseText": "Amsing，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65751/919130.mp3",
