        },
        {
          "id": "41-hordequest-find-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "wa! kana semangal ku yi! sawariyan ku lra adi mena’u kanadu!",
          "chineseText": "哇！我好開心喔！我很久沒有看到他們了！",
          "audioUrl": "https://web.klokah.tw/text/sound/66323/925026.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "41-hordequest-find-4",
          "order": 4,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "ai mu! mavangavang ta harem kana wari. pulralrangay ta ay!",
          "chineseText": "對啊！今天大家都會很忙，要幫忙大家喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/66323/925027.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "41-hordequest-find-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "ai, daduwa ku!",
          "chineseText": "好的，我會來的！",
          "audioUrl": "https://web.klokah.tw/text/sound/66323/925028.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "41-hordequest-find-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "paadang ku diya kana piyaemanan nu maremay.",
          "chineseText": "我要去準備等一下要用的東西了。",
          "audioUrl": "https://web.klokah.tw/text/sound/66323/925029.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "41-hordequest-find-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "anlra! kunu pulralrangay!",
          "chineseText": "走吧！我來幫忙！",
          "audioUrl": "https://web.klokah.tw/text/sound/66323/925030.mp3",
