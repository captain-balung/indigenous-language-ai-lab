        },
        {
          "id": "41-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "nu ’emanan, rarelrang ku kani Muymuy mukuwa i dinanuman kemeranga da tiwngan, inu mu?",
          "chineseText": "我明天要和Muymuy去溪邊烤肉，你呢？",
