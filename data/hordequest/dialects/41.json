        },
        {
          "id": "41-hordequest-find-2",
          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "pakaetim i vau harem kana wari, semalra kaduwan na cau duwa.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66323/925025.mp3",
