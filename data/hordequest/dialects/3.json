  "themes": [
    {
      "key": "lesson",
      "name": "上課用語",
      "intro": "今天是開學第一天！主角在校門口遇到同學，他們在說什麼呢？",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png"
        },
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png"
        }
      ],
      "turns": [
        {
          "id": "3-hordequest-lesson-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Cima ko ngangan iso?",
          "chineseText": "你叫甚麼名字？",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858631.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "3-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Ci Kacaw kako.",
          "chineseText": "我叫Kacaw。",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858632.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "3-hordequest-lesson-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Icowa ko loma’ iso?",
          "chineseText": "你的家在哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858633.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "3-hordequest-lesson-4",
          "order": 4,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Na i Angcohay a niyaro’ a tayni kako.",
          "chineseText": "我從安通部落來。",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858634.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "3-hordequest-lesson-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Maranam to kiso?",
          "chineseText": "你吃早餐了嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858635.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "3-hordequest-lesson-6",
          "order": 6,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Caay ho!",
          "chineseText": "還沒耶！",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858636.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "3-hordequest-lesson-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "O mami’aca kako to sakaranam, mihakelong kiso?",
          "chineseText": "我要去買早餐，要一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858637.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "3-hordequest-lesson-8",
          "order": 8,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Awaay ko mihawikidan ako to payci, manga’ay pacaliw kiso to payci i takowanan?",
          "chineseText": "我沒有帶錢，你可以借我錢嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858638.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "3-hordequest-lesson-9",
          "order": 9,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Hayda, pacaliwen ako kiso.",
          "chineseText": "好，我借你。",
          "audioUrl": "https://web.klokah.tw/text/sound/62202/858639.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        }
      ]
    },
    {
      "key": "find",
      "name": "尋找物品",
      "intro": "今天家裡要辦婚禮，很多親戚都來了。看到大家忙得不可開交，主角決定要幫大家一起準備。",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png"
        }
      ],
      "turns": [
        {
          "id": "3-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Ina, ’aloman ko malinaay a tayni i loma’ anini.",
          "chineseText": "媽媽，今天家裡來了好多親戚哦！",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923320.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-find-2",
          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "O pataloma’an no kaka anini, hanaw ’aloman ko tamdaw a tayni.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923321.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "3-hordequest-find-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "O kahemekan a romi’ad ! halafin ito caay kasaso’araw i cangraan!",
          "chineseText": "好開心的日子喔！很久沒有看到他們了！",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923322.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-find-4",
          "order": 4,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Hai ! awaay ko limaw no polong anini, padangen to iso ko ’alomanay.",
          "chineseText": "對啊！今天大家都會很忙，你要幫忙大家。",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923323.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "3-hordequest-find-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "Hayda, mafana’ to kako!",
          "chineseText": "好的，我一定會！",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923324.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-find-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "O mamihalaka ho kako to maamaan a dademaken.",
          "chineseText": "我要去準備等一下要用的東西了。",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923325.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "3-hordequest-find-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "padangen ako!",
          "chineseText": "我來幫忙！",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923326.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-find-8",
          "order": 8,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Hayda, ati tooren kako!",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/66101/923327.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        }
      ]
    },
    {
      "key": "outside",
      "name": "戶外活動",
      "intro": "今天是星期六。主角正在和哥哥聊天，討論明天的行程。來看看他們要去哪裡玩吧！",
      "characters": [
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png"
        },
        {
          "id": "sibling",
          "name": "哥哥",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png"
        }
      ],
      "turns": [
        {
          "id": "3-hordequest-outside-1",
          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Mayaw, pilipayan no dafak, o tatalacowa kiso?",
          "chineseText": "Mayaw，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919692.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "Tala’alo kako ato ci Iko a mi’id’id to titi anodafak, kiso ka?",
          "chineseText": "我明天要和Iko去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919693.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "3-hordequest-outside-3",
          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Tengil han fangcal a salamaen ! manga’ay mihakelong kako a tayra?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919694.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "Licayen ho ci ina iso!",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919695.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "3-hordequest-outside-5",
          "order": 5,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Inaaw, manga’ay mitoor kako ci kakaan a tayra i ’alo?",
          "chineseText": "媽媽，我可以跟哥哥一起去溪邊嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919696.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "3-hordequest-outside-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "Hayda, nika pina’on kamo yo!",
          "chineseText": "可以，但你們要小心喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919697.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png",
          "background": "1-3.png"
        },
        {
          "id": "3-hordequest-outside-7",
          "order": 7,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Hai, mafana’ to kami!",
          "chineseText": "沒問題，我們一定會的！",
          "audioUrl": "https://web.klokah.tw/text/sound/65819/919698.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        }
      ]
    }
  ]
}
