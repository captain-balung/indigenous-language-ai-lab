      ],
      "turns": [
        {
          "id": "13-hordequest-lesson-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "So’o Sin hiya’en?",
          "chineseText": "你叫甚麼名字？",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863833.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "13-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "yako Sin ’atawen",
          "chineseText": "我叫’atawen。",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863834.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "13-hordequest-lesson-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "niSo’ taew’an hayno’?",
          "chineseText": "你的家在哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863835.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "13-hordequest-lesson-4",
          "order": 4,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "yako ’inay walo’ ’asang mowa:i’.",
          "chineseText": "我從東河部落來。",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863836.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "13-hordequest-lesson-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "So’o komhaema’ ila ay?",
          "chineseText": "你吃早餐了嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863837.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "13-hordequest-lesson-6",
          "order": 6,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "’i’ini’ o!",
          "chineseText": "還沒喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863838.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "13-hordequest-lesson-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "yako ’am rima’ bae:iw ka kohaema’en, ’am ma’onhael rima’ ay?",
          "chineseText": "我要去買早餐，要一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863839.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "13-hordequest-lesson-8",
          "order": 8,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "yako ’okay ’araS ka rayhil. So’o kayzaeh ay paSibae:aeh ’iyakin ka rayhil.",
          "chineseText": "我沒有帶錢。你可以借我錢嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863840.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "13-hordequest-lesson-9",
          "order": 9,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "’a:ay, yako taSibae:aeh ’iSo’on.",
          "chineseText": "好，我借你。",
          "audioUrl": "https://web.klokah.tw/text/sound/62400/863841.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        }
      ]
    },
    {
      "key": "find",
      "name": "尋找物品",
      "intro": "今天家裡要辦婚禮，很多親戚都來了。看到大家忙得不可開交，主角決定要幫大家一起準備。",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png"
        },
        {
          "id": "mother",
          "name": "媽媽",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png"
        }
      ],
      "turns": [
        {
          "id": "13-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "’oya’ kaysa’an ray taew’an mowa:i’ ila kin haeba:an ka ’aeh’aehael o!",
          "chineseText": "媽媽今天家裡來了好多親戚哦！",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923734.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-find-2",
          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "kaysa’an hi minatini’ kamamanra:an makaksi’ael, ’isa:a’ hayza’ kin haeba:an ka mae’iyaeh mowa:i’.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923735.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "13-hordequest-find-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "kinSiyae’ o! honaehnge: ’okay kita’ ila hi lasiya.",
          "chineseText": "好開心喔！很久沒有看到他們了！",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923736.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-find-4",
          "order": 4,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "’ihi’ a! kaysa’an ’ita’ saeboeh ’am ’okay honasamez, So’o ’am tatilhael ka saeboeh.",
          "chineseText": "對啊！今天大家都會很忙，你要幫忙大家。",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923737.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "13-hordequest-find-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "’a:ay, yako ra:am.",
          "chineseText": "好的，我一定會！",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923738.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-find-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "yako ’am rima’ tal’awan ’insa’an nom powa’ ka kakrangi’an.",
          "chineseText": "我要去準備等一下要用的東西了。",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923739.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        },
        {
          "id": "13-hordequest-find-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "yako tatilhael!",
          "chineseText": "我來幫忙！",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923740.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-find-8",
          "order": 8,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "’a:ay, So’o tani ’iyakin wa:ila.",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/66155/923741.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
          "background": "1-2.png"
        }
      ]
