      "turns": [
        {
          "id": "13-hordequest-outside-1",
          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "lahi’, rim’an kaSangayan hahila:, So’o ’am ’ila’ino’?",
          "chineseText": "lahi’，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918498.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "yako rim’aen ’am ki lalo’ rima’ ray lolongan somoloeh ka bori:, So’o li?",
          "chineseText": "我明天要和lalo’去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918499.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "13-hordequest-outside-3",
          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "bazae’en kin kayzaeh kakSiyae’en, yako ma’ kayzaeh ay ma’onhael rima’?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918500.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "So’o ’inSala’ singozaw hi ’oya’.",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918501.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "13-hordequest-outside-5",
          "order": 5,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "’oya’, yako kayzaeh ay ki minatini’ kamamanra:an ma’onhael rima’ lolongan?",
          "chineseText": "媽媽，我可以跟哥哥一起去溪邊嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918502.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "13-hordequest-outside-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "kayzaeh, ’oka’ o moyo ma’ ’iya’azem o!",
          "chineseText": "可以，但你們也要小心喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918503.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png",
          "background": "1-3.png"
        },
        {
          "id": "13-hordequest-outside-7",
          "order": 7,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "’a:ay, yami ra:am!",
          "chineseText": "好的，我們會的！",
          "audioUrl": "https://web.klokah.tw/text/sound/65671/918504.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
