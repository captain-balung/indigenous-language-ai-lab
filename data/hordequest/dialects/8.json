      "turns": [
        {
          "id": "8-hordequest-outside-1",
          "order": 1,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Watan, a’hahangiqan i casan, mausa’ si inu’ a linanglung su’?",
          "chineseText": "Watan，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65634/918210.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "8-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "mausa’ ci gumlu ki Haking cumuloh cu hyi’ i aping na gawng i casan, isu’ ga?",
          "chineseText": "我明天要和 Haking 去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65634/918211.mp3",
