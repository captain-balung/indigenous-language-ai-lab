          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "uwal, glu kuwing!",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/66131/923557.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/mom.png",
