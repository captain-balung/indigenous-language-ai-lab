        {
          "id": "8-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "aya’, habaag a rumaruma’ ka muwah imug yo!",
          "chineseText": "媽媽今天家裡來了好多親戚哦！",
          "audioUrl": "https://web.klokah.tw/text/sound/66131/923550.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
