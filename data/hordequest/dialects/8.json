          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "papasiqun kisa’ i yulah, kahi’ habaag a itaal ka muwah.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66131/923551.mp3",
