    {
      "key": "lesson",
      "name": "上課用語",
      "intro": "今天是開學第一天！主角在校門口遇到同學，他們在說什麼呢？",
      "characters": [
        {
          "id": "classmate",
          "name": "同學",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png"
        },
        {
          "id": "protagonist",
          "name": "主角",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png"
        }
      ],
      "turns": [
        {
          "id": "8-hordequest-lesson-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "ima’ ku ralu’ su’? / nanuwan ku ralu’ su’?",
          "chineseText": "你叫甚麼名字？",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861521.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "8-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "Kaynu’ ku ralu’ mu.",
          "chineseText": "我叫Kaynu'。",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861522.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "8-hordequest-lesson-3",
          "order": 3,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "kiya inu’ ku imuwag su’?",
          "chineseText": "你的家在哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861523.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "8-hordequest-lesson-4",
          "order": 4,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "minukahul kuwing i tinqalangan i Tabilas.",
          "chineseText": "我從圓墩部落來。",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861524.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "8-hordequest-lesson-5",
          "order": 5,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "kumnunama’ su’ la qu?",
          "chineseText": "你吃早餐了嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861525.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "8-hordequest-lesson-6",
          "order": 6,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "ini’ na’ yo! / iqaat na’ yo!",
          "chineseText": "還沒耶！",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861526.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "8-hordequest-lesson-7",
          "order": 7,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "mausa’ kuwing i mabanay cu kakunama’, paglu su’ i musa’ qu?",
          "chineseText": "我要去買早餐，要一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861527.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        },
        {
          "id": "8-hordequest-lesson-8",
          "order": 8,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "ini’ kuwing aras cu pila’, pakabalayq su’ i pakabaxan kuwing cu pila’ qu?",
          "chineseText": "我沒有帶錢。你可以借我錢嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861528.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
          "background": "1-2.jpg"
        },
        {
          "id": "8-hordequest-lesson-9",
          "order": 9,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "uwal, pakabaxay mi su’.",
          "chineseText": "好，我借你。",
          "audioUrl": "https://web.klokah.tw/text/sound/62312/861529.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/girl.png",
          "background": "1-1.jpg"
        }
      ]
    },
    {
