        },
        {
          "id": "23-hordequest-outside-3",
          "order": 3,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "sa temalidu angata nutja langedain! maqati kiciul aken uta?",
          "chineseText": "聽起來很好玩！我也可以一起去嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65563/917739.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "23-hordequest-outside-4",
          "order": 4,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "kivadaqi anan ti kina!",
          "chineseText": "你先問媽媽！",
          "audioUrl": "https://web.klokah.tw/text/sound/65563/917740.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
          "background": "1-2.png"
        },
        {
          "id": "23-hordequest-outside-5",
          "order": 5,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "kina! maqati aken kiciul kata u kaka vaik a sema pana?",
          "chineseText": "媽媽，我可以跟哥哥一起去溪邊嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/65563/917741.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-1.png",
          "background": "1-1.png"
        },
        {
          "id": "23-hordequest-outside-6",
          "order": 6,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "maqati! ljakua kinemenemu dri!",
          "chineseText": "可以，但你們要小心喔！",
          "audioUrl": "https://web.klokah.tw/text/sound/65563/917742.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/mom.png",
