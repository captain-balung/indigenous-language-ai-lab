        {
          "id": "23-hordequest-outside-2",
          "order": 2,
          "speaker": "sibling",
          "speakerName": "哥哥",
          "indigenousText": "uri vaik amen sema pana a cemapa ta vutjulj kati djupelang, ti sun?",
          "chineseText": "我明天要和djupelang去溪邊烤肉，你呢？",
          "audioUrl": "https://web.klokah.tw/text/sound/65563/917738.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/outside/boy-2.png",
