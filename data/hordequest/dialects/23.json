          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "kuljelje! niciu nutiav uri semainu sun?",
          "chineseText": "kuljelje，明天是星期天，你打算去哪裡？",
          "audioUrl": "https://web.klokah.tw/text/sound/65563/917737.mp3",
