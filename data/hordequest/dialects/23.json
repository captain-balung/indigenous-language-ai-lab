          "id": "23-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "kina! tjuruvu angata na mangetjez a tja kasusus!",
          "chineseText": "媽媽今天家裡來了好多親戚哦！",
          "audioUrl": "https://web.klokah.tw/text/sound/66215/924195.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "23-hordequest-find-2",
          "order": 2,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "pucekelj ti su kaka kasauny avansika izua tjuruvu na mangetjez a caucau.",
          "chineseText": "今天是哥哥的婚禮，所以有很多人來。",
          "audioUrl": "https://web.klokah.tw/text/sound/66215/924196.mp3",
