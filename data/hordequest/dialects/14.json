        },
        {
          "id": "14-hordequest-lesson-2",
          "order": 2,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "zain naak a lhanaz Hudun.",
          "chineseText": "我叫Hudun。",
          "audioUrl": "https://web.klokah.tw/text/sound/62422/864412.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
