          "order": 8,
          "speaker": "protagonist",
          "speakerName": "主角",
          "indigenousText": "ani iaku tu minathu tuali, anaiwan mihu a tuali shimulik?",
          "chineseText": "我沒有帶錢。你可以借我錢嗎？",
          "audioUrl": "https://web.klokah.tw/text/sound/62422/864418.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/lesson/boy.png",
