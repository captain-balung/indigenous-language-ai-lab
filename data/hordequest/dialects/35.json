          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "35-hordequest-find-4",
          "order": 4,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "’a zou eno ! te na’no man’i ci hioa maitan’e, teto so to’usnu ta botngonʉ.",
          "chineseText": "對啊！今天大家都會很忙，你要幫忙大家。",
