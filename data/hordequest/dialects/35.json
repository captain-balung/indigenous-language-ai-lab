          "indigenousText": "te’o to’usnu.",
          "chineseText": "我來幫忙！",
          "audioUrl": "https://web.klokah.tw/text/sound/66287/924754.mp3",
          "imageUrl": "https://web.klokah.tw/interact/hordequest/img/find/girl.png",
          "background": "1-1.png"
        },
        {
          "id": "35-hordequest-find-8",
          "order": 8,
          "speaker": "mother",
          "speakerName": "媽媽",
          "indigenousText": "zou eno, naho no fiho a’o.",
          "chineseText": "好，你跟我來！",
          "audioUrl": "https://web.klokah.tw/text/sound/66287/924755.mp3",
