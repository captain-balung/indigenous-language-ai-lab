        {
          "id": "35-hordequest-find-1",
          "order": 1,
          "speaker": "classmate",
          "speakerName": "同學",
          "indigenousText": "ino, maitan’e mo na’no botngonʉ ’emo cmʉ’ho ta emoo ci ’oahngʉ.",
          "chineseText": "媽媽今天家裡來了好多親戚哦！",
