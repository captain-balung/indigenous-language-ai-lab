{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"mataadhi’ikanomi? amo’ica’oca’omita takamelre’e asolatae ’ina mene, imia ta topatilai!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56527/788884"	
		},		
		"phase1":{		
			"ab":"sialalrana o’ipini singsi, mani lolodho o’ipini singsi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56527/788885"	
		},		
		"phase2":{		
			"ab":"sialalra ta’itovolraeni singsi, la mani loalala vilri.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56527/788887"	
		},		
		"phase3":{		
			"ab":"mataadhi’i! ’ina ’a loa movalrisi ’aovaovahainome.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56527/788888"	
		},		
		"phase4":{		
			"ab":"toce’elae sialalra ta’itovolraeni singsi. loalala vilri.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56527/788889"	
		},		
		"phase5":{		
			"ab":"toce’elae sialalra ta’itovolraeni singsi, omaedha tatopodhaolae?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56527/788890"	
		},		
		"phase6":{		
			"ab":"’akosaeni ka malrihili! ’ina ’a loa cengele kamapoelre’o lriho’o tatopodhaolae!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56527/788891"	
		},		
		"switch":{		
			"ab":"mataadhi’i! amo’aelangakanomi?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56527/788886"	
				
		},		
		"ending":{		
			"ab":"tovolrienga’o! olropengenga ta’ica’oca’o mene, lo mikimao dha’ane sa’apalramao ’ica’ica’o! lako padhalro’o mo’adhaadhalra!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56527/788892"	
		}		
	},			
