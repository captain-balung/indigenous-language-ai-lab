{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"mavacangʉ mʉmʉa, tumua arinani musuturu matalakiahlʉ kari, ruamiacita!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56652/790604"	
		},		
		"phase1":{		
			"ab":"mualualua tumimahla pakiaturua kihlamuhlamu, pialʉsʉa pakiaturua kihlamuhlamu.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56652/790605"	
		},		
		"phase2":{		
			"ab":"tumimahla pahluamia pakiaturua, piatatahlamʉ umalivalʉ.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56652/790607"	
		},		
		"phase3":{		
			"ab":"tam mavacangʉ! kani’i, mualiuhlu ihlamu piatatahlamʉ.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56652/790608"	
		},		
		"phase4":{		
			"ab":"tumahlʉngʉ pahluamia pakiaturua, piatatahlamʉ umalivalʉ.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56652/790609"	
		},		
		"phase5":{		
			"ab":"tumahlʉngʉ pahluamia pakiaturua, sia ngahlaisa ia macuisa?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56652/790610"	
		},		
		"phase6":{		
			"ab":"tam hliulavalava! kani’i tuahlʉ’ai ihlau mavacangʉ takʉlʉpʉngʉ!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56652/790611"	
		},		
		"switch":{		
			"ab":"tam mavacangʉ! pingahlangahla i?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56652/790606"	
				
		},		
		"ending":{		
			"ab":"arasingasinga ihlau! pasalʉpʉngʉ siatuturua arinani, tumua aariaari ma salia musuturu! aniciki makulai aravacangʉ!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56652/790612"	
		}		
	},			
