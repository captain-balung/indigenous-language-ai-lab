{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Miqumicang, napisqanciap ata haipi qantangun tu paitasan, kitnga’in ata ti!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56177/783724"	
		},		
		"phase1":{		
			"ab":"Ciang tataqu’ ca mungausang bazbaz, nalancanin amuu tataqu’ bazbaz.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56177/783725"	
		},		
		"phase2":{		
			"ab":"Tanaivang ca sinpacingav i tataqu, tanama antalam.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56177/784071"	
		},		
		"phase3":{		
			"ab":"Mantan macial! napacaisin mu’un tanam bazbaz ti.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56177/784072"	
		},		
		"phase4":{		
			"ab":"Tan’ai tuza ca sinpacingav i tataqu. tanama antalam.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56177/784073"	
		},		
		"phase5":{		
			"ab":"Tan’ai tuza’ ca sinpacingav i tataqu, cia ica ca tutuku tu sin’antalam?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56177/784074"	
		},		
		"phase6":{		
			"ab":"Malmananu’ dia! natanami ti mauqtu aminun su’u tutuku antalam ca sinpacingav i.",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56177/784075"	
		},		
		"switch":{		
			"ab":"Mantan macial! mauqna’ang muc’an ti?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56177/784070"	
				
		},		
		"ending":{		
			"ab":"Miqumicang su’un! kanaqtungin ca pisqancaipan haip, daqdaqanin han lumaq pisqanciap! namahiav ’uqancaipan!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56177/784076"	
		}		
	},			
