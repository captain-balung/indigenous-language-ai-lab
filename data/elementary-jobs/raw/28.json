{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"saabaw makanaelre, kaykameane lri kicawcakwane kay maduy vaga, ilata pathagili!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56427/787508"	
		},		
		"phase1":{		
			"ab":"paswalana kilalra lri silrigu kay sinsi, ala tupapalra ki sinsi silrigu.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56427/787509"	
		},		
		"phase2":{		
			"ab":"kilalra kay akivaganeli, palalava tubalre.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56427/787511"	
		},		
		"phase3":{		
			"ab":"mathariri! kayasane, lri ubalrithi numi kawriva.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56427/787512"	
		},		
		"phase4":{		
			"ab":"pudriadringadha kilalra kay akivagane ki sinsi. palalava tubalre.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56427/787513"	
		},		
		"phase5":{		
			"ab":"pudriadringadha kilalra kay akivagane ki sinsi, amani ki saininu?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56427/787514"	
		},		
		"phase6":{		
			"ab":"malrigilinumi! kayasane, drela luka pacengecengesu!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56427/787515"	
		},		
		"switch":{		
			"ab":"malrigili! lri pela numi?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56427/787510"	
				
		},		
		"ending":{		
			"ab":"malrigilisu! tualrepenge kay akicawcakuane kaykameane, mialri luikaysu davanane kiacawcakuane madu! lri padalrusu adili!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56427/787516"	
		}		
	},			
