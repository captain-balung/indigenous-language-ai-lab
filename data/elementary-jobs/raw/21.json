{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Uninang, nakitngaa ata pinanaam itu bunun tu qalinga haip.",	
			"ch":"大‌家‌好‌，‌今‌天‌要‌學‌習‌一‌些‌簡‌單‌的‌詞‌彙‌，‌我‌們‌開‌始‌吧!",	
			"sound":"text/sound/56252/785100"	
		},		
		"phase1":{		
			"ab":"Nangausang tan’a zaku masipul a, siin mu’un tulalansan.",	
			"ch":"先聽老師念，再跟著老師念。",	
			"sound":"text/sound/56252/785101"	
		},		
		"phase2":{		
			"ab":"Na masingav saak ka, mu’u antalam.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56252/785103"	
		},		
		"phase3":{		
			"ab":"Mastaan masihal! Maaq laupaku a mu’un tanam bazbaz.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56252/785104"	
		},		
		"phase4":{		
			"ab":"Manaingkala tan’a a, Tanam a antalam.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56252/785105"	
		},		
		"phase5":{		
			"ab":"Manaingkala tan’a a, antalam tu isaq a mantuk?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56252/785106"	
		},		
		"phase6":{		
			"ab":"Tuza tu malmananu! Laupaku qai, na saduu ata tu, duuq amin mantuk suu a sin’antalam.",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56252/785107"	
		},		
		"switch":{		
			"ab":"Mastaan masihal! Namoqnaang?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56252/785102"	
				
		},		
		"ending":{		
			"ab":"Manahip salaz! Pan’naqtungin a sinpasnava, asa tu daqdaq’qanin pinanam! Na maqtu mahiav minmaqansiap.",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56252/785108"	
		}		
	},			
