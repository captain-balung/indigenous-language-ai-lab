{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Uninang, na penanam ata haip pi kantangun tu qalinga, u~na ketnga ata!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56202/784412"	
		},		
		"phase1":{		
			"ab":"Nusang tan’a sinsi masipul, na makislavikin amu sinsi masipul.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56202/784413"	
		},		
		"phase2":{		
			"ab":"Tan’a icia sinsi tu sinbazbaz, tanama antalam.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56202/784415"	
		},		
		"phase3":{		
			"ab":"Tuzatu nitu qandang! Na mu’un na tanam bazbaz lopaku.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56202/784416"	
		},		
		"phase4":{		
			"ab":"Maneinkal tan’a ica sinsi masingav mu’u tu sinbazbaz. Tanama antalam.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56202/784417"	
		},		
		"phase5":{		
			"ab":"Maneinkal tan’a ica sinsi masingav mu’u tu sinbazbaz, icaq itu’un nah mamantuk?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56202/784418"	
		},		
		"phase6":{		
			"ab":"Tutuza tu ni tu kandang i! Lopaku nah sadukang ata tu doqe maqtu amu aminun makanciap!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56202/784419"	
		},		
		"switch":{		
			"ab":"I~a, nitukantan! Na moqnang asu penanam?",	
			"ch":"太棒了！你要再練習一次嗎？",	
			"sound":"text/sound/56202/784414"	
				
		},		
		"ending":{		
			"ab":"Tuzatu uninang! Kanagqtungnin hipa pa sinpasnava, mamaca ihan lumap qa asa tu qanglac leansu mopata na muhiav asu usizan qalinga ki!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56202/784420"	
		}		
	},			
