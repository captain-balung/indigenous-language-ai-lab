{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Embiyax namu kana, sayang sluhay ta cicih meslexan bi kari, emprajing ta da!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56552/789228"	
		},		
		"phase1":{		
			"ab":"Plealay embahang smpug emptgsa, kiya do sngun smpug emptgsa.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56552/789229"	
		},		
		"phase2":{		
			"ab":"Qbahang ssiling emptgsa, syuki binaw.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56552/789231"	
		},		
		"phase3":{		
			"ab":"Tayal knsuyang! sayang, yamu ka rngaw binaw.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56552/789232"	
		},		
		"phase4":{		
			"ab":"Tgluus embahang ssiling emptgsa. spngi syuki binaw.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56552/789233"	
		},		
		"phase5":{		
			"ab":"Tgluus embahang ssiling emptgsa. manu ka sniyuk kari hug?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56552/789234"	
		},		
		"phase6":{		
			"ab":"Tayal knkla! sayang, qtai nii su klaun kana da o!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56552/789235"	
		},		
		"switch":{		
			"ab":"Tayal knsuyang! pxal ta duri hug?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56552/789230"	
				
		},		
		"ending":{		
			"ab":"Ana su bi rabang! qhduun su smluhay jiyax sayang, sluhay balay mniq su sapah kjiyax uri o! kika aji su rait merana o!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56552/789236"	
		}		
	},			
