{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"manʉng kita, soni tia kita kiatuturu maraa kantaan kari, matianai cu kita!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56627/790260"	
		},		
		"phase1":{		
			"ab":"mu’uru’uru takituturua sumasʉpʉrʉ, tuapapaa cu kamu sumasʉpʉrʉ.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56627/790261"	
		},		
		"phase2":{		
			"ab":"tumatimanaa kari takituturua, tanamʉ marivari.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56627/790263"	
		},		
		"phase3":{		
			"ab":"manʉng! masini, tia cu ikamu pokarikari.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56627/790264"	
		},		
		"phase4":{		
			"ab":"aririana takituturua tamna kari, tanamʉ marivari.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56627/790265"	
		},		
		"phase5":{		
			"ab":"aririana takituturua tamna kari, ’inanuin sua cucuru?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56627/790266"	
		},		
		"phase6":{		
			"ab":"manʉngʉana! masini, cumacʉ’ʉra kasua tia kara masicucuru kavangvang!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56627/790267"	
		},		
		"switch":{		
			"ab":"manʉng! tia pa kara maka’ʉna?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56627/790262"	
				
		},		
		"ending":{		
			"ab":"macangcangara! matirupangʉ cu soni. tantaniara na tanasa rinsiu, tia mara’an arasurusuru!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55802/790268"	
		}		
	},			
