{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"mihumisang taisis’aan, aip a na’ispasnava hai kantan tu halinga, kitngaabin a kata!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56277/785444"	
		},		
		"phase1":{		
			"ab":"tangusag ta’aza mas masnanava masipul, at tusulutin mas masnanavacia masipul.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56277/785445"	
		},		
		"phase2":{		
			"ab":"ta’azaa mas itumasnanava tu na’ispalihansiap, at tanama antalam.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56277/785447"	
		},		
		"phase3":{		
			"ab":"masial! tanama laupaku tupa’at.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56277/785448"	
		},		
		"phase4":{		
			"ab":"itnaingkala mas itumasnanava tu na’ispalihansiap at tanama antalam.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56277/785449"	
		},		
		"phase5":{		
			"ab":"itnaingkala mas itumannanava tu na’ispalihansiap tu makua a mamantuk?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56277/785450"	
		},		
		"phase6":{		
			"ab":"mamananu! sadua laupaku tu adu mamantuk amin a isuu sin’antalam!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56277/785451"	
		},		
		"switch":{		
			"ab":"masial! namuhna’ang ha?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/56277/785446"	
				
		},		
		"ending":{		
			"ab":"matumaslingsu! minsia a aip sinpasnava, asa amin mais ilumah tu kaupahanian tatanam at nama’aipi mumuslud!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56277/785452"	
		}		
	},			
