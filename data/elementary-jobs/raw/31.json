{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"margi mumu, nukiburunmamti na babka sesa, tasikirodru!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56502/788540"	
		},		
		"phase1":{		
			"ab":"biciringa la isisipi ni singsi si, langiaro isisipi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56502/788541"	
		},		
		"phase2":{		
			"ab":"biciringa poka ni singsi lamélva biri.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56502/788543"	
		},		
		"phase3":{		
			"ab":"margi! nokmaninmamu mélva musubaka.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56502/788544"	
		},		
		"phase4":{		
			"ab":"biciringa pokani ki singsi. lamélva biri.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56502/788545"	
		},		
		"phase5":{		
			"ab":"biciringa pokani ki singsi, acina matɨkadrengédia?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56502/788546"	
		},		
		"phase6":{		
			"ab":"kakɨcɨngɨmusu knénga ka talacengɨlɨ drurumisu ngiculu sekɨla!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56502/788547"	
		},		
		"switch":{		
			"ab":"margi! nukuvalɨ nmamsu la?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/56502/788542"	
				
		},		
		"ending":{		
			"ab":"takdrengésu! rɨpɨngesu nga takbubura su sesa ka ikia dane kibuburu makavienenga! mraragi niamamsu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56502/788548"	
		}		
	},			
