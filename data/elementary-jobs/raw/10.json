{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"lokah ta qabax, tqbaq ta cikay biru na tayal. tgaring ta lay.",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56002/781660"	
		},		
		"phase1":{		
			"ab":"bleqi mung lpuxun sesiy ha, ru squn sesiy lmpux loyi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56002/781661"	
		},		
		"phase2":{		
			"ab":"pungi cikay tqbaqan cimu mu qani, ru tlami kmayan cikay.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56002/781663"	
		},		
		"phase3":{		
			"ab":"talagay baqan! mwani lga, kayan cikay cimu la.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56002/781664"	
		},		
		"phase4":{		
			"ab":"bleqi mung ke sesiy. ru tlami kmayan cikay.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56002/781665"	
		},		
		"phase5":{		
			"ab":"bleqi mung ke sesiy, akya qenu ga cbalay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56002/781666"	
		},		
		"phase6":{		
			"ab":"talagay baq! mwani, ktalay mu kuna su qbaqun calay!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56002/781667"	
		},		
		"switch":{		
			"ab":"talagay baq cimu calay! lpxay ta loyi ga?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56002/781662"	
				
		},		
		"ending":{		
			"ab":"talagay blaq calay! wal su suqun tqbaq la, maki su muyax ga! lokah tqbaq ru nway su kinga tqbaq!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56002/781668"	
		}		
	},			
