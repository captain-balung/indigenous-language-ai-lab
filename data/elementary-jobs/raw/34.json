{
	"theme":"職業",
	"text":{
		"opening":{
			"ab":"nengi ita, setangi sinanam pa ita tu itaza ay sudad, siangatu pa ita ti!",
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",
			"sound":"text/sound/56577/789572"
		},
		"phase1":{
			"ab":"kunna pa ita mipil tu niliyaman na patudan, qawka ita kemulikuz meliyam.",
			"ch":"先聽老師唸，再跟著老師唸。",
			"sound":"text/sound/56577/789573"
		},
		"phase2":{
			"ab":"ipilan ta sikawman na patudan, sikawma ka.",
			"ch":"聽老師的問題，回答看看。",
			"sound":"text/sound/56577/789575"
		},
		"phase3":{
			"ab":"nengi ti! setangi, kunna imu sikawma ka.",
			"ch":"太棒了! 現在，換你們說說看。",
			"sound":"text/sound/56577/789576"
		},
		"phase4":{
			"ab":"ipilan ta sikawman na patudan. paska sikawma ka.",
			"ch":"仔細聽老師的問題， 試著回答看看。",
			"sound":"text/sound/56577/789577"
		},
		"phase5":{
			"ab":"ipilan ta sikawman na patudan, mayni ya melaqid?",
			"ch":"仔細聽老師的問題，答案是哪一個呢?",
			"sound":"text/sound/56577/789578"
		},
		"phase6":{
			"ab":"satuRin! setangi, paska isu meniz melaqid!",
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",
			"sound":"text/sound/56577/789579"
		},
		"switch":{
			"ab":"nengi ti! umanan ta ni?",
			"ch":"太棒了!要再一次嗎?",
			"sound":"text/sound/56577/789574"
		},
		"ending":{
			"ab":"satuRin isu! mulepun ti sinanam, pitemawaR sinanam ta leppawan! kikiya ma suppeR ti isu!",
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",
			"sound":"text/sound/56577/789580"
		}
	},
