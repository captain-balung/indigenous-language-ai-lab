{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Nga’ay ho kita! Minanam kita to kantanay a sowal anini. Satapang to kita!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55852/779596"	
		},		
		"phase1":{		
			"ab":"Tengilen ho ko pi’osi no singsi, nga tooren a mi’osi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55852/779597"	
		},		
		"phase2":{		
			"ab":"Tengilen ko nilicayan no singsi, tanamen a pacako.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55852/779599"	
		},		
		"phase3":{		
			"ab":"Aciyah, nga’ayay! Hatini i, kamo to a somowal.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55852/779600"	
		},		
		"phase4":{		
			"ab":"Songila’en a mitengil ko milicayan no singsi. Tanamen a pacako.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55852/779601"	
		},		
		"phase5":{		
			"ab":"Songila’en a mitengil ko nilicayan no singsi. Icowaay ko matepi’ay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55852/779602"	
		},		
		"phase6":{		
			"ab":"Idahiyay to! Hatini i, nengnengen ita, o mamatepi’ iso a maemin haw!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55852/779603"	
		},		
		"switch":{		
			"ab":"Aciyah, nga’ayay! Miliyaw ho haw?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/55852/779598"	
				
		},		
		"ending":{		
			"ab":"Kahemekan kiso! Malaheci iso ko nananamen anini. I loma’ i, milingsiw to yo! Nga, kaliki a matonga’ ko fana’ iso yo!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55827/779604"	
		}		
	},			
