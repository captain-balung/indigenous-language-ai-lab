{
	"theme":"職業",
	"text":{
		"opening":{
			"ab":"Initu haw kita! a minanam kita tu caluwayay a suwal, malingatua kita.",
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",
			"sound":"text/sound/55777/778564"
		},
		"phase1":{
			"ab":"Pitengili ku ayaw tu niasip nu pasevana’ay, herek saan duduen ku nipiasip nu pasevana’ay.",
			"ch":"先聽老師唸，再跟著老師唸。",
			"sound":"text/sound/55777/778565"
		},
		"phase2":{
			"ab":"Pitengili tu nipalita nu pasevana’ay, herek saan, pitanengi may a pacauv.",
			"ch":"聽老師的問題，然後回答看看。",
			"sound":"text/sound/55777/778567"
		},
		"phase3":{
			"ab":"Kapah ku nipacauv namu! kaamu tu may ku semuwalay anini.",
			"ch":"你們回答得很好! 現在，換你們說說看。",
			"sound":"text/sound/55777/778568"
		},
		"phase4":{
			"ab":"Sakapahen ku nipitengil tu suwal nu pasevana’ay, pitanengi may a pacauv.",
			"ch":"仔細聽老師的問題， 試著回答看看。",
			"sound":"text/sound/55777/778569"
		},
		"phase5":{
			"ab":"Sakapahen ku nipitengil tu nipalita nu pasevana’ay, icuwaan saw ku marucekay?",
			"ch":"仔細聽老師的問題，對的是哪一個呢?",
			"sound":"text/sound/55777/778570"
		},
		"phase6":{
			"ab":"Kapah ku nipacauv namu! kedamay anini, anu mavana’ay hakiya kamu a pacauv!",
			"ch":"你們回答得很好! 現在試試看，看看你是不是都能答對喔!",
			"sound":"text/sound/55777/778571"
		},
		"switch":{
			"ab":"Mavana’ kamu! a kinacacay aca haw?",
			"ch":"太棒了! 要再一次嗎?",
			"sound":"text/sound/55777/842358"
		},
		"ending":{
			"ab":"Kahemekan kisu! malaheci nu misu ku nipinanam tu nu aniniay a remiad, pinanami tu i luma’ tu remiremiad! kiya kalamkam ku nikacakat nu misu.",
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",
			"sound":"text/sound/55777/778572"
		}
	},
