{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"ipoingaw nyamo, sesane ka kica’oane mikita na mapadodo na baka, tasikyaodronga!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56477/788196"	
		},		
		"phase1":{		
			"ab":"palay la bicingi wasyasipini ki singsi, laso ’angiyao singsi wasyasipi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56477/788197"	
		},		
		"phase2":{		
			"ab":"laa bicingi sa’apobakani ki singsi, ’akobi lwavalava.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56477/788199"	
		},		
		"phase3":{		
			"ab":"maagi’i ! nakayla ka laa mobaithi ’apobaka",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56477/788200"	
		},		
		"phase4":{		
			"ab":"pata’adringa bicingi bakaini ki singsi. ‘akobi lwavalava.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56477/788201"	
		},		
		"phase5":{		
			"ab":"pata’adringa bicingi bakani ki singsi. amani ko tyakadringay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56477/788202"	
		},		
		"phase6":{		
			"ab":"maygili koso sawkoa! nakayla ka tacengele igo’o myaso ’angico’olo!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56477/788203"	
		},		
		"switch":{		
			"ab":"maagi’i! kelala myata?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56477/788198"	
				
		},		
		"ending":{		
			"ab":"takabeabee mosoa! paepenge koso kica’oaniso sesane, ’ikayso da’ane ka pava’iyane kica’oane! laso igo’o pa’i’ithi.",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55802/788204"	
		}		
	},			
