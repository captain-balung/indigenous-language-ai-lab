{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"konomi ka makanaele mwadringadringaiya,kai vaiyana ai kicakwata sa vagata ka madolro,ila ta athagili’a.",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56402/817011"	
		},		
		"phase1":{		
			"ab":"la aswalralra si’ako na kilalra nomi,si toa‘alra nakowa asi’i nomi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56402/787165"	
		},		
		"phase2":{		
			"ab":"kilalra nomi ki vagalri,la tobalre nakowa.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56402/787167"	
		},		
		"phase3":{		
			"ab":"’iya~maligili!kaiyasa,na balithi kawriva nomi.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56402/787168"	
		},		
		"phase4":{		
			"ab":"kilalra kialibake nomi ki vagalri,la alavalava tobalre nakowa.",	
			"ch":"仔細聽老師的問題。 試著回答看看。",	
			"sound":"text/sound/56402/787169"	
		},		
		"phase5":{		
			"ab":"ai kialibake kilalra ki vagalri,manema ka ahoahoa?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56402/787170"	
		},		
		"phase6":{		
			"ab":"’iya maligili!kaiyasa,na ceelrako idra kalrekete so tobalre le’eng ka ahoa!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56402/787171"	
		},		
		"switch":{		
			"ab":"’iya~maligili!ai asi’i nomi angivale?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56402/817012"	
				
		},		
		"ending":{		
			"ab":"mathariri so!twale’enga takesikesi ki vaiyana,dothadalana kicakwa ikaiya daane so!lai anikisilang so mareredare.",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56402/787172"	
		}		
	},			
