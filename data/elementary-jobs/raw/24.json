{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"aiyanga mun a masantalj, tucu a qadav muri kitulu itjen a pasuzuma tua tjamadjulu a kinalan, pay patagilji dri!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56327/786132"	
		},		
		"phase1":{		
			"ab":"langdau a pasusangas tjanuaken nu semupu, sana nu kitjavililj tjanuaken a semupu.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56327/786133"	
		},		
		"phase2":{		
			"ab":"pay langdau tjanuaken tua ku sinikivadaq a pacugan, sanu kipavavala a patevela.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56327/786135"	
		},		
		"phase3":{		
			"ab":"ui padriangata! tucu, timunay anga pavavala a qivu.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56327/786136"	
		},		
		"phase4":{		
			"ab":"pay kisalangdau tua ku sinikivadaq a pacugan, sanu kipavavala a patevela.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56327/786137"	
		},		
		"phase5":{		
			"ab":"pay kisalangdau tua ku sinikivadaq a pacugan, tu ainu a mana napadria tua patevela?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56327/786138"	
		},		
		"phase6":{		
			"ab":"makayangata sun! tucu, pay paqayamay sun tuki su kakayain a patevela saka napadria penuljat dri!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56327/786139"	
		},		
		"switch":{		
			"ab":"ui padriangata! siumalj anan a puitanga?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56327/786134"	
				
		},		
		"ending":{		
			"ab":"maleva itjen tjanusun! tua su qinacuvungan tua kipatulu a vuaq, kicaquanu nu i tjumaq sun uta a piqadav dri! mana djaljav a su sikaljemtuan dri!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56327/786140"	
		}		
	},			
