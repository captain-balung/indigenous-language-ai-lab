{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"djavadjavay a mapuljat, nusauny uli kitulu itjen tua kantantan a vecik, idu patagilji!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56302/785788"	
		},		
		"phase1":{		
			"ab":"kilandavaunan ti sinsi a kisupu, sa kiciuli a kisupu tjai sinsi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56302/785789"	
		},		
		"phase2":{		
			"ab":"kilandaw ta na sinsi a mungday, sa paqayam a temevela.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56302/785791"	
		},		
		"phase3":{		
			"ab":"nanguwaq angata! tucu, pavalit tu timun a paqayam. a lukai.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56302/785792"	
		},		
		"phase4":{		
			"ab":"kigaljui a kilangeda tua munday na sinsi. sa paqayam a temevela.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56302/785793"	
		},		
		"phase5":{		
			"ab":"kagaljui a kilangeda tua na sinsi a mungday, ainu a sipatevela?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56302/785794"	
		},		
		"phase6":{		
			"ab":"saigu angata! tucu, pacunay kimaqati sun a temevela ta penuljat!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56302/785795"	
		},		
		"switch":{		
			"ab":"bulay angata! uli mumalj anan?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56302/785790"	
				
		},		
		"ending":{		
			"ab":"lemeva angata sun! kasauny maqacuvung anga kitulu, i tjumaq nu ljemita ta qadaw uri kitulu tauta! lja djaljaw sun a patjamanguanguaq!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56302/785796"	
		}		
	},			
