{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"lokah ta kwara, tkba ta cikah ke Tayal kisa, t’aring ta la!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56027/782004"	
		},		
		"phase1":{		
			"ab":"t’aring ga pungi psba biru lmpuw, suruw lga gluw psba biru lmpuw.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56027/782005"	
		},		
		"phase2":{		
			"ab":"pungi knayan na psba biru, tlami cmyuk kmayan.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56027/782007"	
		},		
		"phase3":{		
			"ab":"myasa calay! micu ga, cimu kayan cikah la.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56027/782008"	
		},		
		"phase4":{		
			"ab":"ble mung knayan na psba biru. tlami cmyuk kmayan.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56027/782009"	
		},		
		"phase5":{		
			"ab":"ble mung knayan na psba biru, henu ga calay ci cnyuk nya?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56027/782010"	
		},		
		"phase6":{		
			"ab":"lokah su calay wah! micu ga, texay ta mosa su ba’un cmyuk kwara!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56027/782011"	
		},		
		"switch":{		
			"ab":"myasa calay! tlaman su lmpuw loyi?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/56027/782006"	
				
		},		
		"ending":{		
			"ab":"talagay kba su calay! waya su tmasu tkba soni, utux utux ryax maki su sali ga tkba kryax ki! maha su kya ga mosa su helaw calay kba wah!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56027/782012"	
		}		
	},			
