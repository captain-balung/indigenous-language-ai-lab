{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"yokeoasu, teto aʉsvʉsvʉtʉ bua cou maitan’e tetocu ahoi!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56602/789916"	
		},		
		"phase1":{		
			"ab":"ahoi tmalʉn’a ho tesi engha ta lema’cohio, tamucu tmu’ofeihni ho maezo mo’engho.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56602/789917"	
		},		
		"phase2":{		
			"ab":"talʉin’a ’e isi eʉsvʉta ta lema’cohio, takocu aʉsvʉtʉ yut’ingi.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56602/789919"	
		},		
		"phase3":{		
			"ab":"na’no ʉmnʉ! temu auski aothomʉ aʉsvʉtʉ mo’engho",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56602/789920"	
		},		
		"phase4":{		
			"ab":"tee tmaayaezoyʉn’a ta isi engha ta lema’cohio, tac’u aothomʉ yut’ingi.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56602/789921"	
		},		
		"phase5":{		
			"ab":"talʉin’a ’e isi engha ta lema’cohio, zou nenusi namo emio (emzo)?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56602/789922"	
		},		
		"phase6":{		
			"ab":"na’no meemealʉ! tee aitin’a miko nana acʉhʉ emio (emzo)!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56602/789923"	
		},		
		"switch":{		
			"ab":"a’ʉmtʉ na’no ʉmnʉ, tee meelʉ i’vaho?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56602/789918"	
				
		},		
		"ending":{		
			"ab":"’’uaa sokokaekaebʉneni! tekola asngʉcʉ aʉsvʉtʉ ho takocu maine’e teno o’te ta’payo’a.",	
			"ch":"哇替你開心! 回家後要常常練習才不會忘記。",	
			"sound":"text/sound/56602/789924"	
		}		
	},			
