{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Nga’ay ho, minanam to rahodayay a lamit no sowal anini, satapang to kita.",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55877/779940"	
		},		
		"phase1":{		
			"ab":"’Osien ho no singsi, nga’ doedoen ko pi’osi no singsi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55877/779941"	
		},		
		"phase2":{		
			"ab":"O licay no singsi tengilen ho, tanamen a paca’of.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55877/779943"	
		},		
		"phase3":{		
			"ab":"Idahiay to! dadada kamoto ko mitanam a somowal no hatini.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55877/779944"	
		},		
		"phase4":{		
			"ab":"Solinga’en mitengil ko salicay no singsi. tanamen a paca’of.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55877/779945"	
		},		
		"phase5":{		
			"ab":"Solinga’en mitengl ko salicay no singsi, icowaay ko matepi’ay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55877/779946"	
		},		
		"phase6":{		
			"ab":"Idahiay to! nengnengen no hatini matepi’ay han!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55877/779947"	
		},		
		"switch":{		
			"ab":"Idahiay to! liyawen ho a kinacecay?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/55877/779942"	
				
		},		
		"ending":{		
			"ab":"Ilo kiso! malaheci to ko pinanam no hatini, laloken i loma’ pinanam to romi’ami’ad! nga’ kaliki mafana’ kiso!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55877/779948"	
		}		
	},			
