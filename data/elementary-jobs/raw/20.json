{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Miqumisang! Nakitngaa’in ata haip mapasnava mahaipi isbabazbaz tu qalinga!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56227/784756"	
		},		
		"phase1":{		
			"ab":"Ngausang tan’a masnanava masipul, a tudipin makilansan masnanava masipul.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56227/784757"	
		},		
		"phase2":{		
			"ab":"Haiza na’ispasingav mu’u, tanama amu antalam.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56227/784759"	
		},		
		"phase3":{		
			"ab":"Masihal daingaz! Muu’in laupakadau masipul.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56227/784760"	
		},		
		"phase4":{		
			"ab":"Itmantuka tan’a ki masnanava tu ispasingav ihaan mu’uan, a tanama antalam.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56227/784761"	
		},		
		"phase5":{		
			"ab":"Itmantuka tan’a ki masnanava tu ispasingav ihaan mu’uan, simaq a mamantuk tu sin’antalam?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56227/784762"	
		},		
		"phase6":{		
			"ab":"Tuza aas tu kapanu’un! Laupakadau ka na saduan tu duuq i taimisqang amin a sin’antalam suu un!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56227/784763"	
		},		
		"switch":{		
			"ab":"Masmuav tu masihal daingaz sinipul suu. Duuq i muqna’ang masipul?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56227/784758"	
				
		},		
		"ending":{		
			"ab":"Masihal suu haip a sinpasnava, maaq i ilumaq a, malmananua linsiu! natudipin aas mahaipi min’qansiap!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56227/784764"	
		}		
	},			
