{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"akokey kamo, sicyarow ya am, ta macinanao do ciriciring ta, papowen ta rana an!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56777/792324"	
		},		
		"phase1":{		
			"ab":"manma o kamizing so sinsi a meyvilang a kavahangso mo sia.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56777/792325"	
		},		
		"phase2":{		
			"ab":"amizngen o na ipacici no sinsi a kapatovis mo pala sia.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56777/792327"	
		},		
		"phase3":{		
			"ab":"apiya! inyo rana o macipalit a amvahangso so ciring siciaikwa ya.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56777/792328"	
		},		
		"phase4":{		
			"ab":"pakamizngen o na ipacici no sinsi a kapatovis mo pala sia.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56777/792329"	
		},		
		"phase5":{		
			"ab":"pakamizngen o na ipacici no sinsi, ikongo ya manoyong do dang?",
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56777/792330"	
		},		
		"phase6":{		
			"ab":"teymateneng! cita pala siciaikwa ya, ala mo na mamiming a ya katenngan!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56777/792331"	
		},		
		"switch":{		
			"ab":"apiya! vahangso pa a?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56777/792342"	
				
		},		
		"ending":{		
			"ab":"kokey! ya na komavos o mo pacinanawan siciarow ya,mangdey ka do ararow a amvahavahangso sia, kateneng mo an!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56777/792332"	
		}		
	},			
