{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"’inavayan mapiya! harem kana wari naanadam kana madulu nanta kangaiyan, alra zi putehaya ta lra!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56702/791292"	
		},		
		"phase1":{		
			"ab":"inganguwayana ta kinger kana sinsi na maiyup zi kurelranga ta lra kana sinsi miyup.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56702/791293"	
		},		
		"phase2":{		
			"ab":"kingeri nantu kiniaumalr na sinsi zi patalrami temuvang.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56702/791295"	
		},		
		"phase3":{		
			"ab":"salaw ’inava! harem inemuwaya lra patalrami marengay.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56702/791296"	
		},		
		"phase4":{		
			"ab":"tarakingeri nantu kiniyaumalr na sinsi zi patalrami temuvang.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56702/791297"	
		},		
		"phase5":{		
			"ab":"tarakingeri nantu kiniyaumalr na sinsi, nanmu taatuvang maw na iyan?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56702/791298"	
		},		
		"phase6":{		
			"ab":"wa kana sayhu! harem na’uwi nanu itatuvang mu aruwa penauwa peniya!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56702/791299"	
		},		
		"switch":{		
			"ab":"salaw ’inava! zi aasalr ta ziya?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/56702/791294"	
				
		},		
		"ending":{		
			"ab":"kasemangalan maruwa u kemipiya harem kana wari nanta ninadaman, kana wariwari ziya kazu ta i ruma’ menadanadam ta yi! zi aruwa u marekamazalram!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56702/791300"	
		}		
	},			
