{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"lokah simu kwara, musa ta tqbaq cikah ke ta Tayal, t’aring ta la!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55902/780284"	
		},		
		"phase1":{		
			"ab":"pongi ke sinsi ha ru, pslungi kmayal cikah.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55902/780285"	
		},		
		"phase2":{		
			"ab":"bleqi mung pqusan na sinsi ru tlami smyuk.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55902/780287"	
		},		
		"phase3":{		
			"ab":"yasa balay! misu qani lga, musa simu tmalam kmal la ay.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55902/780288"	
		},		
		"phase4":{		
			"ab":"bleqi mung pqusan na sinsi ru tlami smyuk cikah.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55902/780289"	
		},		
		"phase5":{		
			"ab":"bleqi mung pqusan na sinsi, qenu qu balay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55902/780290"	
		},		
		"phase6":{		
			"ab":"uka balay qbaqan ay! misu qani, ktay ta kya su baqun qu kwara cinqbaqan su!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55902/780291"	
		},		
		"switch":{		
			"ab":"yasa balay! mequtux lozi ga?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/55902/780286"	
				
		},		
		"ending":{		
			"ab":"blaq balay! wal su suqun tqbaq qu tqbaqun su soni la tqbaqi nanak ngasal krryax ki! nway su misu baq!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55902/780292"	
		}		
	},			
