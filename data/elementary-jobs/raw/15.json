{
	"theme":"職業",
	"text":{
		"opening":{
			"ab":"Malu namu kana hu! Muda smluhay tikuh mslxan kari ka saya, prading ta da!",
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",
			"sound":"text/sound/56102/783036"
		},
		"phase1":{
			"ab":"Knama mbahang snpuwan mptusa ha, snoli snpu ka mptusa dungan.",
			"ch":"先聽老師唸，再跟著老師唸。",
			"sound":"text/sound/56102/783037"
		},
		"phase2":{
			"ab":"Qbahang snlingan mptusa, cyuki rmngaw binaw!",
			"ch":"聽老師的問題，回答看看。",
			"sound":"text/sound/56102/783039"
		},
		"phase3":{
			"ab":"Laway bay knmalu kiya da! Saya hay, priyux yamu ka rmngaw han.",
			"ch":"太棒了! 現在，換你們說說看。",
			"sound":"text/sound/56102/783040"
		},
		"phase4":{
			"ab":"Stratuc bay mbahang ka snlingan mptusa, tlamay cmiyuk binaw!",
			"ch":"仔細聽老師的問題， 試著回答看看。",
			"sound":"text/sound/56102/783041"
		},
		"phase5":{
			"ab":"Stratuc bay mbahang ka snlingan mptusa, weynu ka balay bay mndungus hu?",
			"ch":"仔細聽老師的問題，答案是哪一個呢?",
			"sound":"text/sound/56102/783042"
		},
		"phase6":{
			"ab":"Taway bay mbiyax kiya da hay! Saya pa, tayi ta ya su dhqun mndungus bay cmiyuk kana hu!",
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",
			"sound":"text/sound/56102/783043"
		},
		"switch":{
			"ab":"Laway bay knmalu kiya da! Mntxal dungan hu?",
			"ch":"太棒了! 要再一次嗎?",
			"sound":"text/sound/56102/783038"
		},
		"ending":{
			"ab":"Sqrasun misu balay! Wada qhduwan ka snhlayan saya da, mniq sapah u shlai kddiyax uri wa! Kiya mtduwa su ini biyaw mkala knkla wah!",
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",
			"sound":"text/sound/56102/783044"
		}
	},
