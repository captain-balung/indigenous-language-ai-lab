{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"sabau makanaelre, kaiasaa aikibilruta ku tapadudulru ka pacase, tapathagilinga!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56452/787852"	
		},		
		"phase1":{		
			"ab":"paswalana kilalra ki singsi lusilrigu, latupapalranga silrigu.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56452/787853"	
		},		
		"phase2":{		
			"ab":"kilalra ki singsi ku takitubulruwa, lapalalava tubalre.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56452/787855"	
		},		
		"phase3":{		
			"ab":"mathahihi! kaiasaa aiamaninganumi ka kauhiva.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56452/787856"	
		},		
		"phase4":{		
			"ab":"pudriadringadha kilalra ku takitubulruwa ki singsi. lapalalava tubalre.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56452/787857"	
		},		
		"phase5":{		
			"ab":"pudriadringadha kilalra ku takitubulruwa ki singsi, saininu ku sapatubalrea?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56452/787858"	
		},		
		"phase6":{		
			"ab":"malrigili tuhamuhu! kaiasaa, laceela luaipacengecengesu demedeme!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56452/787859"	
		},		
		"switch":{		
			"ab":"malrigilinumi! aipelananumi?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56452/787854"	
				
		},		
		"ending":{		
			"ab":"matiyakihagaisu! pailrepengesu ikai takibulruwa kaiasaa, kivayvai kyacawcawcakuwanemadu ikai tauwana! aiasidisu!!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56452/787860"	
		}		
	},			
