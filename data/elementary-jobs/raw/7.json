{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"lawkah simu kwara, pakabaga ta su babiru na Tayan riyax sawni, ta’aring ta la ki!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55927/780628"	
		},		
		"phase1":{		
			"ab":"pungi kay ni pasaba biru han, ru pagaluw lamapuw ki pasaba biru la.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55927/780629"	
		},		
		"phase2":{		
			"ab":"pungi pin’usan ni pasaba biru, ru kayan tikay.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55927/780631"	
		},		
		"phase3":{		
			"ab":"tiyakin ba! misu hani la ga, kayan tikay simu la.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55927/780632"	
		},		
		"phase4":{		
			"ab":"inblay mung pin’usan ni pasaba biru. ru talami kamayan tikay.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55927/780633"	
		},		
		"phase5":{		
			"ab":"inblay mung pin’usan ni pasaba biru, yakaynu ku payang balay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55927/780634"	
		},		
		"phase6":{		
			"ab":"ba simu balay! misu hani la ga, taxay ta musa su ba kwara la!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55927/780635"	
		},		
		"switch":{		
			"ab":"tiyakin ba! lapuw lawziy aw?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/55927/780630"	
				
		},		
		"ending":{		
			"ab":"sapa’asaw misu! wayan su su’un la ku kinbaga su riyax sawni, asiki pakabaga su sali krariyax uzi yu! naki su yanga ba yu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55927/780636"	
		}		
	},			
