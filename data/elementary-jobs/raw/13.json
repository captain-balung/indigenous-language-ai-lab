		"opening":{		
			"ab":"’ita’ saboeh kayzaeh, kaysa’an taloehloehay sowiti’ ka kapanpanabih!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56052/782348"	
		},		
		"phase1":{		
			"ab":"bazbazae’ naehan noka kamatortoroe’ ka pinanabih, ’isa:a’ tani kamatortoroe’ mayaka:i’.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56052/782349"	
		},		
		"phase2":{		
			"ab":"bazae’ noka kamatortoroe’ ka ka:i’ ’isa:a’ tiSkobae:oh.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56052/782351"	
		},		
		"phase3":{		
			"ab":"kayzaeh o! ’isahini moyo ila panabih naehan.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56052/782352"	
		},		
		"phase4":{		
			"ab":"bazae’ noka kamatortoroe’ ka ka:i’. tatalam tiSkobae:oh naehan.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56052/782353"	
		},		
		"phase5":{		
			"ab":"bazae’ noka kamatortoroe’ ka ka:i’, hayno’ ’aehae’ ’ima maylal’oz?",
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56052/782354"	
		},		
		"phase6":{		
			"ab":"tabin o! ’isahini takita’ So’o ra:am ay saboeh ka ka:i’?",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56052/782355"	
		},		
		"switch":{		
			"ab":"tabin o! ’am mayaka:i’ naehan ay?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56052/782350"	
				
		},		
		"ending":{		
			"ab":"So’o tabin o! sizaeh ila kaysa’an katatoroe’an, ray taew’an ma’ ’am lomoehloehay naehan o! nakhini kayzaeh Sae’te: ka kinra:aman!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56052/782356"	
		}		
	},			
