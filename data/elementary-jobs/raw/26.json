{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"nanguanguaq mun a mapuljat, tucu a qadaw uri kitulu tjen ta madjulu a vecik, patagilji anga numaya!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56377/786820"	
		},		
		"phase1":{		
			"ab":"kilangdai ti sinsi nu semupu, sa kiseljang a semupu.",
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56377/786821"	
		},		
		"phase2":{		
			"ab":"kilangdai anan a sini kivadaq nisinsi, sa kilingavi a kitevela.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56377/786823"	
		},		
		"phase3":{		
			"ab":"bulai angata! tucu, timun anga ikai.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56377/786824"	
		},		
		"phase4":{		
			"ab":"kilangdau ta sini kivadaq ni sinsi, sa kilingavi a kitevela.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56377/786825"	
		},		
		"phase5":{		
			"ab":"kilangdau ta sini kivadaq ni sinsi, ainu a paquliqulid?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56377/786826"	
		},		
		"phase6":{		
			"ab":"saigu aravac! tucu, pacunu kipaquliqulid a su sini kitevela yu!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56377/786827"	
		},		
		"switch":{		
			"ab":"bulai angata! uri mumaljanan?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56377/786822"	
				
		},		
		"ending":{		
			"ab":"pinakalevan tja nu sun! na qemacuvung sun ta kitulu tucu a qadaw, nu itjumaq kitulu uta yu! nu maitucu avan a su sika saiguan a kirimu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56377/786828"	
		}		
	},			
