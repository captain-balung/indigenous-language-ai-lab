{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"pashtay piakalinkin, aminfazaq iamin thuini antu mabaraz a lalawa, araiza ita!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56077/782692"	
		},		
		"phase1":{		
			"ab":"ihalawan maniun tunmaza fuifuilh patashan a shinshii malhinuna, numa untal maniun fuifuilh patashan a shinshii malhinuna.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56077/782693"	
		},		
		"phase2":{		
			"ab":"tmazawan maniun fuifuilh patashan a shinshii a lalawa ya kmuza, numa shtaamuan maniun iakin.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56077/782695"	
		},		
		"phase3":{		
			"ab":"mathuaw maqitan! numa thuini, maniunuan malhinuna.",
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56077/782696"	
		},		
		"phase4":{		
			"ab":"irarauriuq tunmaza fuifuilh patashan a shinshii a lalawa ya kmuza. numa shtaamuan maniun iakin.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56077/782697"	
		},		
		"phase5":{		
			"ab":"irarauriuq tunmaza fuifuilh patashan a shinshii a lalawa ya kmuza, numa qazii ya dadu a lalawa qa?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56077/782698"	
		},		
		"phase6":{		
			"ab":"mathuaw ma’ania! thuini, qazii ya mulhthkiz mulunduz qa!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56077/782699"	
		},		
		"switch":{		
			"ab":"mathuaw maqitan! amuqthawan malhinuna qa?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56077/782694"	
				
		},		
		"ending":{		
			"ab":"mathuaw iaku maqaran! mukaktuniza thuini minfazaq tu Thau a lalawa, iaqay maniun itaun minfazaq tu thau a lalawa! amaqa muhiaw mafazaq!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56077/782700"	
		}		
	},			
