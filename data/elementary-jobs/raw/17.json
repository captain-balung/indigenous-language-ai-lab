{
	"theme":"職業",
	"text":{
		"opening":{
			"ab":"Embiyax nami kana hug! Psluhay ta cikuh leexan kari ka jiyax sayang, prajing ta da hug!",
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",
			"sound":"text/sound/56152/783724"
		},
		"phase1":{
			"ab":"Qbhangi smpug ka emptgsa han! Bukuy do sneegul emptgsa smpug.",
			"ch":"先聽老師唸，再跟著老師唸。",
			"sound":"text/sound/56152/783725"
		},
		"phase2":{
			"ab":"Qbhangi ka sniling emptgsa, tlamay smiyuk binaw.",
			"ch":"聽老師的問題，回答看看。",
			"sound":"text/sound/56152/783727"
		},
		"phase3":{
			"ab":"Tagay bi knmalu! Sayang do yamu ka rmngaw da hug?",
			"ch":"太棒了! 現在，換你們說說看。",
			"sound":"text/sound/56152/783728"
		},
		"phase4":{
			"ab":"Kmalu qmbahang sniling emptgsa, tlamay smiyuk binaw.",
			"ch":"仔細聽老師的問題， 試著回答看看。",
			"sound":"text/sound/56152/783729"
		},
		"phase5":{
			"ab":"Kmalu qmbahang sniling emptgsa, qtai tgeinu ka balay bi hug?",
			"ch":"仔細聽老師的問題，答案是哪一個呢?",
			"sound":"text/sound/56152/783730"
		},
		"phase6":{
			"ab":"Ma su mkla balay! Sayang, qtaay ta ka sniyuk su, ya mdungus kana!",
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",
			"sound":"text/sound/56152/783731"
		},
		"switch":{
			"ab":"Malu balay wah! Txal duri hug?",
			"ch":"太棒了! 要再一次嗎?",
			"sound":"text/sound/56152/783726"
		},
		"ending":{
			"ab":"Sqaras misu balay! Mnhdu su smluhay jiyax sayang da, mniq su sapah o sluhay kdjiyax uri wah! Kika musa mkala ka knklaan su!",
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",
			"sound":"text/sound/56152/783732"
		}
	},
