{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"mahicatu, minanam kita ayza tu pantaay a kamu, miteka tu kita i!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56802/792668"	
		},		
		"phase1":{		
			"ab":"tengilen henay ku piasip nu saydan, ta kilulen ku saydan miasip.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56802/792669"	
		},		
		"phase2":{		
			"ab":"tengilen ku kamu nu saydan, tanamen patubeli.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56802/792671"	
		},		
		"phase3":{		
			"ab":"tadamatineng! ayza, kamu tu ku musakamuway.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56802/792672"	
		},		
		"phase4":{		
			"ab":"palitaen mitengil ku kamu nu saydan. tanamen patubeli may.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56802/792673"	
		},		
		"phase5":{		
			"ab":"palitaen mitengil ku kamu nu saydan. icuwaay ku malucekay saw?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56802/792674"	
		},		
		"phase6":{		
			"ab":"tadamatineng! ayza, azihen malucek amin isu ku pipatubeli!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56802/792675"	
		},		
		"switch":{		
			"ab":"tadamatineng! muliyaw aca haw?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56802/792670"	
				
		},		
		"ending":{		
			"ab":"waynamuh! mapahezek ayza ku pinanam isu, iluma’ sademiaden ku pinanam yu! tya kalamkam ku nikacakat nu tineng isu yu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55802/792676"	
		}		
	},			
