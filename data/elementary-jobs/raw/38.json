{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"inabayan! garem i, ladaladam ta dra kalleayan dra truri. kalla kemiramiya ta!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56677/790948"	
		},		
		"phase1":{		
			"ab":"killengawi driya na sinsi dra maaip. aw kurenang lla kana sinsi maip.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56677/790949"	
		},		
		"phase2":{		
			"ab":"killengawi tu kiyaumallan kana sinsi. aw tubangu driya!",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56677/790951"	
		},		
		"phase3":{		
			"ab":"saigu yu i! garem i, tallam driya marengay muymu.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56677/790952"	
		},		
		"phase4":{		
			"ab":"puraketi killengaw tu kiyaumallan kana sinsi. aw tallami temubang.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56677/790953"	
		},		
		"phase5":{		
			"ab":"puraketi killengaw tu kiyaumallan kana sinsi. amau na isuwa na tatubangan?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56677/790954"	
		},		
		"phase6":{		
			"ab":"saigu yu i! garem i! ta nauway driya! kararuwa yu temubang peniya nay?",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56677/790955"	
		},		
		"switch":{		
			"ab":"wa dra saigu! ta asallaw driya?",	
			"ch":"太棒了!要再一次嗎?",	
			"sound":"text/sound/56677/790950"	
				
		},		
		"ending":{		
			"ab":"kasangalan! musekadr lla nu niladaman garem. an kadru yu i ruma i, karaemetr meladaladam kana wawariwari maw! inaba yu arei saigu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56677/790956"	
		}		
	},			
