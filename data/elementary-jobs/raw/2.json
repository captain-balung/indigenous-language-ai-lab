{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Nga’ayho kita mapolong, anini a romi’ad minanam kita to pangta:ay a codad, a militapang to kita!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55802/778908"	
		},		
		"phase1":{		
			"ab":"I sa’ayaw tengilenho ko pitiri’ no singsi, maherek i do^edoen ko singsi a mitiri’.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55802/778909"	
		},		
		"phase2":{		
			"ab":"Tengilen ko salicay no singsi, ta tanamen ko pipaca^of.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55802/778911"	
		},		
		"phase3":{		
			"ab":"Tadama:an yo! i matini, a kisoto ko somowalay.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55802/778912"	
		},		
		"phase4":{		
			"ab":"Hapinangen a mitengil ko pilicay no singsi, ta tanamen ko pipaca^of.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55802/778913"	
		},		
		"phase5":{		
			"ab":"Hapinangen a mitengil ko pilicay no singsi, icowaay ko matamaay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55802/778914"	
		},		
		"phase6":{		
			"ab":"Tadakahemekan yo! imatini, nengnengen so’elin ko nikatama haw?",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55802/778915"	
		},		
		"switch":{		
			"ab":"Tadama:an yo! liyawen a kinacecay to haw?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/55802/778910"	
				
		},		
		"ending":{		
			"ab":"O kakahemekan kiso! pakaherek a minanam anini, saromi’aden a i loma’ ko pisatanatanam yo! ta karakat ko nika cakat no miso!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55802/778916"	
		}		
	},			
