{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Sndamac namu bale, mpslluhe ta tikuh kari leexan ka ali saya, prading ta da!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56127/783380"	
		},		
		"phase1":{		
			"ab":"Qbahang muuyas mptgesa hayan, bobo na snegul mptgesa muuyas.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56127/783381"	
		},		
		"phase2":{		
			"ab":"Qbahang mptgesa smiling kari, ma qqcmiyuk.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56127/783383"	
		},		
		"phase3":{		
			"ab":"Malu bale wa! Saya, yamu texal rengo ha.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56127/783384"	
		},		
		"phase4":{		
			"ab":"Bleyaq mbahang namu ka kari na mptgesa. Ma qqcmiyuk.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56127/783385"	
		},		
		"phase5":{		
			"ab":"Bleyaq mbahang kari na mptgesa, kenu ka kari mggaluk we?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56127/783386"	
		},		
		"phase6":{		
			"ab":"Mbeyax bale! Saya, qtae ta ye mggaluk ka cniyuk su ho!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56127/783387"	
		},		
		"switch":{		
			"ab":"Malu bale wa! Texal dungal ho?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56127/783382"	
				
		},		
		"ending":{		
			"ab":"Qrasun bale wa! Mhedu snlhayan saya de, slhai meniq su sapah klaali! Maha su uxe beyo mkela denu wa!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56127/783388"	
		}		
	},			
