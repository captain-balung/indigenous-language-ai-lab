{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"’inavayan, harem kana wari nadanadam ta kana apana na pinungadangadan, pungesalra ta harem!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56752/791980"	
		},		
		"phase1":{		
			"ab":"kinger diya kana sinsi miyup, di itulusi lra na sinsi miyup.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56752/791981"	
		},		
		"phase2":{		
			"ab":"kingeri tu kiyaumalren na sinsi, tuvangi diya.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56752/791983"	
		},		
		"phase3":{		
			"ab":"sayhu dadu! harem, vavuras lra kaninmu marengay.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56752/791984"	
		},		
		"phase4":{		
			"ab":"tarekinger tu kiyawumalren na sinsi. talram diya tumuvang.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56752/791985"	
		},		
		"phase5":{		
			"ab":"tarekinger tu kiyawumalren na sinsi. mau na i iyan na penauwa?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56752/791986"	
		},		
		"phase6":{		
			"ab":"pameriyan lra sayhu! harem na’uwi diya karuwa u tumuvang peniya da penauwa mu!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56752/791987"	
		},		
		"switch":{		
			"ab":"penauwa! asalraw diya?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56752/791982"	
				
		},		
		"ending":{		
			"ab":"semangalan! semekad u lra menadanadam kanini na wari, nu kadu u i ruma’ nadanadam diya ay! karuwa u dika sayhu mu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56752/791988"	
		}		
	},			
