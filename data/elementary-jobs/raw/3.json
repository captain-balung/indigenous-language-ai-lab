{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"Nga’ay ho, minanam to lahoday mimin aca a tilid anini romi’ad, misatapang to kita!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55827/779252"	
		},		
		"phase1":{		
			"ab":"I’ayaw ho ko pitengil to pisa’osi no singsi, ta tooren ko pisa’osi no singsi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55827/779253"	
		},		
		"phase2":{		
			"ab":"Tengilen ho ko salicay no singsi, tanamen a paca’of.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55827/779255"	
		},		
		"phase3":{		
			"ab":"Wata kafangcal! Da, tanamen namo a somowal anini.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55827/779256"	
		},		
		"phase4":{		
			"ab":"Hapinangen a mitengil ko salicay no singsi. Tanamen a paca’of.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55827/779257"	
		},		
		"phase5":{		
			"ab":"Hapinangen a mitengil ko salicay no singsi, icowa ko matatodongay?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55827/779258"	
		},		
		"phase6":{		
			"ab":"Wata kacaloway! Da hapinangen a minengneng, maedeng maemin matatodong ko paca’of no miso!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55827/779259"	
		},		
		"switch":{		
			"ab":"Wata kafangcal, miliyaw ho to kinacecay?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/55827/779254"	
				
		},		
		"ending":{		
			"ab":"Kahemekan kiso! mareko to ko pinanam anini romi’ad, kararid to romi’ami’ad i loma’ a minanam! ta kalamkam tala’ayaw ko fana’ no miso!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55827/779260"	
		}		
	},			
