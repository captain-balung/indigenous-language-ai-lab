{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"djavadjavay a masantalj, uri kicaquan itjen tua vecik na paiwan, ari patagilji!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56352/786476"	
		},		
		"phase1":{		
			"ab":"kilangdau anan ta sinsi, sa su kitjavelilj a semupu.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56352/786477"	
		},		
		"phase2":{		
			"ab":"kilangdau anan tua ku sikivadaq, saka sun a temevela.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56352/786479"	
		},		
		"phase3":{		
			"ab":"wa macaqu aravac! tucu, timunnayanga kiljavaran pay.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56352/786480"	
		},		
		"phase4":{		
			"ab":"kisacalingau a kiladenga tua sikivadaq ni sinsi. saka paqayamu a patevela.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56352/786481"	
		},		
		"phase5":{		
			"ab":"kilangdau tua ku sikivadaq, tjainu a paqulid?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56352/786482"	
		},		
		"phase6":{		
			"ab":"ui macaqu! tucu, pay tja pacunay tuki sun a macaqu a penuljat!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56352/786483"	
		},		
		"switch":{		
			"ab":"macaqu sun aravac! umalju anan a semupu a puita pay?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56352/786478"	
				
		},		
		"ending":{		
			"ab":"penakaleva sun! qemacuvung tuca kitulu tucu, kitulu a ljemita ta qadav yu! avan azua ki sun a tjamacaqu!",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56352/786484"	
		}		
	},			
