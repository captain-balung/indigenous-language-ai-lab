{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"lawkah ta’ kahabaag! papkibaq ta’ cu ini’ ka ayhung ka pinateq i kisa’, ca! manaringay ta’!",	
			"ch":"大‌家‌好‌，‌今‌天‌我們要‌學‌習‌一‌些‌簡‌單‌的‌詞‌彙‌，‌來！我‌們‌開‌始‌吧!‌",	
			"sound":"text/sound/55952/780972"	
		},		
		"phase1":{		
			"ab":"pungi han lumpug i papsibaq, ru’ galgi i papsibaq lumpug lawwi.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55952/780973"	
		},		
		"phase2":{		
			"ab":"pungi ku pinaqut ni papsibaq, ciyuk cumama’.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55952/780975"	
		},		
		"phase3":{		
			"ab":"balayq cubalay! ka hani ga, iyug cimu kumaal cumama’.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55952/780976"	
		},		
		"phase4":{		
			"ab":"anabalballayq i kumnapung ku pinaqut ni papsibaq, talam cumiyuk cumama’.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55952/780977"	
		},		
		"phase5":{		
			"ab":"anabalballayq i kumnapung ku pinaqut ni papsibaq, aynu’ ku capaang na caciyuk?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55952/780978"	
		},		
		"phase6":{		
			"ab":"mamati’(lawkah/ baaq) su’ cubalay wala! talami cumama’ ka hani, babaqun si cumiyuk kahabaag qu!",	
			"ch":"你太厲害了! 現在，試試看你是不是都能答對喔!",	
			"sound":"text/sound/55952/780979"	
		},		
		"switch":{		
			"ab":"balayq cubalay! paka qutux lawwi qu?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/55952/780974"	
				
		},		
		"ending":{		
			"ab":"paqasaw ta’ ka anaqarun su’ sawni’ i pakibaqan la, karuux i makibaq kariariax mikiya imuwag yo! naki si ini’ kanga’ ararruwa i baaq yo!.",	
			"ch":"恭喜你! 完成了今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/55952/780980"	
		}		
	},			
