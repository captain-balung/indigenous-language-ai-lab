{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"ramas mamu kora, pasababa’ ta’ ci ke’ na itaṟal kira, ta’aring ta’ la kay!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/55977/781316"	
		},		
		"phase1":{		
			"ab":"pung ci linpagan ni sinsi, lu la’uli’ lunpuw bukuy.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/55977/781317"	
		},		
		"phase2":{		
			"ab":"talamiy cumik ka nel sikaṟal ni sinsi hani.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/55977/781319"	
		},		
		"phase3":{		
			"ab":"ramas caṟung wa! talamiy kumaṟal cimu la.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/55977/781320"	
		},		
		"phase4":{		
			"ab":"bali’iy mung ka ke’ ni sinsi. talamiy cumik kumaṟal.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/55977/781321"	
		},		
		"phase5":{		
			"ab":"bali’iy mung ka ke’ ni sinsi’, inu’ ka mala’ulu’?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/55977/781322"	
		},		
		"phase6":{		
			"ab":"kani wa! talamiy ka hani, hita’ su’ ba’un cumik kora na!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/55977/781323"	
		},		
		"switch":{		
			"ab":"ramas caṟung wa! tutux luṟi aw?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/55977/781318"	
				
		},		
		"ending":{		
			"ab":"kani wa! masu’ ta’ sunbaba’ soni’ la, kinpahṟow sunbaba’ maki mamu moṟow kay! hita’ mamu mamicuw ba’!",	
			"ch":"太好了! 完成今天的學習，每天在家也要練習唷！你才會進步得很快唷！",	
			"sound":"text/sound/55977/781324"	
		}		
	},			
