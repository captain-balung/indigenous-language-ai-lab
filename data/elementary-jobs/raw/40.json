{				
	"theme":"職業",			
	"text":{			
		"opening":{		
			"ab":"’inavayan mapiya, menalrazam ta za pidaya valray za kalre’ayan. halra pureha ta!",	
			"ch":"大家好，今天要學習一些簡單的詞彙，我們開始吧!",	
			"sound":"text/sound/56727/791636"	
		},		
		"phase1":{		
			"ab":"kinger ziya kani sinsi zi iturus lra kani sinsi miyup.",	
			"ch":"先聽老師唸，再跟著老師唸。",	
			"sound":"text/sound/56727/791637"	
		},		
		"phase2":{		
			"ab":"kingeri tu kiyaumalran ni sinsi zi, talrami temuvang.",	
			"ch":"聽老師的問題，回答看看。",	
			"sound":"text/sound/56727/791639"	
		},		
		"phase3":{		
			"ab":"salaw ’inava! talrami merengai i inmu harem.",	
			"ch":"太棒了! 現在，換你們說說看。",	
			"sound":"text/sound/56727/791640"	
		},		
		"phase4":{		
			"ab":"tarakinger tu kiyaumalran ni sinsi zi talrami temuvang.",	
			"ch":"仔細聽老師的問題， 試著回答看看。",	
			"sound":"text/sound/56727/791641"	
		},		
		"phase5":{		
			"ab":"tarakinger tu kiyaumalran ni sinsi, na iyan na tatuvangan?",	
			"ch":"仔細聽老師的問題，答案是哪一個呢?",	
			"sound":"text/sound/56727/791642"	
		},		
		"phase6":{		
			"ab":"salaw sayhu u! talrami harem, karuwa u temuvng peniya!",	
			"ch":"太厲害了! 現在，看看你是不是都能答對喔!",	
			"sound":"text/sound/56727/791643"	
		},		
		"switch":{		
			"ab":"kiya kana sayhu u! talram u ziya parasan?",	
			"ch":"太棒了! 要再一次嗎?",	
			"sound":"text/sound/56727/791638"	
				
		},		
		"ending":{		
			"ab":"semangalan! piya u lra nu tinakesiyan harem. marayas ta menalranalrazam zi kadika ta marakasayhu.",	
			"ch":"恭喜你! 完成今天的學習，每天在家也要練習唷!你才會進步得很快唷!",	
			"sound":"text/sound/56727/791644"	
		}		
	},			
